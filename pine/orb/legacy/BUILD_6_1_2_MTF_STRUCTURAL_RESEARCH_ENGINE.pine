plot(expPulse ? expCp5Outcome : na, "EXP_cp5_outcome", display = display.data_window)

plot(expPulse ? expCp10Valid : na, "EXP_cp10_valid", display = display.data_window)
plot(expPulse ? expCp10Time : na, "EXP_cp10_time", display = display.data_window)
plot(expPulse ? expCp10Ref : na, "EXP_cp10_ref_price", display = display.data_window)
plot(expPulse ? expCp10Sep : na, "EXP_cp10_sep_atr_pct", display = display.data_window)
plot(expPulse ? expCp10MFE : na, "EXP_cp10_fwd_mfe_pct", display = display.data_window)
plot(expPulse ? expCp10MAE : na, "EXP_cp10_fwd_mae_pct", display = display.data_window)
plot(expPulse ? expCp10Outcome : na, "EXP_cp10_outcome", display = display.data_window)

plot(expPulse ? expCp15Valid : na, "EXP_cp15_valid", display = display.data_window)
plot(expPulse ? expCp15Time : na, "EXP_cp15_time", display = display.data_window)
plot(expPulse ? expCp15Ref : na, "EXP_cp15_ref_price", display = display.data_window)
plot(expPulse ? expCp15Sep : na, "EXP_cp15_sep_atr_pct", display = display.data_window)
plot(expPulse ? expCp15MFE : na, "EXP_cp15_fwd_mfe_pct", display = display.data_window)
plot(expPulse ? expCp15MAE : na, "EXP_cp15_fwd_mae_pct", display = display.data_window)
plot(expPulse ? expCp15Outcome : na, "EXP_cp15_outcome", display = display.data_window)

plot(expPulse ? expCp30Valid : na, "EXP_cp30_valid", display = display.data_window)
plot(expPulse ? expCp30Time : na, "EXP_cp30_time", display = display.data_window)
plot(expPulse ? expCp30Ref : na, "EXP_cp30_ref_price", display = display.data_window)
