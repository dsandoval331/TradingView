//@version=6
indicator("Second 1M Forward Trade Health Collector - S1M_FTHC_1.0.3A Core", overlay=true, max_labels_count=500)

string BUILD_ID = "S1M_FTHC_1.0.3A"
string TZ = "America/New_York"

atrType = input.string("Previous 5 Days 1M ATR", "Production ATR Method", options=["Previous Daily ATR","Previous Day 1M ATR","Previous 5 Days 1M ATR","First 2 Candles 1M ATR"], group="ATR")
dailyATRLength = input.int(14, "Daily ATR Length", minval=1, group="ATR")
enableDeltaFilter = input.bool(false, "Enable Production Delta Filter", group="Production Signal")
minimumDelta = input.float(0.0, "Minimum Delta %", minval=0.0, step=1.0, group="Production Signal")
maximumDelta = input.float(100.0, "Maximum Delta %", minval=0.0, step=1.0, group="Production Signal")
showStatusTable = input.bool(true, "Show Status Table", group="Validation")
showEventMarker = input.bool(true, "Show Research Event Marker", group="Validation")

bool native1M = timeframe.in_seconds() == 60
if timeframe.in_seconds() < 60
    runtime.error("S1M_FTHC_1.0.3A supports 1-minute or higher chart timeframes.")
string engineName = native1M ? "Native 1M" : "Lower-TF 1M"
extendedTicker = ticker.new(syminfo.prefix, syminfo.ticker, session.extended)

f_avg5(float a, float b, float c, float d, float e) =>
    float s = 0.0
    int n = 0
    if not na(a)
        s += a
        n += 1
    if not na(b)
        s += b
        n += 1
    if not na(c)
        s += c
        n += 1
    if not na(d)
        s += d
        n += 1
    if not na(e)
        s += e
        n += 1
    n > 0 ? s / n : na

f_dateKey(int t) =>
    year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)

f_extContext() =>
    var int pmDate = na
    var float pmH = na
    var float pmL = na
    var float pmVol = 0.0
    var float pmO = na
    var float pmLast = na
    var int ahDate = na
    var float ahH = na
    var float ahL = na
    var float ahVol = 0.0
    int dk = f_dateKey(time)
    int hh = hour(time, TZ)
    int mm = minute(time, TZ)
    bool isPM = (hh >= 4 and hh < 9) or (hh == 9 and mm < 30)
    bool isAH = hh >= 16 and hh < 20
    if isPM
        if na(pmDate) or pmDate != dk
            pmDate := dk
            pmH := high
            pmL := low
            pmVol := volume
            pmO := open
            pmLast := close
        else
            pmH := math.max(pmH, high)
            pmL := math.min(pmL, low)
            pmVol += volume
            pmLast := close
    if isAH
        if na(ahDate) or ahDate != dk
            ahDate := dk
            ahH := high
            ahL := low
            ahVol := volume
        else
            ahH := math.max(ahH, high)
            ahL := math.min(ahL, low)
            ahVol += volume
    [pmDate, pmH, pmL, pmVol, pmO, pmLast, ahDate, ahH, ahL, ahVol]

[canonicalPMDate,canonicalPMH,canonicalPML,canonicalPMVolume,canonicalPMOpen,canonicalPMLast,canonicalAHDate,canonicalAHHigh,canonicalAHLow,canonicalAHVolume] = request.security(extendedTicker, "1", f_extContext(), lookahead=barmerge.lookahead_off)

f_canonicalATR() =>
    var float sumTR = 0.0
    var int countTR = 0
    var float a1 = na
    var float a2 = na
    var float a3 = na
    var float a4 = na
    var float a5 = na
    var float prev1 = na
    var float prev5 = na
    var int activeDate = na
    int dk = f_dateKey(time)
    int hh = hour(time, TZ)
    int mm = minute(time, TZ)
    bool isRTH = (hh > 9 or (hh == 9 and mm >= 30)) and hh < 16
    bool newSession = isRTH and (na(activeDate) or dk != activeDate)
    if newSession
        if countTR > 0
            float completed = sumTR / countTR
            a5 := a4
            a4 := a3
            a3 := a2
            a2 := a1
            a1 := completed
            prev1 := completed
        prev5 := f_avg5(a1,a2,a3,a4,a5)
        sumTR := 0.0
        countTR := 0
        activeDate := dk
    if isRTH
        sumTR += ta.tr(true)
        countTR += 1
    [prev1, prev5]

[atrPrevDay1M, atrPrev5Day1M] = request.security(extendedTicker, "1", f_canonicalATR(), lookahead=barmerge.lookahead_off)
atrPrevDaily = request.security(syminfo.tickerid, "D", ta.atr(dailyATRLength)[1], lookahead=barmerge.lookahead_on)
// Canonical previous RTH H/L/C from the explicit 1-minute RTH stream.
// This preserves parity with the frozen historical collector instead of
// relying on the exchange daily bar, whose H/L can differ slightly.
f_prevRTHLevels() =>
    var int activeDate = na
    var float curH = na
    var float curL = na
    var float curC = na
    var float prevH = na
    var float prevL = na
    var float prevC = na

    int dk = f_dateKey(time)
    int hh = hour(time, TZ)
    int mm = minute(time, TZ)
    bool isRTH = (hh > 9 or (hh == 9 and mm >= 30)) and hh < 16
    bool newSession = isRTH and (na(activeDate) or dk != activeDate)

    if newSession
        if not na(activeDate)
            prevH := curH
            prevL := curL
            prevC := curC
        activeDate := dk
        curH := high
        curL := low
        curC := close
    else if isRTH
        curH := na(curH) ? high : math.max(curH, high)
        curL := na(curL) ? low : math.min(curL, low)
        curC := close

    [prevH, prevL, prevC]

[prevRTHHigh, prevRTHLow, prevRTHClose] = request.security(
     extendedTicker, "1", f_prevRTHLevels(), lookahead=barmerge.lookahead_off)

[tArr,oArr,hArr,lArr,cArr,vArr,trArr] = request.security_lower_tf(extendedTicker, "1", [time,open,high,low,close,volume,ta.tr(true)])

var int lastProcessed1MTime = na
var int activeRTHDate = na
var float rthPV = 0.0
var float rthVol = 0.0
var float rthVWAP = na
var float c1O = na
var float c1H = na
var float c1L = na
var float c1C = na
var float c1V = na
var float c1TR = na
var float c1VWAP = na
var int c1Date = na
var float c2O = na
var float c2H = na
var float c2L = na
var float c2C = na
var float c2V = na
var float c2TR = na
var float c2VWAP = na
var float c1Hist1 = na
var float c1Hist2 = na
var float c1Hist3 = na
var float c1Hist4 = na
var float c1Hist5 = na
var float c2Hist1 = na
var float c2Hist2 = na
var float c2Hist3 = na
var float c2Hist4 = na
var float c2Hist5 = na
var float c1RelVol = na
var float c2RelVol = na
var float combinedRelVol = na
var bool researchEvent = false
var bool productionSignal = false
var int eventDirection = 0
var int eventDateKey = na
var int eventTimestamp = na
var float referencePrice = na
var float signalPMH = na
var float signalPML = na
var float signalPMOpen = na
var float signalPMLast = na
var float signalPMVol = na
var float signalAHHigh = na
var float signalAHLow = na
var float signalAHVol = na
var float signalPDH = na
var float signalPDL = na
var float signalPrevRTHClose = na
var float first2ATR = na
var float selectedATR = na
var float vwapDistance = na
var float deltaPct = na
var bool tracking = false
var float highestAfter = na
var float lowestAfter = na
var float finalMFE = na
var float finalMAE = na
var float mfe1 = na
var float mae1 = na
var float mfe2 = na
var float mae2 = na
var float mfe3 = na
var float mae3 = na
var float mfe5 = na
var float mae5 = na
var float mfe10 = na
var float mae10 = na
var int min025 = na
var int min050 = na
var int min075 = na
var int min100 = na
var int minAdv050 = na
var int outcome050 = 0
var int outcome100 = 0

int processCount = native1M ? 1 : array.size(tArr)
if processCount > 0
    for i = 0 to processCount - 1
        int t = native1M ? time : array.get(tArr,i)
        float o = native1M ? open : array.get(oArr,i)
        float h = native1M ? high : array.get(hArr,i)
        float l = native1M ? low : array.get(lArr,i)
        float c = native1M ? close : array.get(cArr,i)
        float v = native1M ? volume : array.get(vArr,i)
        float tr = native1M ? ta.tr(true) : array.get(trArr,i)
        bool isNew = na(lastProcessed1MTime) or t > lastProcessed1MTime
        if isNew
            int dk = f_dateKey(t)
            int hh = hour(t,TZ)
            int mm = minute(t,TZ)
            bool isRTH = (hh > 9 or (hh == 9 and mm >= 30)) and hh < 16
            bool isC1 = hh == 9 and mm == 30
            bool isC2 = hh == 9 and mm == 31
            bool newRTH = isRTH and (na(activeRTHDate) or dk != activeRTHDate)
            if newRTH
                // Match the frozen historical collector exactly:
                // capture the just-completed RTH date BEFORE committing the new date,
                // and freeze PM/AH/PD context at session rollover rather than at C2.
                int priorRTHDateKey = activeRTHDate

                if canonicalPMDate == dk
                    signalPMH := canonicalPMH
                    signalPML := canonicalPML
                    signalPMOpen := canonicalPMOpen
                    signalPMLast := canonicalPMLast
                    signalPMVol := canonicalPMVolume
                else
                    signalPMH := na
                    signalPML := na
                    signalPMOpen := na
                    signalPMLast := na
                    signalPMVol := na

                if not na(priorRTHDateKey) and canonicalAHDate == priorRTHDateKey
                    signalAHHigh := canonicalAHHigh
                    signalAHLow := canonicalAHLow
                    signalAHVol := canonicalAHVolume
                else
                    signalAHHigh := na
                    signalAHLow := na
                    signalAHVol := na

                signalPDH := prevRTHHigh
                signalPDL := prevRTHLow
                signalPrevRTHClose := prevRTHClose

                if not na(c1V)
                    c1Hist5 := c1Hist4
                    c1Hist4 := c1Hist3
                    c1Hist3 := c1Hist2
                    c1Hist2 := c1Hist1
                    c1Hist1 := c1V
                if not na(c2V)
                    c2Hist5 := c2Hist4
                    c2Hist4 := c2Hist3
                    c2Hist3 := c2Hist2
                    c2Hist2 := c2Hist1
                    c2Hist1 := c2V
                activeRTHDate := dk
                rthPV := 0.0
                rthVol := 0.0
                rthVWAP := na
                c1O := na
                c1H := na
                c1L := na
                c1C := na
                c1V := na
                c1TR := na
                c1VWAP := na
                c1Date := na
                c2O := na
                c2H := na
                c2L := na
                c2C := na
                c2V := na
                c2TR := na
                c2VWAP := na
                c1RelVol := na
                c2RelVol := na
                combinedRelVol := na
                tracking := false
                researchEvent := false
                productionSignal := false
                eventDirection := 0
                eventDateKey := na
                eventTimestamp := na
                referencePrice := na
                selectedATR := na
                vwapDistance := na
                deltaPct := na
                first2ATR := na
                highestAfter := na
                lowestAfter := na
                finalMFE := na
                finalMAE := na
                mfe1 := na
                mae1 := na
                mfe2 := na
                mae2 := na
                mfe3 := na
                mae3 := na
                mfe5 := na
                mae5 := na
                mfe10 := na
                mae10 := na
                min025 := na
                min050 := na
                min075 := na
                min100 := na
                minAdv050 := na
                outcome050 := 0
                outcome100 := 0
            if isRTH
                float tp = (h+l+c)/3.0
                rthPV += tp * v
                rthVol += v
                rthVWAP := rthVol > 0 ? rthPV / rthVol : na
            if isC1
                c1O := o
                c1H := h
                c1L := l
                c1C := c
                c1V := v
                c1TR := tr
                c1VWAP := rthVWAP
                c1Date := dk
                float avgC1 = f_avg5(c1Hist1,c1Hist2,c1Hist3,c1Hist4,c1Hist5)
                if not na(avgC1) and avgC1 > 0
                    c1RelVol := c1V / avgC1
            if isC2 and c1Date == dk and not na(c1C)
                c2O := o
                c2H := h
                c2L := l
                c2C := c
                c2V := v
                c2TR := tr
                c2VWAP := rthVWAP
                float avgC2 = f_avg5(c2Hist1,c2Hist2,c2Hist3,c2Hist4,c2Hist5)
                if not na(avgC2) and avgC2 > 0
                    c2RelVol := c2V / avgC2
                float comb1 = not na(c1Hist1) and not na(c2Hist1) ? c1Hist1+c2Hist1 : na
                float comb2 = not na(c1Hist2) and not na(c2Hist2) ? c1Hist2+c2Hist2 : na
                float comb3 = not na(c1Hist3) and not na(c2Hist3) ? c1Hist3+c2Hist3 : na
                float comb4 = not na(c1Hist4) and not na(c2Hist4) ? c1Hist4+c2Hist4 : na
                float comb5 = not na(c1Hist5) and not na(c2Hist5) ? c1Hist5+c2Hist5 : na
                float avgComb = f_avg5(comb1,comb2,comb3,comb4,comb5)
                if not na(avgComb) and avgComb > 0
                    combinedRelVol := (c1V+c2V)/avgComb
                bool bull = c1C > c1O and c1C > c1VWAP and c2C > c2O and c2C > c2VWAP and c2L > c2VWAP
                bool bear = c1C < c1O and c1C < c1VWAP and c2C < c2O and c2C < c2VWAP and c2H < c2VWAP
                bool newResearchEvent = bull or bear
                first2ATR := (c1TR+c2TR)/2.0
                if atrType == "Previous Daily ATR"
                    selectedATR := atrPrevDaily
                else if atrType == "Previous Day 1M ATR"
                    selectedATR := atrPrevDay1M
                else if atrType == "Previous 5 Days 1M ATR"
                    selectedATR := atrPrev5Day1M
                else
                    selectedATR := first2ATR
                if newResearchEvent
                    eventDirection := bull ? 1 : -1
                    researchEvent := true
                    eventDateKey := dk
                    eventTimestamp := t
                    referencePrice := c2C
                    vwapDistance := bull ? c2L-c2VWAP : c2VWAP-c2H
                    deltaPct := not na(selectedATR) and selectedATR > 0 ? vwapDistance/selectedATR*100.0 : na
                    bool deltaPass = not enableDeltaFilter or (not na(deltaPct) and deltaPct >= minimumDelta and deltaPct <= maximumDelta)
                    productionSignal := deltaPass
                    tracking := true
                    highestAfter := referencePrice
                    lowestAfter := referencePrice
                    finalMFE := 0.0
                    finalMAE := 0.0
            if tracking and isRTH and dk == eventDateKey and not na(eventTimestamp) and t > eventTimestamp
                int elapsed = int((t-eventTimestamp)/60000)
                highestAfter := math.max(highestAfter,h)
                lowestAfter := math.min(lowestAfter,l)
                float barFav = eventDirection == 1 ? (h-referencePrice)/referencePrice*100.0 : (referencePrice-l)/referencePrice*100.0
                float barAdv = eventDirection == 1 ? (referencePrice-l)/referencePrice*100.0 : (h-referencePrice)/referencePrice*100.0
                float curMFE = eventDirection == 1 ? (highestAfter-referencePrice)/referencePrice*100.0 : (referencePrice-lowestAfter)/referencePrice*100.0
                float curMAE = eventDirection == 1 ? (referencePrice-lowestAfter)/referencePrice*100.0 : (highestAfter-referencePrice)/referencePrice*100.0
                finalMFE := math.max(curMFE,0.0)
                finalMAE := math.max(curMAE,0.0)
                if elapsed == 1 and na(mfe1)
                    mfe1 := finalMFE
                    mae1 := finalMAE
                if elapsed == 2 and na(mfe2)
                    mfe2 := finalMFE
                    mae2 := finalMAE
                if elapsed == 3 and na(mfe3)
                    mfe3 := finalMFE
                    mae3 := finalMAE
                if elapsed == 5 and na(mfe5)
                    mfe5 := finalMFE
                    mae5 := finalMAE
                if elapsed == 10 and na(mfe10)
                    mfe10 := finalMFE
                    mae10 := finalMAE
                if na(min025) and barFav >= 0.25
                    min025 := elapsed
                if na(min050) and barFav >= 0.50
                    min050 := elapsed
                if na(min075) and barFav >= 0.75
                    min075 := elapsed
                if na(min100) and barFav >= 1.00
                    min100 := elapsed
                if na(minAdv050) and barAdv >= 0.50
                    minAdv050 := elapsed
                if outcome050 == 0
                    bool f050 = barFav >= 0.50
                    bool a050 = barAdv >= 0.50
                    if f050 and a050
                        outcome050 := 3
                    else if f050
                        outcome050 := 1
                    else if a050
                        outcome050 := 2
                if outcome100 == 0
                    bool f100 = barFav >= 1.00
                    bool a050b = barAdv >= 0.50
                    if f100 and a050b
                        outcome100 := 3
                    else if f100
                        outcome100 := 1
                    else if a050b
                        outcome100 := 2
            lastProcessed1MTime := t

bool eventOnChartBar = not na(eventTimestamp) and (native1M ? time == eventTimestamp : eventTimestamp >= time and eventTimestamp < time_close)
plotshape(showEventMarker and eventOnChartBar and eventDirection == 1, title="Bullish Research Event", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.tiny, text="F")
plotshape(showEventMarker and eventOnChartBar and eventDirection == -1, title="Bearish Research Event", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, text="F")

// CSV / DATA WINDOW EXPORT — 60 SERIES
plot(eventDateKey, "FTHC_EventDateKey", display=display.data_window)
plot(eventTimestamp, "FTHC_EventTimestamp", display=display.data_window)
plot(eventDirection, "FTHC_Direction", display=display.data_window)
plot(researchEvent ? 1 : 0, "FTHC_ResearchEvent", display=display.data_window)
plot(productionSignal ? 1 : 0, "FTHC_ProductionSignal", display=display.data_window)
plot(referencePrice, "FTHC_ReferencePrice", display=display.data_window)
plot(c1O, "FTHC_C1_Open", display=display.data_window)
plot(c1H, "FTHC_C1_High", display=display.data_window)
plot(c1L, "FTHC_C1_Low", display=display.data_window)
plot(c1C, "FTHC_C1_Close", display=display.data_window)
plot(c1V, "FTHC_C1_Volume", display=display.data_window)
plot(c1TR, "FTHC_C1_TR", display=display.data_window)
plot(c1VWAP, "FTHC_C1_VWAP", display=display.data_window)
plot(c2O, "FTHC_C2_Open", display=display.data_window)
plot(c2H, "FTHC_C2_High", display=display.data_window)
plot(c2L, "FTHC_C2_Low", display=display.data_window)
plot(c2C, "FTHC_C2_Close", display=display.data_window)
plot(c2V, "FTHC_C2_Volume", display=display.data_window)
plot(c2TR, "FTHC_C2_TR", display=display.data_window)
plot(c2VWAP, "FTHC_C2_VWAP", display=display.data_window)
plot(c1RelVol, "FTHC_C1_RelVol", display=display.data_window)
plot(c2RelVol, "FTHC_C2_RelVol", display=display.data_window)
plot(combinedRelVol, "FTHC_Combined_RelVol", display=display.data_window)
plot(selectedATR, "FTHC_ATR_Selected", display=display.data_window)
plot(atrPrevDaily, "FTHC_ATR_PrevDaily", display=display.data_window)
plot(atrPrevDay1M, "FTHC_ATR_PrevDay1M", display=display.data_window)
plot(atrPrev5Day1M, "FTHC_ATR_Prev5Day1M", display=display.data_window)
plot(first2ATR, "FTHC_ATR_First2", display=display.data_window)
plot(vwapDistance, "FTHC_VWAP_Distance", display=display.data_window)
plot(deltaPct, "FTHC_DeltaPct", display=display.data_window)
plot(signalPMH, "FTHC_PMH", display=display.data_window)
plot(signalPML, "FTHC_PML", display=display.data_window)
plot(signalPMOpen, "FTHC_PM_Open", display=display.data_window)
plot(signalPMLast, "FTHC_PM_Last", display=display.data_window)
plot(signalPMVol, "FTHC_PM_Volume", display=display.data_window)
plot(signalAHHigh, "FTHC_AH_High", display=display.data_window)
plot(signalAHLow, "FTHC_AH_Low", display=display.data_window)
plot(signalAHVol, "FTHC_AH_Volume", display=display.data_window)
plot(signalPDH, "FTHC_PDH", display=display.data_window)
plot(signalPDL, "FTHC_PDL", display=display.data_window)
plot(signalPrevRTHClose, "FTHC_PrevRTHClose", display=display.data_window)
plot(outcome050, "FTHC_Outcome_050v050", display=display.data_window)
plot(outcome100, "FTHC_Outcome_100v050", display=display.data_window)
plot(min025, "FTHC_MinutesTo_025", display=display.data_window)
plot(min050, "FTHC_MinutesTo_050", display=display.data_window)
plot(min075, "FTHC_MinutesTo_075", display=display.data_window)
plot(min100, "FTHC_MinutesTo_100", display=display.data_window)
plot(minAdv050, "FTHC_MinutesTo_Adverse050", display=display.data_window)
plot(finalMFE, "FTHC_Final_MFE", display=display.data_window)
plot(finalMAE, "FTHC_Final_MAE", display=display.data_window)
plot(mfe1, "FTHC_CP1_MFE", display=display.data_window)
plot(mae1, "FTHC_CP1_MAE", display=display.data_window)
plot(mfe2, "FTHC_CP2_MFE", display=display.data_window)
plot(mae2, "FTHC_CP2_MAE", display=display.data_window)
plot(mfe3, "FTHC_CP3_MFE", display=display.data_window)
plot(mae3, "FTHC_CP3_MAE", display=display.data_window)
plot(mfe5, "FTHC_CP5_MFE", display=display.data_window)
plot(mae5, "FTHC_CP5_MAE", display=display.data_window)
plot(mfe10, "FTHC_CP10_MFE", display=display.data_window)
plot(mae10, "FTHC_CP10_MAE", display=display.data_window)

var table status = table.new(position.top_right, 2, 6, frame_color=color.gray, frame_width=1)
if barstate.islast
    table.clear(status,0,0,1,5)
    if showStatusTable
        table.cell(status,0,0,"BUILD")
        table.cell(status,1,0,BUILD_ID)
        table.cell(status,0,1,"Engine")
        table.cell(status,1,1,engineName)
        table.cell(status,0,2,"Research Event")
        table.cell(status,1,2,researchEvent ? "YES" : "NO")
        table.cell(status,0,3,"Production")
        table.cell(status,1,3,productionSignal ? "YES" : "NO")
        table.cell(status,0,4,"Direction")
        table.cell(status,1,4,eventDirection == 1 ? "BULL" : eventDirection == -1 ? "BEAR" : "NONE")
        table.cell(status,0,5,"Purpose")
        table.cell(status,1,5,"Forward path core")
