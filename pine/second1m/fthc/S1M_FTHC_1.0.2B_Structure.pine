//@version=6
indicator("Second 1M Forward Trade Health Collector - S1M_FTHC_1.0.2B Structure", overlay=false)

string BUILD_ID = "S1M_FTHC_1.0.2B"
string TZ = "America/New_York"
showStatusTable = input.bool(true, "Show Status Table", group="Validation")

bool native1M = timeframe.in_seconds() == 60
if timeframe.in_seconds() < 60
    runtime.error("S1M_FTHC_1.0.2B supports 1-minute or higher chart timeframes.")
extendedTicker = ticker.new(syminfo.prefix, syminfo.ticker, session.extended)

f_dateKey(int t) => year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)

f_extLevels() =>
    var int pmDate = na
    var float pmH = na
    var float pmL = na
    var int ahDate = na
    var float ahH = na
    var float ahL = na
    int dk = f_dateKey(time)
    int hh = hour(time,TZ)
    int mm = minute(time,TZ)
    bool isPM = (hh >= 4 and hh < 9) or (hh == 9 and mm < 30)
    bool isAH = hh >= 16 and hh < 20
    if isPM
        if na(pmDate) or pmDate != dk
            pmDate := dk
            pmH := high
            pmL := low
        else
            pmH := math.max(pmH,high)
            pmL := math.min(pmL,low)
    if isAH
        if na(ahDate) or ahDate != dk
            ahDate := dk
            ahH := high
            ahL := low
        else
            ahH := math.max(ahH,high)
            ahL := math.min(ahL,low)
    [pmDate,pmH,pmL,ahDate,ahH,ahL]

[pmDateNow,pmHNow,pmLNow,ahDateNow,ahHNow,ahLNow] = request.security(
     extendedTicker,"1",f_extLevels(),lookahead=barmerge.lookahead_off)
// Canonical previous RTH high/low from the same explicit 1-minute
// RTH stream used by the frozen historical collector.
f_prevRTHLevels() =>
    var int activeDate = na
    var float curH = na
    var float curL = na
    var float prevH = na
    var float prevL = na

    int dk = f_dateKey(time)
    int hh = hour(time,TZ)
    int mm = minute(time,TZ)
    bool isRTH = (hh > 9 or (hh == 9 and mm >= 30)) and hh < 16
    bool newSession = isRTH and (na(activeDate) or dk != activeDate)

    if newSession
        if not na(activeDate)
            prevH := curH
            prevL := curL
        activeDate := dk
        curH := high
        curL := low
    else if isRTH
        curH := na(curH) ? high : math.max(curH,high)
        curL := na(curL) ? low : math.min(curL,low)

    [prevH, prevL]

[pdHNow,pdLNow] = request.security(
     extendedTicker,"1",f_prevRTHLevels(),lookahead=barmerge.lookahead_off)
[tArr,oArr,hArr,lArr,cArr,vArr] = request.security_lower_tf(extendedTicker,"1",[time,open,high,low,close,volume])

f_levelState(int dir, float h, float l, float c, float level) =>
    int s = 0
    if not na(level)
        if dir == 1
            s := l > level and c > level ? 1 : h >= level and l <= level ? 0 : -1
        else if dir == -1
            s := h < level and c < level ? 1 : h >= level and l <= level ? 0 : -1
    s

f_retainedCount(int pmState, int ahState, int pdState) =>
    (pmState == 1 ? 1 : 0) + (ahState == 1 ? 1 : 0) + (pdState == 1 ? 1 : 0)

var int lastProcessed = na
var int activeRTHDate = na
var int priorRTHDate = na
var float pv = 0.0
var float vv = 0.0
var float rvwap = na
var float c1O = na
var float c1C = na
var float c1VWAP = na
var int c1Date = na
var bool researchEvent = false
var int eventDirection = 0
var int eventDateKey = na
var int eventTimestamp = na
var float pmLevel = na
var float ahLevel = na
var float pdLevel = na
var bool pmLost = false
var bool ahLost = false
var bool pdLost = false
var bool pmReclaimed = false
var bool ahReclaimed = false
var bool pdReclaimed = false
var int minLevelsRetained = na

var int cp1PM = na
var int cp1AH = na
var int cp1PD = na
var int cp1Retained = na
var int cp1MinRetained = na
var int cp2PM = na
var int cp2AH = na
var int cp2PD = na
var int cp2Retained = na
var int cp2MinRetained = na
var int cp3PM = na
var int cp3AH = na
var int cp3PD = na
var int cp3Retained = na
var int cp3MinRetained = na
var int cp5PM = na
var int cp5AH = na
var int cp5PD = na
var int cp5Retained = na
var int cp5MinRetained = na
var int cp10PM = na
var int cp10AH = na
var int cp10PD = na
var int cp10Retained = na
var int cp10MinRetained = na

var int cp1PMLost = na
var int cp1PMRecl = na
var int cp1AHLost = na
var int cp1AHRecl = na
var int cp1PDLost = na
var int cp1PDRecl = na
var int cp2PMLost = na
var int cp2PMRecl = na
var int cp2AHLost = na
var int cp2AHRecl = na
var int cp2PDLost = na
var int cp2PDRecl = na
var int cp3PMLost = na
var int cp3PMRecl = na
var int cp3AHLost = na
var int cp3AHRecl = na
var int cp3PDLost = na
var int cp3PDRecl = na
var int cp5PMLost = na
var int cp5PMRecl = na
var int cp5AHLost = na
var int cp5AHRecl = na
var int cp5PDLost = na
var int cp5PDRecl = na
var int cp10PMLost = na
var int cp10PMRecl = na
var int cp10AHLost = na
var int cp10AHRecl = na
var int cp10PDLost = na
var int cp10PDRecl = na

int processCount = native1M ? 1 : array.size(tArr)
if processCount > 0
    for i = 0 to processCount - 1
        int t = native1M ? time : array.get(tArr,i)
        float o = native1M ? open : array.get(oArr,i)
        float h = native1M ? high : array.get(hArr,i)
        float l = native1M ? low : array.get(lArr,i)
        float c = native1M ? close : array.get(cArr,i)
        float v = native1M ? volume : array.get(vArr,i)
        bool isNew = na(lastProcessed) or t > lastProcessed
        if isNew
            int dk = f_dateKey(t)
            int hh = hour(t,TZ)
            int mm = minute(t,TZ)
            bool isRTH = (hh > 9 or (hh == 9 and mm >= 30)) and hh < 16
            bool isC1 = hh == 9 and mm == 30
            bool isC2 = hh == 9 and mm == 31
            bool newRTH = isRTH and (na(activeRTHDate) or dk != activeRTHDate)
            if newRTH
                priorRTHDate := activeRTHDate
                activeRTHDate := dk
                pv := 0.0
                vv := 0.0
                rvwap := na
                c1O := na
                c1C := na
                c1VWAP := na
                c1Date := na
                researchEvent := false
                eventDirection := 0
                eventDateKey := na
                eventTimestamp := na
                pmLevel := na
                ahLevel := na
                pdLevel := na
                pmLost := false
                ahLost := false
                pdLost := false
                pmReclaimed := false
                ahReclaimed := false
                pdReclaimed := false
                minLevelsRetained := na
                cp1PM := na
                cp1AH := na
                cp1PD := na
                cp1Retained := na
                cp1MinRetained := na
                cp2PM := na
                cp2AH := na
                cp2PD := na
                cp2Retained := na
                cp2MinRetained := na
                cp3PM := na
                cp3AH := na
                cp3PD := na
                cp3Retained := na
                cp3MinRetained := na
                cp5PM := na
                cp5AH := na
                cp5PD := na
                cp5Retained := na
                cp5MinRetained := na
                cp10PM := na
                cp10AH := na
                cp10PD := na
                cp10Retained := na
                cp10MinRetained := na
                cp1PMLost := na
                cp1PMRecl := na
                cp1AHLost := na
                cp1AHRecl := na
                cp1PDLost := na
                cp1PDRecl := na
                cp2PMLost := na
                cp2PMRecl := na
                cp2AHLost := na
                cp2AHRecl := na
                cp2PDLost := na
                cp2PDRecl := na
                cp3PMLost := na
                cp3PMRecl := na
                cp3AHLost := na
                cp3AHRecl := na
                cp3PDLost := na
                cp3PDRecl := na
                cp5PMLost := na
                cp5PMRecl := na
                cp5AHLost := na
                cp5AHRecl := na
                cp5PDLost := na
                cp5PDRecl := na
                cp10PMLost := na
                cp10PMRecl := na
                cp10AHLost := na
                cp10AHRecl := na
                cp10PDLost := na
                cp10PDRecl := na
            if isRTH
                float tp = (h+l+c)/3.0
                pv += tp*v
                vv += v
                rvwap := vv > 0 ? pv/vv : na
            if isC1
                c1O := o
                c1C := c
                c1VWAP := rvwap
                c1Date := dk
            if isC2 and c1Date == dk and not na(c1C)
                bool bull = c1C > c1O and c1C > c1VWAP and c > o and c > rvwap and l > rvwap
                bool bear = c1C < c1O and c1C < c1VWAP and c < o and c < rvwap and h < rvwap
                if bull or bear
                    researchEvent := true
                    eventDirection := bull ? 1 : -1
                    eventDateKey := dk
                    eventTimestamp := t
                    if pmDateNow == dk
                        pmLevel := bull ? pmHNow : pmLNow
                    else
                        pmLevel := na

                    if not na(priorRTHDate) and ahDateNow == priorRTHDate
                        ahLevel := bull ? ahHNow : ahLNow
                    else
                        ahLevel := na
                    pdLevel := bull ? pdHNow : pdLNow
                    int sPM0 = f_levelState(eventDirection,h,l,c,pmLevel)
                    int sAH0 = f_levelState(eventDirection,h,l,c,ahLevel)
                    int sPD0 = f_levelState(eventDirection,h,l,c,pdLevel)
                    minLevelsRetained := f_retainedCount(sPM0,sAH0,sPD0)
            if researchEvent and isRTH and dk == eventDateKey and t > eventTimestamp
                int elapsed = int((t-eventTimestamp)/60000)
                int sPM = f_levelState(eventDirection,h,l,c,pmLevel)
                int sAH = f_levelState(eventDirection,h,l,c,ahLevel)
                int sPD = f_levelState(eventDirection,h,l,c,pdLevel)
                int retained = f_retainedCount(sPM,sAH,sPD)
                minLevelsRetained := na(minLevelsRetained) ? retained : math.min(minLevelsRetained,retained)
                if sPM == -1
                    pmLost := true
                if sAH == -1
                    ahLost := true
                if sPD == -1
                    pdLost := true
                if pmLost and sPM == 1
                    pmReclaimed := true
                if ahLost and sAH == 1
                    ahReclaimed := true
                if pdLost and sPD == 1
                    pdReclaimed := true
                if elapsed == 1 and na(cp1Retained)
                    cp1PM := sPM
                    cp1AH := sAH
                    cp1PD := sPD
                    cp1Retained := retained
                    cp1MinRetained := minLevelsRetained
                    cp1PMLost := pmLost ? 1 : 0
                    cp1PMRecl := pmReclaimed ? 1 : 0
                    cp1AHLost := ahLost ? 1 : 0
                    cp1AHRecl := ahReclaimed ? 1 : 0
                    cp1PDLost := pdLost ? 1 : 0
                    cp1PDRecl := pdReclaimed ? 1 : 0
                if elapsed == 2 and na(cp2Retained)
                    cp2PM := sPM
                    cp2AH := sAH
                    cp2PD := sPD
                    cp2Retained := retained
                    cp2MinRetained := minLevelsRetained
                    cp2PMLost := pmLost ? 1 : 0
                    cp2PMRecl := pmReclaimed ? 1 : 0
                    cp2AHLost := ahLost ? 1 : 0
                    cp2AHRecl := ahReclaimed ? 1 : 0
                    cp2PDLost := pdLost ? 1 : 0
                    cp2PDRecl := pdReclaimed ? 1 : 0
                if elapsed == 3 and na(cp3Retained)
                    cp3PM := sPM
                    cp3AH := sAH
                    cp3PD := sPD
                    cp3Retained := retained
                    cp3MinRetained := minLevelsRetained
                    cp3PMLost := pmLost ? 1 : 0
                    cp3PMRecl := pmReclaimed ? 1 : 0
                    cp3AHLost := ahLost ? 1 : 0
                    cp3AHRecl := ahReclaimed ? 1 : 0
                    cp3PDLost := pdLost ? 1 : 0
                    cp3PDRecl := pdReclaimed ? 1 : 0
                if elapsed == 5 and na(cp5Retained)
                    cp5PM := sPM
                    cp5AH := sAH
                    cp5PD := sPD
                    cp5Retained := retained
                    cp5MinRetained := minLevelsRetained
                    cp5PMLost := pmLost ? 1 : 0
                    cp5PMRecl := pmReclaimed ? 1 : 0
                    cp5AHLost := ahLost ? 1 : 0
                    cp5AHRecl := ahReclaimed ? 1 : 0
                    cp5PDLost := pdLost ? 1 : 0
                    cp5PDRecl := pdReclaimed ? 1 : 0
                if elapsed == 10 and na(cp10Retained)
                    cp10PM := sPM
                    cp10AH := sAH
                    cp10PD := sPD
                    cp10Retained := retained
                    cp10MinRetained := minLevelsRetained
                    cp10PMLost := pmLost ? 1 : 0
                    cp10PMRecl := pmReclaimed ? 1 : 0
                    cp10AHLost := ahLost ? 1 : 0
                    cp10AHRecl := ahReclaimed ? 1 : 0
                    cp10PDLost := pdLost ? 1 : 0
                    cp10PDRecl := pdReclaimed ? 1 : 0
            lastProcessed := t

plot(eventDateKey, "FTHS_EventDateKey", display=display.data_window)
plot(eventTimestamp, "FTHS_EventTimestamp", display=display.data_window)
plot(eventDirection, "FTHS_Direction", display=display.data_window)
plot(cp1PM, "FTHS_CP1_PM_State", display=display.data_window)
plot(cp1AH, "FTHS_CP1_AH_State", display=display.data_window)
plot(cp1PD, "FTHS_CP1_PD_State", display=display.data_window)
plot(cp1Retained, "FTHS_CP1_LevelsRetained", display=display.data_window)
plot(cp1MinRetained, "FTHS_CP1_MinLevelsRetained", display=display.data_window)
plot(cp2PM, "FTHS_CP2_PM_State", display=display.data_window)
plot(cp2AH, "FTHS_CP2_AH_State", display=display.data_window)
plot(cp2PD, "FTHS_CP2_PD_State", display=display.data_window)
plot(cp2Retained, "FTHS_CP2_LevelsRetained", display=display.data_window)
plot(cp2MinRetained, "FTHS_CP2_MinLevelsRetained", display=display.data_window)
plot(cp3PM, "FTHS_CP3_PM_State", display=display.data_window)
plot(cp3AH, "FTHS_CP3_AH_State", display=display.data_window)
plot(cp3PD, "FTHS_CP3_PD_State", display=display.data_window)
plot(cp3Retained, "FTHS_CP3_LevelsRetained", display=display.data_window)
plot(cp3MinRetained, "FTHS_CP3_MinLevelsRetained", display=display.data_window)
plot(cp5PM, "FTHS_CP5_PM_State", display=display.data_window)
plot(cp5AH, "FTHS_CP5_AH_State", display=display.data_window)
plot(cp5PD, "FTHS_CP5_PD_State", display=display.data_window)
plot(cp5Retained, "FTHS_CP5_LevelsRetained", display=display.data_window)
plot(cp5MinRetained, "FTHS_CP5_MinLevelsRetained", display=display.data_window)
plot(cp10PM, "FTHS_CP10_PM_State", display=display.data_window)
plot(cp10AH, "FTHS_CP10_AH_State", display=display.data_window)
plot(cp10PD, "FTHS_CP10_PD_State", display=display.data_window)
plot(cp10Retained, "FTHS_CP10_LevelsRetained", display=display.data_window)
plot(cp10MinRetained, "FTHS_CP10_MinLevelsRetained", display=display.data_window)
plot(cp1PMLost, "FTHS_CP1_PM_Lost", display=display.data_window)
plot(cp1PMRecl, "FTHS_CP1_PM_Reclaimed", display=display.data_window)
plot(cp1AHLost, "FTHS_CP1_AH_Lost", display=display.data_window)
plot(cp1AHRecl, "FTHS_CP1_AH_Reclaimed", display=display.data_window)
plot(cp1PDLost, "FTHS_CP1_PD_Lost", display=display.data_window)
plot(cp1PDRecl, "FTHS_CP1_PD_Reclaimed", display=display.data_window)
plot(cp2PMLost, "FTHS_CP2_PM_Lost", display=display.data_window)
plot(cp2PMRecl, "FTHS_CP2_PM_Reclaimed", display=display.data_window)
plot(cp2AHLost, "FTHS_CP2_AH_Lost", display=display.data_window)
plot(cp2AHRecl, "FTHS_CP2_AH_Reclaimed", display=display.data_window)
plot(cp2PDLost, "FTHS_CP2_PD_Lost", display=display.data_window)
plot(cp2PDRecl, "FTHS_CP2_PD_Reclaimed", display=display.data_window)
plot(cp3PMLost, "FTHS_CP3_PM_Lost", display=display.data_window)
plot(cp3PMRecl, "FTHS_CP3_PM_Reclaimed", display=display.data_window)
plot(cp3AHLost, "FTHS_CP3_AH_Lost", display=display.data_window)
plot(cp3AHRecl, "FTHS_CP3_AH_Reclaimed", display=display.data_window)
plot(cp3PDLost, "FTHS_CP3_PD_Lost", display=display.data_window)
plot(cp3PDRecl, "FTHS_CP3_PD_Reclaimed", display=display.data_window)
plot(cp5PMLost, "FTHS_CP5_PM_Lost", display=display.data_window)
plot(cp5PMRecl, "FTHS_CP5_PM_Reclaimed", display=display.data_window)
plot(cp5AHLost, "FTHS_CP5_AH_Lost", display=display.data_window)
plot(cp5AHRecl, "FTHS_CP5_AH_Reclaimed", display=display.data_window)
plot(cp5PDLost, "FTHS_CP5_PD_Lost", display=display.data_window)
plot(cp5PDRecl, "FTHS_CP5_PD_Reclaimed", display=display.data_window)
plot(cp10PMLost, "FTHS_CP10_PM_Lost", display=display.data_window)
plot(cp10PMRecl, "FTHS_CP10_PM_Reclaimed", display=display.data_window)
plot(cp10AHLost, "FTHS_CP10_AH_Lost", display=display.data_window)
plot(cp10AHRecl, "FTHS_CP10_AH_Reclaimed", display=display.data_window)
plot(cp10PDLost, "FTHS_CP10_PD_Lost", display=display.data_window)
plot(cp10PDRecl, "FTHS_CP10_PD_Reclaimed", display=display.data_window)

var table status = table.new(position.top_center,2,4,frame_color=color.gray,frame_width=1)
if barstate.islast
    table.clear(status,0,0,1,3)
    if showStatusTable
        table.cell(status,0,0,"BUILD")
        table.cell(status,1,0,BUILD_ID)
        table.cell(status,0,1,"Event")
        table.cell(status,1,1,researchEvent ? "YES" : "NO")
        table.cell(status,0,2,"Direction")
        table.cell(status,1,2,eventDirection == 1 ? "BULL" : eventDirection == -1 ? "BEAR" : "NONE")
        table.cell(status,0,3,"Purpose")
        table.cell(status,1,3,"Structure health")
