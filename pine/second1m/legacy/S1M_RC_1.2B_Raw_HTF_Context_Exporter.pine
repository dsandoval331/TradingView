//@version=6
indicator(
     "Second 1M Research Collector - S1M_RC_1.2B Raw HTF Context",
     overlay=false
     )

// ============================================================================
// BUILD
// ============================================================================

string BUILD_ID = "S1M_RC_1.2B"

// ============================================================================
// SETTINGS
// ============================================================================

spxSymbol = input.symbol(
     "SP:SPX",
     "S&P 500 Symbol",
     group="Bias Context"
     )

nasdaqSymbol = input.symbol(
     "NASDAQ:IXIC",
     "Nasdaq Composite Symbol",
     group="Bias Context"
     )

djiaSymbol = input.symbol(
     "DJ:DJI",
     "DJIA Symbol",
     group="Bias Context"
     )

showStatusTable = input.bool(
     true,
     "Show Status Table",
     group="Validation"
     )

// ============================================================================
// STOCK DAILY RAW CONTEXT
// D1 = previous completed daily candle
// D2 = completed daily candle immediately before D1
// ============================================================================

[stkD1O,
 stkD1H,
 stkD1L,
 stkD1C,
 stkD2O,
 stkD2H,
 stkD2L,
 stkD2C] = request.security(
     syminfo.tickerid,
     "D",
     [
         open[1], high[1], low[1], close[1],
         open[2], high[2], low[2], close[2]
     ],
     lookahead=barmerge.lookahead_on
     )

// ============================================================================
// STOCK WEEKLY RAW CONTEXT
// W1 = previous completed weekly candle
// W2 = completed weekly candle immediately before W1
// ============================================================================

[stkW1O,
 stkW1H,
 stkW1L,
 stkW1C,
 stkW2O,
 stkW2H,
 stkW2L,
 stkW2C] = request.security(
     syminfo.tickerid,
     "W",
     [
         open[1], high[1], low[1], close[1],
         open[2], high[2], low[2], close[2]
     ],
     lookahead=barmerge.lookahead_on
     )

// ============================================================================
// SPX DAILY / WEEKLY RAW CONTEXT
// ============================================================================

[spxD1O,
 spxD1H,
 spxD1L,
 spxD1C,
 spxD2O,
 spxD2H,
 spxD2L,
 spxD2C] = request.security(
     spxSymbol,
     "D",
     [
         open[1], high[1], low[1], close[1],
         open[2], high[2], low[2], close[2]
     ],
     lookahead=barmerge.lookahead_on
     )

[spxW1O,
 spxW1H,
 spxW1L,
 spxW1C,
 spxW2O,
 spxW2H,
 spxW2L,
 spxW2C] = request.security(
     spxSymbol,
     "W",
     [
         open[1], high[1], low[1], close[1],
         open[2], high[2], low[2], close[2]
     ],
     lookahead=barmerge.lookahead_on
     )

// ============================================================================
// NASDAQ DAILY / WEEKLY RAW CONTEXT
// ============================================================================

[nasD1O,
 nasD1H,
 nasD1L,
 nasD1C,
 nasD2O,
 nasD2H,
 nasD2L,
 nasD2C] = request.security(
     nasdaqSymbol,
     "D",
     [
         open[1], high[1], low[1], close[1],
         open[2], high[2], low[2], close[2]
     ],
     lookahead=barmerge.lookahead_on
     )

[nasW1O,
 nasW1H,
 nasW1L,
 nasW1C,
 nasW2O,
 nasW2H,
 nasW2L,
 nasW2C] = request.security(
     nasdaqSymbol,
     "W",
     [
         open[1], high[1], low[1], close[1],
         open[2], high[2], low[2], close[2]
     ],
     lookahead=barmerge.lookahead_on
     )

// ============================================================================
// DJIA DAILY / WEEKLY RAW CONTEXT
// ============================================================================

[djiD1O,
 djiD1H,
 djiD1L,
 djiD1C,
 djiD2O,
 djiD2H,
 djiD2L,
 djiD2C] = request.security(
     djiaSymbol,
     "D",
     [
         open[1], high[1], low[1], close[1],
         open[2], high[2], low[2], close[2]
     ],
     lookahead=barmerge.lookahead_on
     )

[djiW1O,
 djiW1H,
 djiW1L,
 djiW1C,
 djiW2O,
 djiW2H,
 djiW2L,
 djiW2C] = request.security(
     djiaSymbol,
     "W",
     [
         open[1], high[1], low[1], close[1],
         open[2], high[2], low[2], close[2]
     ],
     lookahead=barmerge.lookahead_on
     )

// ============================================================================
// CSV / DATA WINDOW EXPORT — EXACTLY 64 SERIES
// ============================================================================

// Stock daily — 8
plot(stkD1O, "HTF_Stock_D1_Open", display=display.data_window)
plot(stkD1H, "HTF_Stock_D1_High", display=display.data_window)
plot(stkD1L, "HTF_Stock_D1_Low", display=display.data_window)
plot(stkD1C, "HTF_Stock_D1_Close", display=display.data_window)
plot(stkD2O, "HTF_Stock_D2_Open", display=display.data_window)
plot(stkD2H, "HTF_Stock_D2_High", display=display.data_window)
plot(stkD2L, "HTF_Stock_D2_Low", display=display.data_window)
plot(stkD2C, "HTF_Stock_D2_Close", display=display.data_window)

// Stock weekly — 8
plot(stkW1O, "HTF_Stock_W1_Open", display=display.data_window)
plot(stkW1H, "HTF_Stock_W1_High", display=display.data_window)
plot(stkW1L, "HTF_Stock_W1_Low", display=display.data_window)
plot(stkW1C, "HTF_Stock_W1_Close", display=display.data_window)
