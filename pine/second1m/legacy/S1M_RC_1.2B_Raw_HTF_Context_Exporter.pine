plot(nasD1O, "HTF_NASDAQ_D1_Open", display=display.data_window)
plot(nasD1H, "HTF_NASDAQ_D1_High", display=display.data_window)
plot(nasD1L, "HTF_NASDAQ_D1_Low", display=display.data_window)
plot(nasD1C, "HTF_NASDAQ_D1_Close", display=display.data_window)
