plot(nasD2H, "HTF_NASDAQ_D2_High", display=display.data_window)
plot(nasD2L, "HTF_NASDAQ_D2_Low", display=display.data_window)
plot(nasD2C, "HTF_NASDAQ_D2_Close", display=display.data_window)

// Nasdaq weekly — 8
plot(nasW1O, "HTF_NASDAQ_W1_Open", display=display.data_window)
plot(nasW1H, "HTF_NASDAQ_W1_High", display=display.data_window)
plot(nasW1L, "HTF_NASDAQ_W1_Low", display=display.data_window)
plot(nasW1C, "HTF_NASDAQ_W1_Close", display=display.data_window)
plot(nasW2O, "HTF_NASDAQ_W2_Open", display=display.data_window)
plot(nasW2H, "HTF_NASDAQ_W2_High", display=display.data_window)
plot(nasW2L, "HTF_NASDAQ_W2_Low", display=display.data_window)
plot(nasW2C, "HTF_NASDAQ_W2_Close", display=display.data_window)

// DJIA daily — 8
plot(djiD1O, "HTF_DJIA_D1_Open", display=display.data_window)
plot(djiD1H, "HTF_DJIA_D1_High", display=display.data_window)
plot(djiD1L, "HTF_DJIA_D1_Low", display=display.data_window)
plot(djiD1C, "HTF_DJIA_D1_Close", display=display.data_window)
plot(djiD2O, "HTF_DJIA_D2_Open", display=display.data_window)
plot(djiD2H, "HTF_DJIA_D2_High", display=display.data_window)
