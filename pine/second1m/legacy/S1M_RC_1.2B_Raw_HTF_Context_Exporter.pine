plot(djiW2C, "HTF_DJIA_W2_Close", display=display.data_window)

// ============================================================================
// STATUS TABLE — DOES NOT CONSUME PLOT BUDGET
// ============================================================================

var table statusTable = table.new(
     position.bottom_left,
     2,
     5,
     frame_color=color.gray,
     frame_width=1
     )

if barstate.islast
    table.clear(statusTable, 0, 0, 1, 4)

    if showStatusTable
        table.cell(statusTable, 0, 0, "BUILD")
        table.cell(statusTable, 1, 0, BUILD_ID)
        table.cell(statusTable, 0, 1, "Stock")
        table.cell(statusTable, 1, 1, syminfo.ticker)
        table.cell(statusTable, 0, 2, "SPX")
        table.cell(statusTable, 1, 2, spxSymbol)
        table.cell(statusTable, 0, 3, "Nasdaq")
        table.cell(statusTable, 1, 3, nasdaqSymbol)
        table.cell(statusTable, 0, 4, "DJIA")
        table.cell(statusTable, 1, 4, djiaSymbol)
