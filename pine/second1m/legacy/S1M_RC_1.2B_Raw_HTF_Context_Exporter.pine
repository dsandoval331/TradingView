plot(spxD2H, "HTF_SPX_D2_High", display=display.data_window)
plot(spxD2L, "HTF_SPX_D2_Low", display=display.data_window)
plot(spxD2C, "HTF_SPX_D2_Close", display=display.data_window)

// SPX weekly — 8
plot(spxW1O, "HTF_SPX_W1_Open", display=display.data_window)
plot(spxW1H, "HTF_SPX_W1_High", display=display.data_window)
plot(spxW1L, "HTF_SPX_W1_Low", display=display.data_window)
plot(spxW1C, "HTF_SPX_W1_Close", display=display.data_window)
