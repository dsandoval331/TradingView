plot(djiW1H, "HTF_DJIA_W1_High", display=display.data_window)
plot(djiW1L, "HTF_DJIA_W1_Low", display=display.data_window)
plot(djiW1C, "HTF_DJIA_W1_Close", display=display.data_window)
