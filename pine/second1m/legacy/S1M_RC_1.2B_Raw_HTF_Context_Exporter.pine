plot(stkW2H, "HTF_Stock_W2_High", display=display.data_window)
plot(stkW2L, "HTF_Stock_W2_Low", display=display.data_window)
plot(stkW2C, "HTF_Stock_W2_Close", display=display.data_window)

// SPX daily — 8
plot(spxD1O, "HTF_SPX_D1_Open", display=display.data_window)
plot(spxD1H, "HTF_SPX_D1_High", display=display.data_window)
plot(spxD1L, "HTF_SPX_D1_Low", display=display.data_window)
plot(spxD1C, "HTF_SPX_D1_Close", display=display.data_window)
