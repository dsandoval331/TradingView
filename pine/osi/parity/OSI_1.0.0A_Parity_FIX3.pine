// ============================================================================
// Status table
// ============================================================================
var table status = table.new(position.top_right, 2, 12, frame_color=color.gray, frame_width=1)

if barstate.islast
    table.clear(status, 0, 0, 1, 11)

    if showStatusTable
        table.cell(status,0,0,"BUILD")
        table.cell(status,1,0,BUILD_ID)

        table.cell(status,0,1,"Engine")
        table.cell(status,1,1,engineName)

        table.cell(status,0,2,"Research Event")
        table.cell(status,1,2,researchEvent ? "YES" : "NO")

        table.cell(status,0,3,"Direction")
        table.cell(status,1,3,eventDirection == 1 ? "BULL" : eventDirection == -1 ? "BEAR" : "NONE")

        table.cell(status,0,4,"Signal Quality")
        table.cell(status,1,4,signalQualityState)

        table.cell(status,0,5,"Checkpoint")
        table.cell(status,1,5,na(currentCheckpoint) ? "NONE" : "C" + str.tostring(currentCheckpoint))

        table.cell(status,0,6,"Progress")
        table.cell(status,1,6,f_fmt(currentProgressPct) + "%")

        table.cell(status,0,7,"Active @ Close")
        table.cell(status,1,7,currentActiveAtClose ? "YES" : "NO")

        table.cell(status,0,8,"F1 / F2")
        table.cell(
            status,1,8,
            (f1C6Warning ? "F1" : "-") +
            " / " +
            (na(firstF2Checkpoint) ? "-" : "C" + str.tostring(firstF2Checkpoint)))

        table.cell(status,0,9,"Trade Health")
        table.cell(status,1,9,currentTradeHealthState)

        table.cell(status,0,10,"Relationship")
        table.cell(status,1,10,currentRelationshipState)

        table.cell(status,0,11,"Model")
        table.cell(status,1,11,MODEL_ID)
