plot(c6CumFav, "OSI_C6_CumFavPct", display=display.data_window)
plot(c6CumAdv, "OSI_C6_CumAdvPct", display=display.data_window)
plot(c7CumFav, "OSI_C7_CumFavPct", display=display.data_window)
plot(c7CumAdv, "OSI_C7_CumAdvPct", display=display.data_window)
plot(c8CumFav, "OSI_C8_CumFavPct", display=display.data_window)
