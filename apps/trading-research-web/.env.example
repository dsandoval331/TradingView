NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-server-secret-key
TR_GITHUB_ACTIONS_TOKEN=your-fine-grained-actions-token
TR_GITHUB_REPOSITORY=owner/repository
# Optional outside Vercel preview/production deployments.
TR_GIT_SHA=exact-commit-sha
TR_GIT_REF=branch-containing-ccp9-run-job-workflow
