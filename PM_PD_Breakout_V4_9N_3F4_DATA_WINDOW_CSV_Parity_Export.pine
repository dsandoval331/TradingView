//=============================================================================
// CONSTANTS
//=============================================================================

string tz = "America/New_York"

//-----------------------------------------------------------------------------
// V3 SCORE MODEL
//
// Penetration       = 40
// Body / Range      = 15
// Close Position    = 15
// Range / ATR       = 25
// Confirmation Speed = 5
//
// IMPORTANT:
// Combination Profiles are ANALYTICS ONLY.
// They do not change the V3 alert score or alert trigger behavior.
//-----------------------------------------------------------------------------

float MAX_PEN_POINTS = 40.0
float MAX_BODY_POINTS = 15.0
float MAX_CLOSE_POINTS = 15.0
float MAX_RANGE_POINTS = 25.0
float MAX_SPEED_POINTS = 5.0

float PEN_FULL_SCORE_ATR_PCT = 100.0
float RANGE_FULL_SCORE_ATR_PCT = 150.0

//-----------------------------------------------------------------------------
// Grade-family buckets
//-----------------------------------------------------------------------------

int BUCKET_A = 0
int BUCKET_B = 1
int BUCKET_C = 2
int BUCKET_WEAK = 3
int BUCKET_ALL = 4

//-----------------------------------------------------------------------------
// First-outcome classification
//-----------------------------------------------------------------------------

int FIRST_NONE = 0
int FIRST_FAVORABLE = 1
int FIRST_ADVERSE = 2
int FIRST_BOTH = 3

//-----------------------------------------------------------------------------
// Component indexes
//-----------------------------------------------------------------------------

int COMP_PEN = 0
int COMP_BODY = 1
int COMP_CLOSE = 2
int COMP_RANGE = 3
int COMP_SPEED = 4

//-----------------------------------------------------------------------------
// NEW: Combination Profile indexes
//-----------------------------------------------------------------------------

int PROFILE_CONTROLLED = 0
int PROFILE_EXPLOSIVE = 1
int PROFILE_EFFICIENT = 2
int PROFILE_PRETTY_WEAK = 3
int PROFILE_DELAYED = 4
int PROFILE_UNCLASSIFIED = 5

int PROFILE_COUNT = 6

//-----------------------------------------------------------------------------
// Historical lookback
//-----------------------------------------------------------------------------

int MS_PER_DAY = 86400000
int historicalRecentStart = timenow - historicalLookbackDays * MS_PER_DAY
int historicalCustomStart = historicalEndDate - historicalLookbackDays * MS_PER_DAY

//-----------------------------------------------------------------------------
// HISTORICAL COVERAGE DIAGNOSTICS
//-----------------------------------------------------------------------------

var int diagOldestLoadedBar = na
var int diagNewestLoadedBar = na

var int diagBarsInRequestedWindow = 0

var int diagFirstSignalTime = na
var int diagLastSignalTime = na

var int diagBarsWithPMH = 0
var int diagBarsWithPML = 0
var int diagBarsWithPDH = 0
var int diagBarsWithPDL = 0
var int diagBarsLevelsReady = 0

if barstate.isfirst
    diagOldestLoadedBar := time

diagNewestLoadedBar := time

bool diagInsideRequestedWindow = false

if useHistoricalLookback
    if historicalWindow == "Recent"
        diagInsideRequestedWindow :=
             time >= historicalRecentStart
    else
        diagInsideRequestedWindow :=
             time >= historicalCustomStart and
             time <= historicalEndDate
else
    diagInsideRequestedWindow := true

if diagInsideRequestedWindow
    diagBarsInRequestedWindow += 1

//=============================================================================
// SYMBOL DEFINITIONS
//=============================================================================

string regularTicker = ticker.new(
     syminfo.prefix,
     syminfo.ticker,
     session.regular)

string extendedTicker = ticker.new(
     syminfo.prefix,
     syminfo.ticker,
     session.extended)

//=============================================================================
// GENERAL HELPERS
//=============================================================================

f_clamp(float value, float minimum, float maximum) =>
    math.max(minimum, math.min(value, maximum))

f_signalInLookback(int signalTime) =>
    bool result = true

    if useHistoricalLookback
        if historicalWindow == "Recent"
            result := signalTime >= historicalRecentStart
        else
            result := signalTime >= historicalCustomStart and signalTime <= historicalEndDate

    result

//=============================================================================
// GRADE HELPERS
//=============================================================================

f_grade(float score) =>
    string result = "Weak"

    if score >= 97.0
        result := "A+"
    else if score >= 93.0
        result := "A"
    else if score >= 90.0
        result := "A-"
    else if score >= 87.0
        result := "B+"
    else if score >= 83.0
        result := "B"
    else if score >= 80.0
        result := "B-"
    else if score >= 77.0
        result := "C+"
    else if score >= 73.0
        result := "C"
    else if score >= 70.0
        result := "C-"

    result

f_gradeThreshold(string grade) =>
    float threshold = 70.0

    switch grade
        "A+" => threshold := 97.0
        "A"  => threshold := 93.0
        "A-" => threshold := 90.0
        "B+" => threshold := 87.0
        "B"  => threshold := 83.0
        "B-" => threshold := 80.0
        "C+" => threshold := 77.0
        "C"  => threshold := 73.0
        "C-" => threshold := 70.0

    threshold

f_gradeBucket(string grade) =>
    int bucket = BUCKET_WEAK

    if grade == "A+" or grade == "A" or grade == "A-"
        bucket := BUCKET_A

    else if grade == "B+" or grade == "B" or grade == "B-"
        bucket := BUCKET_B

    else if grade == "C+" or grade == "C" or grade == "C-"
        bucket := BUCKET_C

    bucket

//-----------------------------------------------------------------------------
// Detailed V3 grade buckets
//-----------------------------------------------------------------------------
int V3_GRADE_A_PLUS = 0
int V3_GRADE_A = 1
int V3_GRADE_A_MINUS = 2
int V3_GRADE_B_PLUS = 3
int V3_GRADE_B = 4
int V3_GRADE_B_MINUS = 5
int V3_GRADE_C_PLUS = 6
int V3_GRADE_C = 7
int V3_GRADE_C_MINUS = 8
int V3_GRADE_WEAK = 9
int V3_GRADE_ALL = 10
int V3_GRADE_COUNT = 11

f_v3DetailedBucket(string grade) =>
    int bucket = V3_GRADE_WEAK
    if grade == "A+"
        bucket := V3_GRADE_A_PLUS
    else if grade == "A"
        bucket := V3_GRADE_A
    else if grade == "A-"
        bucket := V3_GRADE_A_MINUS
    else if grade == "B+"
        bucket := V3_GRADE_B_PLUS
    else if grade == "B"
        bucket := V3_GRADE_B
    else if grade == "B-"
        bucket := V3_GRADE_B_MINUS
    else if grade == "C+"
        bucket := V3_GRADE_C_PLUS
    else if grade == "C"
        bucket := V3_GRADE_C
    else if grade == "C-"
        bucket := V3_GRADE_C_MINUS
    bucket

//=============================================================================
// V3 SCORING FUNCTIONS
//=============================================================================

f_penetrationScore(float penetrationATR) =>
    float normalized = f_clamp(
         penetrationATR / PEN_FULL_SCORE_ATR_PCT,
         0.0,
         1.0)

    normalized * MAX_PEN_POINTS

f_bodyScore(float ratio) =>
    f_clamp(
         ratio / 100.0,
         0.0,
         1.0) *
         MAX_BODY_POINTS

f_closeScore(float closePosition) =>
    float normalized = f_clamp(
         (closePosition - 50.0) / 50.0,
         0.0,
         1.0)

    normalized * MAX_CLOSE_POINTS

f_rangeScore(float candleRangeATR) =>
    float normalized = f_clamp(
         candleRangeATR / RANGE_FULL_SCORE_ATR_PCT,
         0.0,
         1.0)

    normalized * MAX_RANGE_POINTS

f_speedScore(int barsToConfirm) =>
    float score = 0.0

    if barsToConfirm <= 0
        score := 5.0

    else if barsToConfirm == 1
        score := 4.5

    else if barsToConfirm == 2
        score := 3.0

    else if barsToConfirm == 3
        score := 1.5

    else
        score := 0.0

    score

//=============================================================================
// SWEET-SPOT BUCKET HELPERS
//=============================================================================

f_sweetBucket(
     float penetration,
     float rangeValue,
     float bodyValue,
     float closeValue,
     int speedBars) =>

    int bucket = 0

    if sweetSpotComponent == "Penetration"

        if penetration < 20.0
            bucket := 0

        else if penetration < 40.0
            bucket := 1

        else if penetration < 60.0
            bucket := 2

        else if penetration < 100.0
            bucket := 3

        else
            bucket := 4

    else if sweetSpotComponent == "Range / ATR"

        if rangeValue < 50.0
            bucket := 0

        else if rangeValue < 100.0
            bucket := 1

        else if rangeValue < 150.0
            bucket := 2

        else if rangeValue < 200.0
            bucket := 3

        else
            bucket := 4

    else if sweetSpotComponent == "Body / Range"

        if bodyValue < 60.0
            bucket := 0

        else if bodyValue < 70.0
            bucket := 1

        else if bodyValue < 80.0
            bucket := 2

        else if bodyValue < 90.0
            bucket := 3

        else
            bucket := 4

    else if sweetSpotComponent == "Close Position"

        if closeValue < 60.0
            bucket := 0

        else if closeValue < 70.0
            bucket := 1

        else if closeValue < 80.0
            bucket := 2

        else if closeValue < 90.0
            bucket := 3

        else
            bucket := 4

    else

        if speedBars <= 0
            bucket := 0

        else if speedBars == 1
            bucket := 1

        else if speedBars == 2
            bucket := 2

        else if speedBars == 3
            bucket := 3

        else
            bucket := 4

    bucket

f_sweetBucketName(int bucket) =>
    string result = ""

    if sweetSpotComponent == "Penetration"

        if bucket == 0
            result := "<20% ATR"

        else if bucket == 1
            result := "20-40% ATR"

        else if bucket == 2
            result := "40-60% ATR"

        else if bucket == 3
            result := "60-100% ATR"

        else
            result := "100%+ ATR"

    else if sweetSpotComponent == "Range / ATR"

        if bucket == 0
            result := "<50% ATR"

        else if bucket == 1
            result := "50-100% ATR"

        else if bucket == 2
            result := "100-150% ATR"

        else if bucket == 3
            result := "150-200% ATR"

        else
            result := "200%+ ATR"

    else if sweetSpotComponent == "Body / Range"

        if bucket == 0
            result := "<60%"

        else if bucket == 1
            result := "60-70%"

        else if bucket == 2
            result := "70-80%"

        else if bucket == 3
            result := "80-90%"

        else
            result := "90%+"

    else if sweetSpotComponent == "Close Position"

        if bucket == 0
            result := "<60%"

        else if bucket == 1
            result := "60-70%"

        else if bucket == 2
            result := "70-80%"

        else if bucket == 3
            result := "80-90%"

        else
            result := "90%+"

    else

        if bucket == 0
            result := "0 bars"

        else if bucket == 1
            result := "1 bar"

        else if bucket == 2
            result := "2 bars"

        else if bucket == 3
            result := "3 bars"

        else
            result := "4+ bars"

    result

//=============================================================================
// NEW: COMBINATION PROFILE CLASSIFICATION
//=============================================================================
//
// These profiles are for HISTORICAL ANALYSIS ONLY.
//
// Priority is important because some setups can technically satisfy more than
// one definition. More specific profiles are checked first.
//
// 1. EXPLOSIVE
//    Penetration >= 100% ATR
//    Range / ATR >= 200%
//    Body / Range >= 80%
//    Close Position >= 90%
//    Immediate confirmation
//
// 2. CONTROLLED STRONG
//    Penetration 60-100% ATR
//    Range / ATR 100-200%
//    Body / Range 70-90%
//    Close Position >= 80%
//    Confirmation in 0-1 bars
//
// 3. EFFICIENT MODERATE
//    Penetration 40-60% ATR
//    Range / ATR 100-150%
//    Body / Range 70-90%
//    Close Position >= 80%
//    Confirmation in 0-1 bars
//
// 4. PRETTY BUT WEAK
//    Penetration < 40% ATR
//    Range / ATR < 100%
//    Body / Range >= 90%
//    Close Position >= 90%
//    Immediate confirmation
//
// 5. DELAYED STRONG
//    Penetration >= 60% ATR
//    Range / ATR >= 100%
//    Body / Range >= 70%
//    Close Position >= 80%
//    Confirmation in 1-2 bars
//
// Anything else is UNCLASSIFIED.
//=============================================================================

f_combinationProfile(
     float penetration,
     float rangeValue,
     float bodyValue,
     float closeValue,
     int speedBars) =>

    int profile = PROFILE_UNCLASSIFIED

    bool explosive =
         penetration >= 100.0 and
         rangeValue >= 200.0 and
         bodyValue >= 80.0 and
         closeValue >= 90.0 and
         speedBars == 0

    bool controlledStrong =
         penetration >= 60.0 and
         penetration < 100.0 and
         rangeValue >= 100.0 and
         rangeValue < 200.0 and
         bodyValue >= 70.0 and
         bodyValue < 90.0 and
         closeValue >= 80.0 and
         speedBars >= 0 and
         speedBars <= 1

    bool efficientModerate =
         penetration >= 40.0 and
         penetration < 60.0 and
         rangeValue >= 100.0 and
         rangeValue < 150.0 and
         bodyValue >= 70.0 and
         bodyValue < 90.0 and
         closeValue >= 80.0 and
         speedBars >= 0 and
         speedBars <= 1

    bool prettyButWeak =
         penetration < 40.0 and
         rangeValue < 100.0 and
         bodyValue >= 90.0 and
         closeValue >= 90.0 and
         speedBars == 0

    bool delayedStrong =
         penetration >= 60.0 and
         rangeValue >= 100.0 and
         bodyValue >= 70.0 and
         closeValue >= 80.0 and
         speedBars >= 1 and
         speedBars <= 2

    if explosive
        profile := PROFILE_EXPLOSIVE

    else if controlledStrong
        profile := PROFILE_CONTROLLED

    else if efficientModerate
        profile := PROFILE_EFFICIENT

    else if prettyButWeak
        profile := PROFILE_PRETTY_WEAK

    else if delayedStrong
        profile := PROFILE_DELAYED

    profile


//=============================================================================
// PROPOSED V4 PROFILE CLASSIFICATION - VALIDATION ONLY
//=============================================================================
//
// Precedence:
// 1. Explosive
// 2. Controlled Strong
// 3. Efficient Moderate
// 4. Delayed Strong
// 5. Pretty but Weak
// 6. Unclassified
//
// IMPORTANT: This function is analytics-only. It does not replace the current
// V3 profile assigned to live/historical signals and does not alter alerts.
//=============================================================================

f_v4CombinationProfile(
     float penetration,
     float rangeValue,
     float bodyValue,
     float closeValue,
     int speedBars) =>

    int profile = PROFILE_UNCLASSIFIED

    bool explosive =
         (
             (penetration >= 100.0 and rangeValue >= 100.0) or
             (rangeValue >= 200.0 and penetration >= 40.0)
         ) and
         bodyValue >= 50.0 and
         closeValue >= 70.0 and
         speedBars >= 0 and
         speedBars <= 1

    bool controlledStrong =
         penetration >= 60.0 and
         rangeValue >= 100.0 and
         bodyValue >= 60.0 and
         closeValue >= 80.0 and
         speedBars >= 0 and
         speedBars <= 1

    bool efficientModerate =
         penetration >= 40.0 and
         rangeValue >= 75.0 and
         bodyValue >= 65.0 and
         closeValue >= 80.0 and
         speedBars >= 0 and
         speedBars <= 1

    bool delayedStrong =
         penetration >= 60.0 and
         rangeValue >= 100.0 and
         bodyValue >= 65.0 and
         closeValue >= 80.0 and
         speedBars >= 2 and
         speedBars <= 3

    bool prettyButWeak =
         bodyValue >= 70.0 and
         closeValue >= 80.0 and
         speedBars >= 0 and
         speedBars <= 1 and
         (penetration < 40.0 or rangeValue < 75.0)

    if explosive
        profile := PROFILE_EXPLOSIVE
    else if controlledStrong
        profile := PROFILE_CONTROLLED
    else if efficientModerate
        profile := PROFILE_EFFICIENT
    else if delayedStrong
        profile := PROFILE_DELAYED
    else if prettyButWeak
        profile := PROFILE_PRETTY_WEAK

    profile

f_profileName(int profile) =>
    string result = "Unclassified"

    if profile == PROFILE_CONTROLLED
        result := "Controlled Strong"

    else if profile == PROFILE_EXPLOSIVE
        result := "Explosive"

    else if profile == PROFILE_EFFICIENT
        result := "Efficient Moderate"

    else if profile == PROFILE_PRETTY_WEAK
        result := "Pretty but Weak"

    else if profile == PROFILE_DELAYED
        result := "Delayed Strong"

    result


//=============================================================================
// V4 PRODUCTION LOOKUP MATRIX - FROZEN FOR FORWARD VALIDATION
//=============================================================================

int PRIORITY_OBSERVE = 0
int PRIORITY_LOW = 1
int PRIORITY_RESEARCH = 2
int PRIORITY_CONDITIONAL = 3
int PRIORITY_PRIME = 4
int PRIORITY_ALL = 5

f_priorityCode(int gradeBucket, int profile) =>
    int result = PRIORITY_RESEARCH

    if profile == PROFILE_EXPLOSIVE and
       (gradeBucket == BUCKET_A or gradeBucket == BUCKET_B or gradeBucket == BUCKET_C)
        result := PRIORITY_PRIME

    else if profile == PROFILE_CONTROLLED and gradeBucket == BUCKET_C
        result := PRIORITY_PRIME

    else if profile == PROFILE_CONTROLLED and gradeBucket == BUCKET_B
        result := PRIORITY_CONDITIONAL

    else if profile == PROFILE_EFFICIENT and (gradeBucket == BUCKET_C or gradeBucket == BUCKET_WEAK)
        result := PRIORITY_CONDITIONAL

    else if profile == PROFILE_DELAYED and gradeBucket == BUCKET_A
        result := PRIORITY_RESEARCH

    else if profile == PROFILE_PRETTY_WEAK
        result := PRIORITY_LOW

    else if profile == PROFILE_UNCLASSIFIED
        result := PRIORITY_OBSERVE

    else if profile == PROFILE_CONTROLLED and gradeBucket == BUCKET_A
        result := PRIORITY_OBSERVE

    result

f_priorityName(int priority) =>
    priority == PRIORITY_PRIME ? "PRIME" :
     priority == PRIORITY_CONDITIONAL ? "CONDITIONAL" :
     priority == PRIORITY_RESEARCH ? "RESEARCH" :
     priority == PRIORITY_LOW ? "LOW" : "OBSERVE"

f_tradeType(int gradeBucket, int profile) =>
    string result = "OBSERVE"

    if profile == PROFILE_EXPLOSIVE
        result := "EXPANSION"
    else if profile == PROFILE_CONTROLLED or profile == PROFILE_EFFICIENT
        result := "SCALP"
    else if profile == PROFILE_DELAYED and gradeBucket == BUCKET_A
        result := "EXPANSION"

    result

f_productionTQS(int gradeBucket, int profile) =>
    float result = na

    if profile == PROFILE_EXPLOSIVE and gradeBucket == BUCKET_A
        result := 42.7
    else if profile == PROFILE_EXPLOSIVE and gradeBucket == BUCKET_B
        result := 42.1
    else if profile == PROFILE_EXPLOSIVE and gradeBucket == BUCKET_C
        result := 50.2
    else if profile == PROFILE_CONTROLLED and gradeBucket == BUCKET_C
        result := 42.2
    else if profile == PROFILE_CONTROLLED and gradeBucket == BUCKET_B
        result := 33.4
    else if profile == PROFILE_EFFICIENT and gradeBucket == BUCKET_C
        result := 36.1
    else if profile == PROFILE_EFFICIENT and gradeBucket == BUCKET_WEAK
        result := 36.7
    else if profile == PROFILE_DELAYED and gradeBucket == BUCKET_A
        result := 59.9
    else if profile == PROFILE_CONTROLLED and gradeBucket == BUCKET_A
        result := 31.0
    else if profile == PROFILE_PRETTY_WEAK and gradeBucket == BUCKET_WEAK
        result := 30.4

    result

f_productionConfidence(int gradeBucket, int profile) =>
    string result = "INSUFFICIENT"

    if profile == PROFILE_EXPLOSIVE and gradeBucket == BUCKET_A
        result := "HIGH"
    else if profile == PROFILE_EXPLOSIVE and gradeBucket == BUCKET_B
        result := "HIGH"
    else if profile == PROFILE_EXPLOSIVE and gradeBucket == BUCKET_C
        result := "MODERATE"
    else if profile == PROFILE_CONTROLLED and gradeBucket == BUCKET_C
        result := "MOD-HIGH"
    else if profile == PROFILE_CONTROLLED and gradeBucket == BUCKET_B
        result := "HIGH"
    else if profile == PROFILE_EFFICIENT and gradeBucket == BUCKET_C
        result := "HIGH"
    else if profile == PROFILE_EFFICIENT and gradeBucket == BUCKET_WEAK
        result := "HIGH"
    else if profile == PROFILE_DELAYED and gradeBucket == BUCKET_A
        result := "LOW"
    else if profile == PROFILE_CONTROLLED and gradeBucket == BUCKET_A
        result := "MODERATE"
    else if profile == PROFILE_PRETTY_WEAK and gradeBucket == BUCKET_WEAK
        result := "HIGH"

    result

f_priorityAlertPass(int priority) =>
    bool result = false

    if minimumAlertPriority == "Prime Only"
        result := priority == PRIORITY_PRIME

    else if minimumAlertPriority == "Conditional+"
        result := priority >= PRIORITY_CONDITIONAL

    else
        result :=
             priority >= PRIORITY_CONDITIONAL or
             (priority == PRIORITY_RESEARCH and showResearchPriorityAlerts) or
             ((priority == PRIORITY_LOW or priority == PRIORITY_OBSERVE) and showLowObserveAlerts)

    result

//=============================================================================
// PROFILE COMPONENT ANALYSIS HELPERS
//=============================================================================

f_selectedProfileIndex() =>
    int result = PROFILE_EFFICIENT

    if profileAnalysisSelection == "Controlled Strong"
        result := PROFILE_CONTROLLED
    else if profileAnalysisSelection == "Explosive"
        result := PROFILE_EXPLOSIVE
    else if profileAnalysisSelection == "Efficient Moderate"
        result := PROFILE_EFFICIENT
    else if profileAnalysisSelection == "Pretty but Weak"
        result := PROFILE_PRETTY_WEAK
    else if profileAnalysisSelection == "Delayed Strong"
        result := PROFILE_DELAYED

    result

f_profileIncluded(int signalProfile) =>
    bool included = false

    if profileAnalysisSelection == "All Classified"
        included := signalProfile != PROFILE_UNCLASSIFIED
    else
        included := signalProfile == f_selectedProfileIndex()

    included

f_profileAnalysisComponentIndex() =>
    int result = COMP_PEN

    if profileAnalysisComponent == "Penetration"
        result := COMP_PEN
    else if profileAnalysisComponent == "Range / ATR"
        result := COMP_RANGE
    else if profileAnalysisComponent == "Body / Range"
        result := COMP_BODY
    else if profileAnalysisComponent == "Close Position"
        result := COMP_CLOSE
    else
        result := COMP_SPEED

    result

f_profileComponentBucket(
     int componentIndex,
     float penetration,
     float rangeValue,
     float bodyValue,
     float closeValue,
     int speedBars) =>

    int bucket = 0

    if componentIndex == COMP_PEN
        if penetration < 20.0
            bucket := 0
        else if penetration < 40.0
            bucket := 1
        else if penetration < 60.0
            bucket := 2
        else if penetration < 100.0
            bucket := 3
        else
            bucket := 4

    else if componentIndex == COMP_RANGE
        if rangeValue < 50.0
            bucket := 0
        else if rangeValue < 100.0
            bucket := 1
        else if rangeValue < 150.0
            bucket := 2
        else if rangeValue < 200.0
            bucket := 3
        else
            bucket := 4

    else if componentIndex == COMP_BODY
        if bodyValue < 60.0
            bucket := 0
        else if bodyValue < 70.0
            bucket := 1
        else if bodyValue < 80.0
            bucket := 2
        else if bodyValue < 90.0
            bucket := 3
        else
            bucket := 4

    else if componentIndex == COMP_CLOSE
        if closeValue < 60.0
            bucket := 0
        else if closeValue < 70.0
            bucket := 1
        else if closeValue < 80.0
            bucket := 2
        else if closeValue < 90.0
            bucket := 3
        else
            bucket := 4

    else
        if speedBars <= 0
            bucket := 0
        else if speedBars == 1
            bucket := 1
        else if speedBars == 2
            bucket := 2
        else if speedBars == 3
            bucket := 3
        else
            bucket := 4

    bucket

f_profileComponentBucketName(int componentIndex, int bucket) =>
    string result = ""

    if componentIndex == COMP_PEN
        if bucket == 0
            result := "<20% ATR"
        else if bucket == 1
            result := "20-40% ATR"
        else if bucket == 2
            result := "40-60% ATR"
        else if bucket == 3
            result := "60-100% ATR"
        else
            result := "100%+ ATR"

    else if componentIndex == COMP_RANGE
        if bucket == 0
            result := "<50% ATR"
        else if bucket == 1
            result := "50-100% ATR"
        else if bucket == 2
            result := "100-150% ATR"
        else if bucket == 3
            result := "150-200% ATR"
        else
            result := "200%+ ATR"

    else if componentIndex == COMP_BODY
        if bucket == 0
            result := "<60%"
        else if bucket == 1
            result := "60-70%"
        else if bucket == 2
            result := "70-80%"
        else if bucket == 3
            result := "80-90%"
        else
            result := "90%+"

    else if componentIndex == COMP_CLOSE
        if bucket == 0
            result := "<60%"
        else if bucket == 1
            result := "60-70%"
        else if bucket == 2
            result := "70-80%"
        else if bucket == 3
            result := "80-90%"
        else
            result := "90%+"

    else
        if bucket == 0
            result := "0 bars"
        else if bucket == 1
            result := "1 bar"
        else if bucket == 2
            result := "2 bars"
        else if bucket == 3
            result := "3 bars"
        else
            result := "4+ bars"

    result

//=============================================================================
// DISPLAY HELPERS
//=============================================================================

f_levelText(string levelName, float price) =>
    string result = levelName

    if showLevelPrices
        result :=
             levelName +
             " " +
             str.tostring(price, format.mintick)

    result

f_num(float value) =>
    string result = "-"

    if not na(value)
        result := str.tostring(value, format.mintick)

    result

f_pct(float value) =>
    string result = "-"

    if not na(value)
        result := str.tostring(value, "#.0") + "%"

    result

f_points(float value, float maximum) =>
    string result = "-"

    if not na(value)
        result :=
             str.tostring(value, "#.0") +
             " / " +
             str.tostring(maximum, "#.0")

    result

f_timeText(int t) =>
    string result = "-"

    if not na(t)
        result :=
             str.format_time(
                 t,
                 "HH:mm",
                 tz)

    result

f_passText(bool enabled, bool passed) =>
    string result = "OFF"

    if enabled
        result :=
             passed ?
             "PASS" :
             "FAIL"

    result

f_signedPct(float value) =>
    string result = "-"

    if not na(value)
        result :=
             value > 0 ?
             "+" + str.tostring(value, "#.00") + "%" :
             str.tostring(value, "#.00") + "%"

    result

f_decimal(float value) =>
    string result = "-"

    if not na(value)
        result := str.tostring(value, "#.00")

    result

f_signedDecimal(float value) =>
    string result = "-"

    if not na(value)
        result :=
             value > 0 ?
             "+" + str.tostring(value, "#.00") :
             str.tostring(value, "#.00")

    result

f_plainPct(float value) =>
    string result = "-"

    if not na(value)
        result := str.tostring(value, "#.0") + "%"

    result

f_signedOnePct(float value) =>
    string result = "-"

    if not na(value)
        result :=
             value > 0 ?
             "+" + str.tostring(value, "#.0") + "%" :
             str.tostring(value, "#.0") + "%"

    result

//=============================================================================
// FORWARD-VALIDATION REPAINT / LOOKAHEAD AUDIT
//=============================================================================
//
// Frozen build audit:
// - PDH/PDL use the PRIOR completed daily bar: high[1]/low[1] with lookahead_on.
// - Confirmation OHLC/ATR/time use the PRIOR completed confirmation bar [1]
//   with lookahead_on. The current confirmation bar is used only to detect that
//   a new confirmation interval has begun.
// - PMH/PML use lookahead_off on the extended-hours ticker.
// - A signal is classified only after a completed confirmation candle.
// - MFE/MAE tracking begins on subsequent completed confirmation candles.
// - Forward-validation statistics are added only when signalTime is on/after
//   forwardValidationStart and are finalized after the trading session.
//
// No production thresholds or historical lookup values were changed by this
// cleanup build.
//=============================================================================

//=============================================================================
// PREVIOUS DAY HIGH / LOW
//=============================================================================

float pdh = request.security(
     regularTicker,
     "D",
     high[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

float pdl = request.security(
     regularTicker,
     "D",
     low[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

//=============================================================================
// PREMARKET HIGH / LOW
//=============================================================================

f_premarketLevels() =>
    var float localPMH = na
    var float localPML = na

    bool inPM = not na(time("", pmSession, tz))
    bool newPM = inPM and not inPM[1]

    if newPM
        localPMH := high
        localPML := low

    else if inPM
        localPMH := na(localPMH) ?
             high :
             math.max(localPMH, high)

        localPML := na(localPML) ?
             low :
             math.min(localPML, low)

    [localPMH, localPML]

[pmh, pml] = request.security(
     extendedTicker,
     confirmTF,
     f_premarketLevels(),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off)

//=============================================================================
// SESSION STATUS
//=============================================================================

bool inRTH = not na(time(timeframe.period, rthSession, tz))

bool previousInRTH = false

if bar_index > 0
    previousInRTH := inRTH[1]

bool rthStart = inRTH and not previousInRTH
bool newDay = timeframe.change("D")

//=============================================================================
// FINAL LEVELS
//=============================================================================

bool levelsReady =
     not na(pmh) and
     not na(pml) and
     not na(pdh) and
     not na(pdl)

if diagInsideRequestedWindow
    if not na(pmh)
        diagBarsWithPMH += 1

    if not na(pml)
        diagBarsWithPML += 1

    if not na(pdh)
        diagBarsWithPDH += 1

    if not na(pdl)
        diagBarsWithPDL += 1

    if levelsReady
        diagBarsLevelsReady += 1

float bullishFinalLevel = na
float bearishFinalLevel = na

string bullishFinalName = ""
string bearishFinalName = ""

if levelsReady
    bullishFinalLevel := math.max(pmh, pdh)
    bearishFinalLevel := math.min(pml, pdl)

    bullishFinalName :=
         pmh >= pdh ?
         "PMH" :
         "PDH"

    bearishFinalName :=
         pml <= pdl ?
         "PML" :
         "PDL"

//=============================================================================
// LEVEL COLORS
//=============================================================================

color pmhColor = secondaryHighColor
color pdhColor = secondaryHighColor
color pmlColor = secondaryLowColor
color pdlColor = secondaryLowColor

if levelsReady
    if pmh >= pdh
        pmhColor := strongHighColor
        pdhColor := secondaryHighColor
    else
        pmhColor := secondaryHighColor
        pdhColor := strongHighColor

    if pml <= pdl
        pmlColor := strongLowColor
        pdlColor := secondaryLowColor
    else
        pmlColor := secondaryLowColor
        pdlColor := strongLowColor

//=============================================================================
// RTH LEVEL LINES
//=============================================================================

var line currentPMHLine = na
var line currentPDHLine = na
var line currentPMLLine = na
var line currentPDLLine = na

var label currentPMHLabel = na
var label currentPDHLabel = na
var label currentPMLLabel = na
var label currentPDLLabel = na

if newDay
    currentPMHLine := na
    currentPDHLine := na
    currentPMLLine := na
    currentPDLLine := na

    currentPMHLabel := na
    currentPDHLabel := na
    currentPMLLabel := na
    currentPDLLabel := na

if rthStart and levelsReady and showLevels
    currentPMHLine := line.new(
         time,
         pmh,
         time_close,
         pmh,
         xloc = xloc.bar_time,
         extend = extend.none,
         color = pmhColor,
         style = line.style_dotted,
         width = lineWidth)

    currentPDHLine := line.new(
         time,
         pdh,
         time_close,
         pdh,
         xloc = xloc.bar_time,
         extend = extend.none,
         color = pdhColor,
         style = line.style_dotted,
         width = lineWidth)

    currentPMLLine := line.new(
         time,
         pml,
         time_close,
         pml,
         xloc = xloc.bar_time,
         extend = extend.none,
         color = pmlColor,
         style = line.style_dotted,
         width = lineWidth)

    currentPDLLine := line.new(
         time,
         pdl,
         time_close,
         pdl,
         xloc = xloc.bar_time,
         extend = extend.none,
         color = pdlColor,
         style = line.style_dotted,
         width = lineWidth)

    currentPMHLabel := label.new(
         time_close,
         pmh,
         f_levelText("PMH", pmh),
         xloc = xloc.bar_time,
         yloc = yloc.price,
         style = label.style_none,
         textcolor = pmhColor,
         size = size.tiny)

    currentPDHLabel := label.new(
         time_close,
         pdh,
         f_levelText("PDH", pdh),
         xloc = xloc.bar_time,
         yloc = yloc.price,
         style = label.style_none,
         textcolor = pdhColor,
         size = size.tiny)

    currentPMLLabel := label.new(
         time_close,
         pml,
         f_levelText("PML", pml),
         xloc = xloc.bar_time,
         yloc = yloc.price,
         style = label.style_none,
         textcolor = pmlColor,
         size = size.tiny)

    currentPDLLabel := label.new(
         time_close,
         pdl,
         f_levelText("PDL", pdl),
         xloc = xloc.bar_time,
         yloc = yloc.price,
         style = label.style_none,
         textcolor = pdlColor,
         size = size.tiny)

if inRTH and showLevels and levelsReady
    if not na(currentPMHLine)
        line.set_x2(
             currentPMHLine,
             time_close)

    if not na(currentPDHLine)
        line.set_x2(
             currentPDHLine,
             time_close)

    if not na(currentPMLLine)
        line.set_x2(
             currentPMLLine,
             time_close)

    if not na(currentPDLLine)
        line.set_x2(
             currentPDLLine,
             time_close)

    if not na(currentPMHLabel)
        label.set_x(
             currentPMHLabel,
             time_close)

        label.set_y(
             currentPMHLabel,
             pmh)

        label.set_text(
             currentPMHLabel,
             f_levelText("PMH", pmh))

    if not na(currentPDHLabel)
        label.set_x(
             currentPDHLabel,
             time_close)

        label.set_y(
             currentPDHLabel,
             pdh)

        label.set_text(
             currentPDHLabel,
             f_levelText("PDH", pdh))

    if not na(currentPMLLabel)
        label.set_x(
             currentPMLLabel,
             time_close)

        label.set_y(
             currentPMLLabel,
             pml)

        label.set_text(
             currentPMLLabel,
             f_levelText("PML", pml))

    if not na(currentPDLLabel)
        label.set_x(
             currentPDLLabel,
             time_close)

        label.set_y(
             currentPDLLabel,
             pdl)

        label.set_text(
             currentPDLLabel,
             f_levelText("PDL", pdl))

//=============================================================================
// CONFIRMATION-TIMEFRAME DATA
//=============================================================================

float confOpen = request.security(
     regularTicker,
     confirmTF,
     open[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

float confHigh = request.security(
     regularTicker,
     confirmTF,
     high[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

float confLow = request.security(
     regularTicker,
     confirmTF,
     low[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

float confClose = request.security(
     regularTicker,
     confirmTF,
     close[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

float confATR = request.security(
     regularTicker,
     confirmTF,
     ta.atr(atrLength)[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

int confTime = request.security(
     regularTicker,
     confirmTF,
     time[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

int confTimeClose = request.security(
     regularTicker,
     confirmTF,
     time_close[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

int liveConfTime = request.security(
     regularTicker,
     confirmTF,
     time,
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

int liveConfTimeChange = ta.change(liveConfTime)

bool newConfirmationCandle = false

if not na(liveConfTime)
    if liveConfTimeChange != 0
        newConfirmationCandle := true

bool completedPriorSession = false

if newConfirmationCandle and
   not na(confTime) and
   not na(liveConfTime)

    completedPriorSession :=
         year(confTime) != year(liveConfTime) or
         month(confTime) != month(liveConfTime) or
         dayofmonth(confTime) != dayofmonth(liveConfTime)

//=============================================================================
// CANDLE METRICS
//=============================================================================

float confRange = confHigh - confLow
float confBody = math.abs(confClose - confOpen)

float bodyRatio = 0.0
float rangeATR = 0.0

float bullClosePosition = 0.0
float bearClosePosition = 0.0

if confRange > 0
    bodyRatio :=
         confBody /
         confRange *
         100.0

    bullClosePosition :=
         (confClose - confLow) /
         confRange *
         100.0

    bearClosePosition :=
         (confHigh - confClose) /
         confRange *
         100.0

if confATR > 0
    rangeATR :=
         confRange /
         confATR *
         100.0

float bullPenATR = na
float bearPenATR = na

if levelsReady and confATR > 0
    bullPenATR :=
         (confClose - bullishFinalLevel) /
         confATR *
         100.0

    bearPenATR :=
         (bearishFinalLevel - confClose) /
         confATR *
         100.0

//=============================================================================
// FILTERS
//=============================================================================

bool bullDirectionalPass =
     not useDirectionalCandle or
     confClose > confOpen

bool bearDirectionalPass =
     not useDirectionalCandle or
     confClose < confOpen

bool bodyPass =
     not useBodyRatio or
     bodyRatio >= minBodyRatio

bool rangePass =
     not useRangeATR or
     rangeATR >= minRangeATR

bool bullClosePosPass =
     not useClosePosition or
     bullClosePosition >= minClosePosition

bool bearClosePosPass =
     not useClosePosition or
     bearClosePosition >= minClosePosition

bool bullPenPass =
     not usePenetration or
     bullPenATR >= minPenATR

bool bearPenPass =
     not usePenetration or
     bearPenATR >= minPenATR

//=============================================================================
// ACTIVE SIGNAL STORAGE
//=============================================================================

var activeDirection = array.new_int()
var activeReference = array.new_float()
var activeBucket = array.new_int()
var activeSignalTime = array.new_int()

var activeMFE = array.new_float()
var activeMAE = array.new_float()

var activeHitFav1 = array.new_bool()
var activeHitFav2 = array.new_bool()
var activeHitAdverse = array.new_bool()

var activeFirstOutcome = array.new_int()

var activePenScore = array.new_float()
var activeBodyScore = array.new_float()
var activeCloseScore = array.new_float()
var activeRangeScore = array.new_float()
var activeSpeedScore = array.new_float()

//-----------------------------------------------------------------------------
// Raw values used for sweet-spot and combination-profile research.
//-----------------------------------------------------------------------------

var activeRawPen = array.new_float()
var activeRawBody = array.new_float()
var activeRawClose = array.new_float()
var activeRawRange = array.new_float()
var activeRawSpeedBars = array.new_int()

//-----------------------------------------------------------------------------
// NEW:
// Combination profile assigned at the time the alert is generated.
//-----------------------------------------------------------------------------

var activeProfile = array.new_int()

//=============================================================================
// GRADE AGGREGATES
//=============================================================================

var histSignals = array.new_int(5, 0)

var histFavFirst = array.new_int(5, 0)
var histAdvFirst = array.new_int(5, 0)
var histBothFirst = array.new_int(5, 0)

var histFav1Hit = array.new_int(5, 0)
var histFav2Hit = array.new_int(5, 0)

var histMFESum = array.new_float(5, 0.0)
var histMAESum = array.new_float(5, 0.0)

var v3GradeSignals = array.new_int(V3_GRADE_COUNT, 0)
var v3GradeFavFirst = array.new_int(V3_GRADE_COUNT, 0)
var v3GradeBothFirst = array.new_int(V3_GRADE_COUNT, 0)
var v3GradeFav2Hit = array.new_int(V3_GRADE_COUNT, 0)
var v3GradeMFESum = array.new_float(V3_GRADE_COUNT, 0.0)
var v3GradeMAESum = array.new_float(V3_GRADE_COUNT, 0.0)

//=============================================================================
// COMPONENT SUMMARY AGGREGATES
//=============================================================================

var int compFavCount = 0
var compFavSums = array.new_float(5, 0.0)

var int compAdvCount = 0
var compAdvSums = array.new_float(5, 0.0)

var int compAllCount = 0
var compAllSums = array.new_float(5, 0.0)

//=============================================================================
// SWEET-SPOT AGGREGATES
//=============================================================================

var sweetSignals = array.new_int(5, 0)

var sweetFavFirst = array.new_int(5, 0)
var sweetBothFirst = array.new_int(5, 0)

var sweetFav2Hit = array.new_int(5, 0)

var sweetMFESum = array.new_float(5, 0.0)
var sweetMAESum = array.new_float(5, 0.0)

//=============================================================================
// PHASE 4A: UNCLASSIFIED COMPONENT ANALYSIS AGGREGATES
//=============================================================================
//
// 5 components x 5 buckets x 5 grade columns.
// Grade columns: A, B, C, Weak, ALL.
// Only signals whose combination profile is PROFILE_UNCLASSIFIED are stored.
//=============================================================================

int UNCLASS_COMPONENTS = 5
int UNCLASS_BUCKETS = 5
int UNCLASS_GRADES = 5
int UNCLASS_GRADE_ALL = 4
int UNCLASS_TOTAL_CELLS = UNCLASS_COMPONENTS * UNCLASS_BUCKETS * UNCLASS_GRADES

var unclassSignals = array.new_int(UNCLASS_TOTAL_CELLS, 0)
var unclassFavFirst = array.new_int(UNCLASS_TOTAL_CELLS, 0)
var unclassBothFirst = array.new_int(UNCLASS_TOTAL_CELLS, 0)
var unclassFav2Hit = array.new_int(UNCLASS_TOTAL_CELLS, 0)
var unclassMFESum = array.new_float(UNCLASS_TOTAL_CELLS, 0.0)
var unclassMAESum = array.new_float(UNCLASS_TOTAL_CELLS, 0.0)

f_unclassIndex(int component, int bucketValue, int gradeValue) =>
    component * (UNCLASS_BUCKETS * UNCLASS_GRADES) +
     bucketValue * UNCLASS_GRADES +
     gradeValue

f_unclassBucket(
     int component,
     float penetration,
     float rangeValue,
     float bodyValue,
     float closeValue,
     int speedBars) =>

    int result = 0

    if component == 0
        result := penetration < 20.0 ? 0 :
             penetration < 40.0 ? 1 :
             penetration < 60.0 ? 2 :
             penetration < 100.0 ? 3 : 4

    else if component == 1
        result := rangeValue < 50.0 ? 0 :
             rangeValue < 100.0 ? 1 :
             rangeValue < 150.0 ? 2 :
             rangeValue < 200.0 ? 3 : 4

    else if component == 2
        result := bodyValue < 60.0 ? 0 :
             bodyValue < 70.0 ? 1 :
             bodyValue < 80.0 ? 2 :
             bodyValue < 90.0 ? 3 : 4

    else if component == 3
        result := closeValue < 60.0 ? 0 :
             closeValue < 70.0 ? 1 :
             closeValue < 80.0 ? 2 :
             closeValue < 90.0 ? 3 : 4

    else
        result := speedBars <= 0 ? 0 :
             speedBars == 1 ? 1 :
             speedBars == 2 ? 2 :
             speedBars == 3 ? 3 : 4

    result

f_unclassComponentName(int component) =>
    component == 0 ? "PENETRATION" :
     component == 1 ? "RANGE / ATR" :
     component == 2 ? "BODY / RANGE" :
     component == 3 ? "CLOSE POSITION" :
     "CONFIRMATION SPEED"

f_unclassBucketName(int component, int bucketValue) =>
    string result = ""

    if component == 0
        result := bucketValue == 0 ? "<20% ATR" :
             bucketValue == 1 ? "20-40% ATR" :
             bucketValue == 2 ? "40-60% ATR" :
             bucketValue == 3 ? "60-100% ATR" : ">=100% ATR"

    else if component == 1
        result := bucketValue == 0 ? "<50% ATR" :
             bucketValue == 1 ? "50-100% ATR" :
             bucketValue == 2 ? "100-150% ATR" :
             bucketValue == 3 ? "150-200% ATR" : ">=200% ATR"

    else if component == 2
        result := bucketValue == 0 ? "<60%" :
             bucketValue == 1 ? "60-70%" :
             bucketValue == 2 ? "70-80%" :
             bucketValue == 3 ? "80-90%" : ">=90%"

    else if component == 3
        result := bucketValue == 0 ? "<60%" :
             bucketValue == 1 ? "60-70%" :
             bucketValue == 2 ? "70-80%" :
             bucketValue == 3 ? "80-90%" : ">=90%"

    else
        result := bucketValue == 0 ? "Immediate" :
             bucketValue == 1 ? "1 bar" :
             bucketValue == 2 ? "2 bars" :
             bucketValue == 3 ? "3 bars" : "4+ bars"

    result

//=============================================================================
// NEW: COMBINATION PROFILE AGGREGATES
//=============================================================================
//
// Each profile stores:
//
// N
// Favorable-first count
// Both-same-candle count
// +1% hit count
// MFE sum
// MAE sum
//
// Profiles:
// Controlled Strong
// Explosive
// Efficient Moderate
// Pretty but Weak
// Delayed Strong
// Unclassified
//=============================================================================

var profileSignals =
     array.new_int(
         PROFILE_COUNT,
         0)

var profileFavFirst =
     array.new_int(
         PROFILE_COUNT,
         0)

var profileBothFirst =
     array.new_int(
         PROFILE_COUNT,
         0)

var profileFav2Hit =
     array.new_int(
         PROFILE_COUNT,
         0)

var profileMFESum =
     array.new_float(
         PROFILE_COUNT,
         0.0)

var profileMAESum =
     array.new_float(
         PROFILE_COUNT,
         0.0)


//=============================================================================
// PHASE 4A-5: V4 VALIDATION AGGREGATES
//=============================================================================

var v4ProfileSignals = array.new_int(PROFILE_COUNT, 0)
var v4ProfileFavFirst = array.new_int(PROFILE_COUNT, 0)
var v4ProfileBothFirst = array.new_int(PROFILE_COUNT, 0)
var v4ProfileFav2Hit = array.new_int(PROFILE_COUNT, 0)
var v4ProfileMFESum = array.new_float(PROFILE_COUNT, 0.0)
var v4ProfileMAESum = array.new_float(PROFILE_COUNT, 0.0)

// Migration matrix: V3 row x V4 column.
int MIGRATION_CELL_COUNT = PROFILE_COUNT * PROFILE_COUNT
var v3ToV4Migration = array.new_int(MIGRATION_CELL_COUNT, 0)

// Outcomes specifically for signals rescued from V3 Unclassified into each V4 profile.
var rescuedSignals = array.new_int(PROFILE_COUNT, 0)
var rescuedFavFirst = array.new_int(PROFILE_COUNT, 0)
var rescuedBothFirst = array.new_int(PROFILE_COUNT, 0)
var rescuedFav2Hit = array.new_int(PROFILE_COUNT, 0)
var rescuedMFESum = array.new_float(PROFILE_COUNT, 0.0)
var rescuedMAESum = array.new_float(PROFILE_COUNT, 0.0)

// Grade family x proposed V4 profile aggregates.
// Rows/grade families: A, B, C, Weak. Columns/profiles use PROFILE_* constants.
int V4_GRADE_PROFILE_CELL_COUNT = 4 * PROFILE_COUNT
var v4GradeProfileSignals = array.new_int(V4_GRADE_PROFILE_CELL_COUNT, 0)
var v4GradeProfileFavFirst = array.new_int(V4_GRADE_PROFILE_CELL_COUNT, 0)
var v4GradeProfileBothFirst = array.new_int(V4_GRADE_PROFILE_CELL_COUNT, 0)
var v4GradeProfileFav2Hit = array.new_int(V4_GRADE_PROFILE_CELL_COUNT, 0)
var v4GradeProfileMFESum = array.new_float(V4_GRADE_PROFILE_CELL_COUNT, 0.0)
var v4GradeProfileMAESum = array.new_float(V4_GRADE_PROFILE_CELL_COUNT, 0.0)


// Forward-validation aggregates by production priority.
// Indexes: Observe, Low, Research, Conditional, Prime, All.
var forwardSignals = array.new_int(6, 0)
var forwardFavFirst = array.new_int(6, 0)
var forwardBothFirst = array.new_int(6, 0)
var forwardFav2Hit = array.new_int(6, 0)
var forwardMFESum = array.new_float(6, 0.0)
var forwardMAESum = array.new_float(6, 0.0)

//=============================================================================
// GRADE x PROFILE INTERACTION AGGREGATES
//=============================================================================
//
// Flat index = grade family * PROFILE_COUNT + profile.
// Grade families: A, B, C, Weak.
// Each cell stores N, favorable-first, both-same-candle, +1% hit, MFE, MAE.
//=============================================================================

int GRADE_FAMILY_COUNT = 4
int GRADE_PROFILE_CELL_COUNT = GRADE_FAMILY_COUNT * PROFILE_COUNT

// Exact-grade x profile research cells: A+, A, A-, B+, B, B-, C+, C, C-, Weak.
int EXACT_GRADE_COUNT = 10
int EXACT_GRADE_PROFILE_CELL_COUNT = EXACT_GRADE_COUNT * PROFILE_COUNT

var gradeProfileSignals = array.new_int(GRADE_PROFILE_CELL_COUNT, 0)
var gradeProfileFavFirst = array.new_int(GRADE_PROFILE_CELL_COUNT, 0)
var gradeProfileBothFirst = array.new_int(GRADE_PROFILE_CELL_COUNT, 0)
var gradeProfileFav2Hit = array.new_int(GRADE_PROFILE_CELL_COUNT, 0)
var gradeProfileMFESum = array.new_float(GRADE_PROFILE_CELL_COUNT, 0.0)
var gradeProfileMAESum = array.new_float(GRADE_PROFILE_CELL_COUNT, 0.0)

var exactGradeProfileSignals = array.new_int(EXACT_GRADE_PROFILE_CELL_COUNT, 0)
var exactGradeProfileFavFirst = array.new_int(EXACT_GRADE_PROFILE_CELL_COUNT, 0)
var exactGradeProfileBothFirst = array.new_int(EXACT_GRADE_PROFILE_CELL_COUNT, 0)
var exactGradeProfileFav2Hit = array.new_int(EXACT_GRADE_PROFILE_CELL_COUNT, 0)
var exactGradeProfileMFESum = array.new_float(EXACT_GRADE_PROFILE_CELL_COUNT, 0.0)
var exactGradeProfileMAESum = array.new_float(EXACT_GRADE_PROFILE_CELL_COUNT, 0.0)

//=============================================================================
// PROFILE COMPONENT ANALYSIS AGGREGATES
//=============================================================================

var profileCompSignals = array.new_int(5, 0)
var profileCompFavFirst = array.new_int(5, 0)
var profileCompBothFirst = array.new_int(5, 0)
var profileCompFav2Hit = array.new_int(5, 0)
var profileCompMFESum = array.new_float(5, 0.0)
var profileCompMAESum = array.new_float(5, 0.0)

//=============================================================================
// UPDATE ACTIVE HISTORICAL SIGNALS
//=============================================================================

if enableHistoricalTracking and newConfirmationCandle
    int activeCount =
         array.size(activeDirection)

    if activeCount > 0
        for i = 0 to activeCount - 1

            int direction =
                 array.get(
                     activeDirection,
                     i)

            float reference =
                 array.get(
                     activeReference,
                     i)

            float oldMFE =
                 array.get(
                     activeMFE,
                     i)

            float oldMAE =
                 array.get(
                     activeMAE,
                     i)

            bool oldFav1 =
                 array.get(
                     activeHitFav1,
                     i)

            bool oldFav2 =
                 array.get(
                     activeHitFav2,
                     i)

            bool oldAdverse =
                 array.get(
                     activeHitAdverse,
                     i)

            int firstOutcome =
                 array.get(
                     activeFirstOutcome,
                     i)

            float currentMFE = oldMFE
            float currentMAE = oldMAE

            bool hitFav1Now = false
            bool hitFav2Now = false
            bool hitAdverseNow = false

            if direction == 1

                float mfeCandidate =
                     (confHigh - reference) /
                     reference *
                     100.0

                float maeCandidate =
                     (confLow - reference) /
                     reference *
                     100.0

                currentMFE :=
                     math.max(
                         oldMFE,
                         mfeCandidate)

                currentMAE :=
                     math.min(
                         oldMAE,
                         maeCandidate)

                float fav1Price =
                     reference *
                     (1.0 +
                      favorableTarget1 /
                      100.0)

                float fav2Price =
                     reference *
                     (1.0 +
                      favorableTarget2 /
                      100.0)

                float adversePrice =
                     reference *
                     (1.0 -
                      adverseTarget /
                      100.0)

                hitFav1Now :=
                     confHigh >=
                     fav1Price

                hitFav2Now :=
                     confHigh >=
                     fav2Price

                hitAdverseNow :=
                     confLow <=
                     adversePrice

            else

                float mfeCandidate =
                     (reference - confLow) /
                     reference *
                     100.0

                float maeCandidate =
                     (reference - confHigh) /
                     reference *
                     100.0

                currentMFE :=
                     math.max(
                         oldMFE,
                         mfeCandidate)

                currentMAE :=
                     math.min(
                         oldMAE,
                         maeCandidate)

                float fav1Price =
                     reference *
                     (1.0 -
                      favorableTarget1 /
                      100.0)

                float fav2Price =
                     reference *
                     (1.0 -
                      favorableTarget2 /
                      100.0)

                float adversePrice =
                     reference *
                     (1.0 +
                      adverseTarget /
                      100.0)

                hitFav1Now :=
                     confLow <=
                     fav1Price

                hitFav2Now :=
                     confLow <=
                     fav2Price

                hitAdverseNow :=
                     confHigh >=
                     adversePrice

            bool newFav1 =
                 oldFav1 or
                 hitFav1Now

            bool newFav2 =
                 oldFav2 or
                 hitFav2Now

            bool newAdverse =
                 oldAdverse or
                 hitAdverseNow

            if firstOutcome == FIRST_NONE

                if hitFav1Now and
                   hitAdverseNow

                    firstOutcome :=
                         FIRST_BOTH

                else if hitFav1Now

                    firstOutcome :=
                         FIRST_FAVORABLE

                else if hitAdverseNow

                    firstOutcome :=
                         FIRST_ADVERSE

            array.set(
                 activeMFE,
                 i,
                 currentMFE)

            array.set(
                 activeMAE,
                 i,
                 currentMAE)

            array.set(
                 activeHitFav1,
                 i,
                 newFav1)

            array.set(
                 activeHitFav2,
                 i,
                 newFav2)

            array.set(
                 activeHitAdverse,
                 i,
                 newAdverse)

            array.set(
                 activeFirstOutcome,
                 i,
                 firstOutcome)

//=============================================================================
// STATE MACHINE
//=============================================================================

var int bullState = 0
var int bearState = 0

var int bullArmedTime = na
var int bearArmedTime = na

var int bullArmedBars = 0
var int bearArmedBars = 0

var float bullInitialPenATR = na
var float bearInitialPenATR = na

bool bullAlert = false
bool bearAlert = false

float bullPenScore = na
float bullBodyScore = na
float bullCloseScore = na
float bullRangeScore = na
float bullSpeedScore = na
float bullTotalScore = na

string bullGrade = ""

float bearPenScore = na
float bearBodyScore = na
float bearCloseScore = na
float bearRangeScore = na
float bearSpeedScore = na
float bearTotalScore = na

string bearGrade = ""

float selectedGradeThreshold =
     f_gradeThreshold(
         minimumGrade)

if newDay
    bullState := 0
    bearState := 0

    bullArmedTime := na
    bearArmedTime := na

    bullArmedBars := 0
    bearArmedBars := 0

    bullInitialPenATR := na
    bearInitialPenATR := na

//=============================================================================
// ARM -> CONFIRM -> SCORE -> ALERT
//=============================================================================

if newConfirmationCandle and
   levelsReady and
   not na(confClose) and
   not na(confATR)

    //-------------------------------------------------------------------------
    // BULLISH
    //-------------------------------------------------------------------------

    if bullState == 2
        if confClose <= bullishFinalLevel
            bullState := 0
            bullArmedTime := na
            bullArmedBars := 0
            bullInitialPenATR := na

    if bullState == 1
        if confClose < bullishFinalLevel
            bullState := 0
            bullArmedTime := na
            bullArmedBars := 0
            bullInitialPenATR := na

        else
            bullArmedBars += 1

            bool bullCoreFilters =
                 bullPenPass and
                 bullDirectionalPass and
                 bodyPass and
                 rangePass and
                 bullClosePosPass

            if bullCoreFilters
                bullPenScore :=
                     f_penetrationScore(
                         bullPenATR)

                bullBodyScore :=
                     f_bodyScore(
                         bodyRatio)

                bullCloseScore :=
                     f_closeScore(
                         bullClosePosition)

                bullRangeScore :=
                     f_rangeScore(
                         rangeATR)

                bullSpeedScore :=
                     f_speedScore(
                         bullArmedBars)

                bullTotalScore :=
                     bullPenScore +
                     bullBodyScore +
                     bullCloseScore +
                     bullRangeScore +
                     bullSpeedScore

                bullGrade :=
                     f_grade(
                         bullTotalScore)

                bool bullGradePass = true

                if requireMinGrade and
                   enableStrengthScore

                    bullGradePass :=
                         bullTotalScore >=
                         selectedGradeThreshold

                if bullGradePass
                    bullAlert := true
                    bullState := 2

    if bullState == 0
        if confClose > bullishFinalLevel
            bullState := 1
            bullArmedTime := confTime
            bullArmedBars := 0
            bullInitialPenATR := bullPenATR

            bool bullInitialCoreFilters =
                 bullPenPass and
                 bullDirectionalPass and
                 bodyPass and
                 rangePass and
                 bullClosePosPass

            if bullInitialCoreFilters
                bullPenScore :=
                     f_penetrationScore(
                         bullPenATR)

                bullBodyScore :=
                     f_bodyScore(
                         bodyRatio)

                bullCloseScore :=
                     f_closeScore(
                         bullClosePosition)

                bullRangeScore :=
                     f_rangeScore(
                         rangeATR)

                bullSpeedScore :=
                     f_speedScore(0)

                bullTotalScore :=
                     bullPenScore +
                     bullBodyScore +
                     bullCloseScore +
                     bullRangeScore +
                     bullSpeedScore

                bullGrade :=
                     f_grade(
                         bullTotalScore)

                bool bullInitialGradePass = true

                if requireMinGrade and
                   enableStrengthScore

                    bullInitialGradePass :=
                         bullTotalScore >=
                         selectedGradeThreshold

                if bullInitialGradePass
                    bullAlert := true
                    bullState := 2

    //-------------------------------------------------------------------------
    // BEARISH
    //-------------------------------------------------------------------------

    if bearState == 2
        if confClose >= bearishFinalLevel
            bearState := 0
            bearArmedTime := na
            bearArmedBars := 0
            bearInitialPenATR := na

    if bearState == 1
        if confClose > bearishFinalLevel
            bearState := 0
            bearArmedTime := na
            bearArmedBars := 0
            bearInitialPenATR := na

        else
            bearArmedBars += 1

            bool bearCoreFilters =
                 bearPenPass and
                 bearDirectionalPass and
                 bodyPass and
                 rangePass and
                 bearClosePosPass

            if bearCoreFilters
                bearPenScore :=
                     f_penetrationScore(
                         bearPenATR)

                bearBodyScore :=
                     f_bodyScore(
                         bodyRatio)

                bearCloseScore :=
                     f_closeScore(
                         bearClosePosition)

                bearRangeScore :=
                     f_rangeScore(
                         rangeATR)

                bearSpeedScore :=
                     f_speedScore(
                         bearArmedBars)

                bearTotalScore :=
                     bearPenScore +
                     bearBodyScore +
                     bearCloseScore +
                     bearRangeScore +
                     bearSpeedScore

                bearGrade :=
                     f_grade(
                         bearTotalScore)

                bool bearGradePass = true

                if requireMinGrade and
                   enableStrengthScore

                    bearGradePass :=
                         bearTotalScore >=
                         selectedGradeThreshold

                if bearGradePass
                    bearAlert := true
                    bearState := 2

    if bearState == 0
        if confClose < bearishFinalLevel
            bearState := 1
            bearArmedTime := confTime
            bearArmedBars := 0
            bearInitialPenATR := bearPenATR

            bool bearInitialCoreFilters =
                 bearPenPass and
                 bearDirectionalPass and
                 bodyPass and
                 rangePass and
                 bearClosePosPass

            if bearInitialCoreFilters
                bearPenScore :=
                     f_penetrationScore(
                         bearPenATR)

                bearBodyScore :=
                     f_bodyScore(
                         bodyRatio)

                bearCloseScore :=
                     f_closeScore(
                         bearClosePosition)

                bearRangeScore :=
                     f_rangeScore(
                         rangeATR)

                bearSpeedScore :=
                     f_speedScore(0)

                bearTotalScore :=
                     bearPenScore +
                     bearBodyScore +
                     bearCloseScore +
                     bearRangeScore +
                     bearSpeedScore

                bearGrade :=
                     f_grade(
                         bearTotalScore)

                bool bearInitialGradePass = true

                if requireMinGrade and
                   enableStrengthScore

                    bearInitialGradePass :=
                         bearTotalScore >=
                         selectedGradeThreshold

                if bearInitialGradePass
                    bearAlert := true
                    bearState := 2

//=============================================================================
// V4 PRODUCTION CLASSIFICATION FOR THE CURRENT RAW SIGNAL
//=============================================================================

int bullV4Profile = PROFILE_UNCLASSIFIED
int bearV4Profile = PROFILE_UNCLASSIFIED
int bullGradeBucket = BUCKET_WEAK
int bearGradeBucket = BUCKET_WEAK
int bullPriority = PRIORITY_OBSERVE
int bearPriority = PRIORITY_OBSERVE
float bullTQS = na
float bearTQS = na
string bullConfidence = "INSUFFICIENT"
string bearConfidence = "INSUFFICIENT"
string bullTradeType = "OBSERVE"
string bearTradeType = "OBSERVE"

if bullAlert
    bullGradeBucket := f_gradeBucket(bullGrade)
    bullV4Profile :=
         f_v4CombinationProfile(
             bullPenATR,
             rangeATR,
             bodyRatio,
             bullClosePosition,
             bullArmedBars)
    bullPriority := f_priorityCode(bullGradeBucket, bullV4Profile)
    bullTQS := f_productionTQS(bullGradeBucket, bullV4Profile)
    bullConfidence := f_productionConfidence(bullGradeBucket, bullV4Profile)
    bullTradeType := f_tradeType(bullGradeBucket, bullV4Profile)

if bearAlert
    bearGradeBucket := f_gradeBucket(bearGrade)
    bearV4Profile :=
         f_v4CombinationProfile(
             bearPenATR,
             rangeATR,
             bodyRatio,
             bearClosePosition,
             bearArmedBars)
    bearPriority := f_priorityCode(bearGradeBucket, bearV4Profile)
    bearTQS := f_productionTQS(bearGradeBucket, bearV4Profile)
    bearConfidence := f_productionConfidence(bearGradeBucket, bearV4Profile)
    bearTradeType := f_tradeType(bearGradeBucket, bearV4Profile)

bool bullProductionAlert = bullAlert and f_priorityAlertPass(bullPriority)
bool bearProductionAlert = bearAlert and f_priorityAlertPass(bearPriority)

//=============================================================================
//=============================================================================
// 8H-7B-2K — TEMPORARY PINE V4 PARITY CLASSIFICATION CAPTURE + SYMBOL GUARD
//
// PURPOSE
//   Read-only evidence layer for one deterministic candidate symbol/date.
//   Uses the EXISTING frozen V4 state-machine/scoring variables.
//   Does not alter V4 signal qualification, thresholds, scoring, alerts,
//   historical research logic, or production classification.
//=============================================================================

//-----------------------------------------------------------------------------
// Inputs
//-----------------------------------------------------------------------------

string parityGroup = "7. 8H-7 Parity Classification Capture"

bool parityCaptureEnabled = input.bool(
     false,
     "Enable Parity Candidate Capture",
     tooltip = "Temporary 8H-7 reference-truth capture. Does not alter V4 signal logic.",
     group = parityGroup)

string parityCandidateId = input.string(
     "SET_1_01_EXAMPLE_2026-02-23",
     "Candidate ID",
     tooltip = "Copy the candidate_id from PMPD_V4_PINE_PARITY_CANDIDATES_V2.csv.",
     group = parityGroup)

int parityTargetDate = input.time(
     timestamp("23 Feb 2026 08:30 -0500"),
     "Candidate Trade Date",
     tooltip = "Set to the candidate trade date. The parity matcher compares New York year/month/day only.",
     group = parityGroup)

int parityDetailSignal = input.int(
     1,
     "Detail Signal #",
     minval = 1,
     maxval = 6,
     tooltip = "Select which captured signal is shown in the detail panel.",
     group = parityGroup)

//-----------------------------------------------------------------------------
// Candidate/chart symbol guardrail
//-----------------------------------------------------------------------------

array<string> parityIdParts = str.split(parityCandidateId, "_")

string parityExpectedSymbol = ""

if array.size(parityIdParts) >= 5
    parityExpectedSymbol := array.get(parityIdParts, 3)

bool parityCandidateIdValid =
     str.length(parityExpectedSymbol) > 0

bool paritySymbolMatches =
     parityCandidateIdValid and
     parityExpectedSymbol == syminfo.ticker

bool parityCaptureAllowed =
     parityCaptureEnabled and
     paritySymbolMatches

// Frozen parity benchmark.
float PARITY_FAV_PCT = 0.50
float PARITY_ADV_PCT = 0.50

//-----------------------------------------------------------------------------
// Helpers
//-----------------------------------------------------------------------------

f_paritySameNyDate(int ts, int target) =>
    not na(ts) and year(ts, tz) == year(target, tz) and month(ts, tz) == month(target, tz) and dayofmonth(ts, tz) == dayofmonth(target, tz)

f_parityTimeText(int ts) =>
    string result = "-"
    if not na(ts)
        result := str.format_time(ts, "yyyy-MM-dd HH:mm", tz)
    result

f_parityOutcomeName(int outcome) =>
    string result = "NEITHER"
    if outcome == FIRST_FAVORABLE
        result := "FAVORABLE_FIRST"
    else if outcome == FIRST_ADVERSE
        result := "ADVERSE_FIRST"
    else if outcome == FIRST_BOTH
        result := "BOTH"
    result

f_parityBool(bool value) =>
    value ? "PASS" : "FAIL"

f_parityNum(float value) =>
    na(value) ? "-" : str.tostring(value, "#.####")

//-----------------------------------------------------------------------------
// Candidate-date common level storage
//-----------------------------------------------------------------------------

var bool parityDateSeen = false
var float parityDatePMH = na
var float parityDatePML = na
var float parityDatePDH = na
var float parityDatePDL = na

if parityCaptureAllowed and
   newConfirmationCandle and
   f_paritySameNyDate(confTimeClose, parityTargetDate)

    parityDateSeen := true
    parityDatePMH := pmh
    parityDatePML := pml
    parityDatePDH := pdh
    parityDatePDL := pdl

//-----------------------------------------------------------------------------
// Signal arrays — every frozen V4 alert on the selected candidate date
//-----------------------------------------------------------------------------

var array<int> parityDirection = array.new_int()
var array<int> paritySignalTime = array.new_int()
var array<float> parityReference = array.new_float()
var array<float> parityPMH = array.new_float()
var array<float> parityPML = array.new_float()
var array<float> parityPDH = array.new_float()
var array<float> parityPDL = array.new_float()
var array<float> parityFinalLevel = array.new_float()

var array<float> parityATR = array.new_float()
var array<float> parityPen = array.new_float()
var array<float> parityBody = array.new_float()
var array<float> parityRangeATR = array.new_float()
var array<float> parityClosePos = array.new_float()
var array<int> parityBarsToConfirm = array.new_int()

var array<float> parityTotalScore = array.new_float()
var array<string> parityGrade = array.new_string()
var array<int> parityProfile = array.new_int()

var array<float> parityPenScore = array.new_float()
var array<float> parityBodyScore = array.new_float()
var array<float> parityCloseScore = array.new_float()
var array<float> parityRangeScore = array.new_float()
var array<float> paritySpeedScore = array.new_float()

var array<bool> parityDirectionalPass = array.new_bool()
var array<bool> parityPenPass = array.new_bool()
var array<bool> parityBodyPass = array.new_bool()
var array<bool> parityRangePass = array.new_bool()
var array<bool> parityClosePass = array.new_bool()

var array<float> parityMFE = array.new_float()
var array<float> parityMAE = array.new_float()
var array<int> parityFirstOutcome = array.new_int()

//-----------------------------------------------------------------------------
// Update outcomes for already-captured signals.
// Signal candle is excluded because this runs before new signal capture.
//-----------------------------------------------------------------------------

if parityCaptureAllowed and newConfirmationCandle
    int parityActiveCount = array.size(parityDirection)

    if parityActiveCount > 0
        for i = 0 to parityActiveCount - 1
            int signalTime = array.get(paritySignalTime, i)

            bool laterBar =
                 not na(confTimeClose) and
                 confTimeClose > signalTime

            bool sameTargetSession =
                 f_paritySameNyDate(confTimeClose, parityTargetDate)

            if laterBar and sameTargetSession
                int direction = array.get(parityDirection, i)
                float reference = array.get(parityReference, i)

                float oldMFE = array.get(parityMFE, i)
                float oldMAE = array.get(parityMAE, i)
                int oldOutcome = array.get(parityFirstOutcome, i)

                float mfeCandidate = 0.0
                float maeCandidate = 0.0
                bool hitFavNow = false
                bool hitAdvNow = false

                if direction == 1
                    mfeCandidate :=
                         (confHigh - reference) /
                         reference *
                         100.0

                    maeCandidate :=
                         (confLow - reference) /
                         reference *
                         100.0

                    float favPrice =
                         reference *
                         (1.0 + PARITY_FAV_PCT / 100.0)

                    float advPrice =
                         reference *
                         (1.0 - PARITY_ADV_PCT / 100.0)

                    hitFavNow := confHigh >= favPrice
                    hitAdvNow := confLow <= advPrice

                else
                    mfeCandidate :=
                         (reference - confLow) /
                         reference *
                         100.0

                    maeCandidate :=
                         (reference - confHigh) /
                         reference *
                         100.0

                    float favPrice =
                         reference *
                         (1.0 - PARITY_FAV_PCT / 100.0)

                    float advPrice =
                         reference *
                         (1.0 + PARITY_ADV_PCT / 100.0)

                    hitFavNow := confLow <= favPrice
                    hitAdvNow := confHigh >= advPrice

                float newMFE = math.max(oldMFE, mfeCandidate)
                float newMAE = math.min(oldMAE, maeCandidate)
                int newOutcome = oldOutcome

                if oldOutcome == FIRST_NONE
                    if hitFavNow and hitAdvNow
                        newOutcome := FIRST_BOTH
                    else if hitFavNow
                        newOutcome := FIRST_FAVORABLE
                    else if hitAdvNow
                        newOutcome := FIRST_ADVERSE

                array.set(parityMFE, i, newMFE)
                array.set(parityMAE, i, newMAE)
                array.set(parityFirstOutcome, i, newOutcome)

//-----------------------------------------------------------------------------
// Capture frozen V4 bullish alerts on target date.
//-----------------------------------------------------------------------------

if parityCaptureAllowed and
   bullAlert and
   f_paritySameNyDate(confTimeClose, parityTargetDate)

    int parityBullProfile =
         f_v4CombinationProfile(
             bullPenATR,
             rangeATR,
             bodyRatio,
             bullClosePosition,
             bullArmedBars)

    array.push(parityDirection, 1)
    array.push(paritySignalTime, confTimeClose)
    array.push(parityReference, confClose)

    array.push(parityPMH, pmh)
    array.push(parityPML, pml)
    array.push(parityPDH, pdh)
    array.push(parityPDL, pdl)
    array.push(parityFinalLevel, bullishFinalLevel)

    array.push(parityATR, confATR)
    array.push(parityPen, bullPenATR)
    array.push(parityBody, bodyRatio)
    array.push(parityRangeATR, rangeATR)
    array.push(parityClosePos, bullClosePosition)
    array.push(parityBarsToConfirm, bullArmedBars)

    array.push(parityTotalScore, bullTotalScore)
    array.push(parityGrade, bullGrade)
    array.push(parityProfile, parityBullProfile)

    array.push(parityPenScore, bullPenScore)
    array.push(parityBodyScore, bullBodyScore)
    array.push(parityCloseScore, bullCloseScore)
    array.push(parityRangeScore, bullRangeScore)
    array.push(paritySpeedScore, bullSpeedScore)

    array.push(parityDirectionalPass, bullDirectionalPass)
    array.push(parityPenPass, bullPenPass)
    array.push(parityBodyPass, bodyPass)
    array.push(parityRangePass, rangePass)
    array.push(parityClosePass, bullClosePosPass)

    array.push(parityMFE, 0.0)
    array.push(parityMAE, 0.0)
    array.push(parityFirstOutcome, FIRST_NONE)

//-----------------------------------------------------------------------------
// Capture frozen V4 bearish alerts on target date.
//-----------------------------------------------------------------------------

if parityCaptureAllowed and
   bearAlert and
   f_paritySameNyDate(confTimeClose, parityTargetDate)

    int parityBearProfile =
         f_v4CombinationProfile(
             bearPenATR,
             rangeATR,
             bodyRatio,
             bearClosePosition,
             bearArmedBars)

    array.push(parityDirection, -1)
    array.push(paritySignalTime, confTimeClose)
    array.push(parityReference, confClose)

    array.push(parityPMH, pmh)
    array.push(parityPML, pml)
    array.push(parityPDH, pdh)
    array.push(parityPDL, pdl)
    array.push(parityFinalLevel, bearishFinalLevel)

    array.push(parityATR, confATR)
    array.push(parityPen, bearPenATR)
    array.push(parityBody, bodyRatio)
    array.push(parityRangeATR, rangeATR)
    array.push(parityClosePos, bearClosePosition)
    array.push(parityBarsToConfirm, bearArmedBars)

    array.push(parityTotalScore, bearTotalScore)
    array.push(parityGrade, bearGrade)
    array.push(parityProfile, parityBearProfile)

    array.push(parityPenScore, bearPenScore)
    array.push(parityBodyScore, bearBodyScore)
    array.push(parityCloseScore, bearCloseScore)
    array.push(parityRangeScore, bearRangeScore)
    array.push(paritySpeedScore, bearSpeedScore)

    array.push(parityDirectionalPass, bearDirectionalPass)
    array.push(parityPenPass, bearPenPass)
    array.push(parityBodyPass, bodyPass)
    array.push(parityRangePass, rangePass)
    array.push(parityClosePass, bearClosePosPass)

    array.push(parityMFE, 0.0)
    array.push(parityMAE, 0.0)
    array.push(parityFirstOutcome, FIRST_NONE)

//-----------------------------------------------------------------------------
// Summary / detail tables
//-----------------------------------------------------------------------------

var table paritySummaryTable =
     table.new(
         position.bottom_left,
         8,
         8,
         border_width = 1)

var table parityDetailTable =
     table.new(
         position.bottom_right,
         3,
         21,
         border_width = 1)

if barstate.islast
    if parityCaptureEnabled
        color parityHeader = color.new(color.blue, 35)
        color parityBodyColor = color.new(color.black, 15)

        table.clear(paritySummaryTable, 0, 0, 7, 7)
        table.clear(parityDetailTable, 0, 0, 2, 20)

        int signalCount = array.size(parityDirection)

        table.cell(paritySummaryTable, 0, 0, "8H-7 PINE REFERENCE", text_color = color.white, bgcolor = parityHeader)
        table.cell(paritySummaryTable, 1, 0, parityCandidateId, text_color = color.white, bgcolor = parityHeader)
        table.cell(paritySummaryTable, 2, 0, syminfo.ticker, text_color = color.white, bgcolor = parityHeader)
        table.cell(paritySummaryTable, 3, 0, str.format_time(parityTargetDate, "yyyy-MM-dd", tz), text_color = color.white, bgcolor = parityHeader)

        string paritySummaryStatus = ""

        if not parityCandidateIdValid
            paritySummaryStatus := "INVALID ID"
        else if not paritySymbolMatches
            paritySummaryStatus := "SYMBOL MISMATCH"
        else if not parityDateSeen
            paritySummaryStatus := "DATE_NOT_LOADED"
        else if signalCount == 0
            paritySummaryStatus := "NO_SIGNAL"
        else
            paritySummaryStatus := str.tostring(signalCount) + " SIGNAL(S)"

        table.cell(paritySummaryTable, 4, 0, paritySummaryStatus, text_color = color.white, bgcolor = parityHeader)
        table.cell(paritySummaryTable, 5, 0, "PMPD V4", text_color = color.white, bgcolor = parityHeader)
        table.cell(paritySummaryTable, 6, 0, "5m", text_color = color.white, bgcolor = parityHeader)
        table.cell(paritySummaryTable, 7, 0, parityDateSeen ? "DATE_LOADED" : "DATE_NOT_LOADED", text_color = color.white, bgcolor = parityHeader)

        table.cell(paritySummaryTable, 0, 1, "PMH", text_color = color.silver, bgcolor = parityBodyColor)
        table.cell(paritySummaryTable, 1, 1, f_parityNum(parityDatePMH), text_color = color.white, bgcolor = parityBodyColor)
        table.cell(paritySummaryTable, 2, 1, "PDH", text_color = color.silver, bgcolor = parityBodyColor)
        table.cell(paritySummaryTable, 3, 1, f_parityNum(parityDatePDH), text_color = color.white, bgcolor = parityBodyColor)
        table.cell(paritySummaryTable, 4, 1, "PML", text_color = color.silver, bgcolor = parityBodyColor)
        table.cell(paritySummaryTable, 5, 1, f_parityNum(parityDatePML), text_color = color.white, bgcolor = parityBodyColor)
        table.cell(paritySummaryTable, 6, 1, "PDL", text_color = color.silver, bgcolor = parityBodyColor)
        table.cell(paritySummaryTable, 7, 1, f_parityNum(parityDatePDL), text_color = color.white, bgcolor = parityBodyColor)

        string[] parityHeaders = array.from("#", "Dir", "Signal ET", "Reference", "Grade", "V4 Profile", "0.5 First", "MFE / MAE")

        for c = 0 to 7
            table.cell(paritySummaryTable, c, 2, array.get(parityHeaders, c), text_color = color.silver, bgcolor = parityBodyColor)

        int rowsToShow = math.min(signalCount, 5)

        if rowsToShow > 0
            for i = 0 to rowsToShow - 1
                int row = i + 3
                int direction = array.get(parityDirection, i)
                int outcome = array.get(parityFirstOutcome, i)

                table.cell(paritySummaryTable, 0, row, str.tostring(i + 1), text_color = color.white, bgcolor = parityBodyColor)
                table.cell(paritySummaryTable, 1, row, direction == 1 ? "BULL" : "BEAR", text_color = color.white, bgcolor = parityBodyColor)
                table.cell(paritySummaryTable, 2, row, f_parityTimeText(array.get(paritySignalTime, i)), text_color = color.white, bgcolor = parityBodyColor)
                table.cell(paritySummaryTable, 3, row, f_parityNum(array.get(parityReference, i)), text_color = color.white, bgcolor = parityBodyColor)
                table.cell(paritySummaryTable, 4, row, array.get(parityGrade, i), text_color = color.white, bgcolor = parityBodyColor)
                table.cell(paritySummaryTable, 5, row, f_profileName(array.get(parityProfile, i)), text_color = color.white, bgcolor = parityBodyColor)
                table.cell(paritySummaryTable, 6, row, f_parityOutcomeName(outcome), text_color = color.white, bgcolor = parityBodyColor)
                table.cell(
                     paritySummaryTable,
                     7,
                     row,
                     str.tostring(array.get(parityMFE, i), "#.###") + "% / " +
                     str.tostring(array.get(parityMAE, i), "#.###") + "%",
                     text_color = color.white,
                     bgcolor = parityBodyColor)

        table.cell(parityDetailTable, 0, 0, "8H-7 SIGNAL DETAIL", text_color = color.white, bgcolor = parityHeader)

        int detailIndex = parityDetailSignal - 1

        if paritySymbolMatches and detailIndex >= 0 and detailIndex < signalCount
            int direction = array.get(parityDirection, detailIndex)

            table.cell(parityDetailTable, 1, 0, "#" + str.tostring(parityDetailSignal), text_color = color.white, bgcolor = parityHeader)
            table.cell(parityDetailTable, 2, 0, direction == 1 ? "BULL" : "BEAR", text_color = color.white, bgcolor = parityHeader)

            string[] parityNames = array.from(
                 "Signal ET",
                 "Reference",
                 "Final Level",
                 "ATR",
                 "Pen %ATR",
                 "Body %",
                 "Range %ATR",
                 "Close Pos %",
                 "Bars Confirm",
                 "Total Score",
                 "Grade",
                 "V4 Profile",
                 "Pen Score",
                 "Body Score",
                 "Close Score",
                 "Range Score",
                 "Speed Score",
                 "Core Filters",
                 "Outcome",
                 "MFE / MAE")

            string parityFilterText =
                 "Dir " + f_parityBool(array.get(parityDirectionalPass, detailIndex)) +
                 " | Pen " + f_parityBool(array.get(parityPenPass, detailIndex)) +
                 " | Body " + f_parityBool(array.get(parityBodyPass, detailIndex)) +
                 " | Range " + f_parityBool(array.get(parityRangePass, detailIndex)) +
                 " | Close " + f_parityBool(array.get(parityClosePass, detailIndex))

            string[] parityValues = array.from(
                 f_parityTimeText(array.get(paritySignalTime, detailIndex)),
                 f_parityNum(array.get(parityReference, detailIndex)),
                 f_parityNum(array.get(parityFinalLevel, detailIndex)),
                 f_parityNum(array.get(parityATR, detailIndex)),
                 f_parityNum(array.get(parityPen, detailIndex)),
                 f_parityNum(array.get(parityBody, detailIndex)),
                 f_parityNum(array.get(parityRangeATR, detailIndex)),
                 f_parityNum(array.get(parityClosePos, detailIndex)),
                 str.tostring(array.get(parityBarsToConfirm, detailIndex)),
                 f_parityNum(array.get(parityTotalScore, detailIndex)),
                 array.get(parityGrade, detailIndex),
                 f_profileName(array.get(parityProfile, detailIndex)),
                 f_parityNum(array.get(parityPenScore, detailIndex)),
                 f_parityNum(array.get(parityBodyScore, detailIndex)),
                 f_parityNum(array.get(parityCloseScore, detailIndex)),
                 f_parityNum(array.get(parityRangeScore, detailIndex)),
                 f_parityNum(array.get(paritySpeedScore, detailIndex)),
                 parityFilterText,
                 f_parityOutcomeName(array.get(parityFirstOutcome, detailIndex)),
                 str.tostring(array.get(parityMFE, detailIndex), "#.###") + "% / " +
                 str.tostring(array.get(parityMAE, detailIndex), "#.###") + "%")

            for r = 0 to 19
                table.cell(parityDetailTable, 0, r + 1, array.get(parityNames, r), text_color = color.silver, bgcolor = parityBodyColor)
                table.cell(parityDetailTable, 1, r + 1, array.get(parityValues, r), text_color = color.white, bgcolor = parityBodyColor)
                table.cell(parityDetailTable, 2, r + 1, "", bgcolor = parityBodyColor)

        else
            string parityStatusText = ""
            color parityStatusColor = color.white

            if not parityCandidateIdValid
                parityStatusText := "INVALID CANDIDATE ID"
                parityStatusColor := color.red

            else if not paritySymbolMatches
                parityStatusText :=
                     "SYMBOL MISMATCH - EXPECTED " +
                     parityExpectedSymbol +
                     " / CHART " +
                     syminfo.ticker

                parityStatusColor := color.red

            else if not parityDateSeen
                parityStatusText := "TARGET DATE NOT LOADED"
                parityStatusColor := color.orange

            else if signalCount == 0
                parityStatusText := "NO SIGNAL ON TARGET DATE"
                parityStatusColor := color.yellow

            else
                parityStatusText := "SELECT VALID SIGNAL #"
                parityStatusColor := color.white

            table.cell(
                 parityDetailTable,
                 0,
                 1,
                 parityStatusText,
                 text_color = parityStatusColor,
                 bgcolor = parityBodyColor)

    else
        table.clear(paritySummaryTable, 0, 0, 7, 7)
        table.clear(parityDetailTable, 0, 0, 2, 20)

//=============================================================================
// END 8H-7B-2K PARITY CLASSIFICATION CAPTURE + SYMBOL GUARD
//=============================================================================


//=============================================================================
// 9N-3F3 COMPACT MACHINE-READABLE CSV PARITY EXPORT
//=============================================================================
// READ-ONLY RESEARCH COPY.
// Frozen source retained through existing parity capture.
// Downstream analytics/display omitted only to stay below compiler limits.
//=============================================================================

f_9n3f3GradeCode(string g) =>
    int result = 0
    if g == "C-"
        result := 1
    else if g == "C"
        result := 2
    else if g == "C+"
        result := 3
    else if g == "B-"
        result := 4
    else if g == "B"
        result := 5
    else if g == "B+"
        result := 6
    else if g == "A-"
        result := 7
    else if g == "A"
        result := 8
    else if g == "A+"
        result := 9
    result

f_9n3f3TradeTypeCode(string value) =>
    value == "SCALP" ? 1 : value == "EXPANSION" ? 2 : 0

f_9n3f3ConfidenceCode(string value) =>
    value == "LOW" ? 1 :
     value == "MODERATE" ? 2 :
     value == "MOD-HIGH" ? 3 :
     value == "HIGH" ? 4 : 0

int n3f3SignalCount = array.size(parityDirection)
int n3f3DetailIndex = parityDetailSignal - 1
bool n3f3HasSignal = parityCaptureAllowed and n3f3DetailIndex >= 0 and n3f3DetailIndex < n3f3SignalCount

int n3f3GradeBucket = n3f3HasSignal ? f_gradeBucket(array.get(parityGrade, n3f3DetailIndex)) : BUCKET_WEAK
int n3f3Profile = n3f3HasSignal ? array.get(parityProfile, n3f3DetailIndex) : PROFILE_UNCLASSIFIED
int n3f3Priority = n3f3HasSignal ? f_priorityCode(n3f3GradeBucket, n3f3Profile) : PRIORITY_OBSERVE
string n3f3TradeType = n3f3HasSignal ? f_tradeType(n3f3GradeBucket, n3f3Profile) : "OBSERVE"
float n3f3TQS = n3f3HasSignal ? f_productionTQS(n3f3GradeBucket, n3f3Profile) : na
string n3f3Confidence = n3f3HasSignal ? f_productionConfidence(n3f3GradeBucket, n3f3Profile) : "INSUFFICIENT"

plot(parityCaptureAllowed ? (parityDateSeen ? 1.0 : 0.0) : na, "PMPD_PARITY_DATE_SEEN", display = display.data_window)
plot(parityCaptureAllowed ? float(n3f3SignalCount) : na, "PMPD_PARITY_SIGNAL_COUNT", display = display.data_window)
plot(n3f3HasSignal ? float(array.get(parityDirection, n3f3DetailIndex)) : na, "PMPD_PARITY_DIRECTION", display = display.data_window)
plot(n3f3HasSignal ? float(array.get(paritySignalTime, n3f3DetailIndex)) : na, "PMPD_PARITY_SIGNAL_TIME_MS", display = display.data_window)
plot(n3f3HasSignal ? array.get(parityReference, n3f3DetailIndex) : na, "PMPD_PARITY_REFERENCE", display = display.data_window)

plot(parityCaptureAllowed ? parityDatePMH : na, "PMPD_PARITY_DATE_PMH", display = display.data_window)
plot(parityCaptureAllowed ? parityDatePML : na, "PMPD_PARITY_DATE_PML", display = display.data_window)
plot(parityCaptureAllowed ? parityDatePDH : na, "PMPD_PARITY_DATE_PDH", display = display.data_window)
plot(parityCaptureAllowed ? parityDatePDL : na, "PMPD_PARITY_DATE_PDL", display = display.data_window)

plot(n3f3HasSignal ? array.get(parityFinalLevel, n3f3DetailIndex) : na, "PMPD_PARITY_FINAL_LEVEL", display = display.data_window)
plot(n3f3HasSignal ? array.get(parityATR, n3f3DetailIndex) : na, "PMPD_PARITY_ATR", display = display.data_window)
plot(n3f3HasSignal ? array.get(parityPen, n3f3DetailIndex) : na, "PMPD_PARITY_PEN_PCT_ATR", display = display.data_window)
plot(n3f3HasSignal ? array.get(parityBody, n3f3DetailIndex) : na, "PMPD_PARITY_BODY_PCT", display = display.data_window)
plot(n3f3HasSignal ? array.get(parityRangeATR, n3f3DetailIndex) : na, "PMPD_PARITY_RANGE_PCT_ATR", display = display.data_window)
plot(n3f3HasSignal ? array.get(parityClosePos, n3f3DetailIndex) : na, "PMPD_PARITY_CLOSE_POS_PCT", display = display.data_window)
plot(n3f3HasSignal ? float(array.get(parityBarsToConfirm, n3f3DetailIndex)) : na, "PMPD_PARITY_BARS_TO_CONFIRM", display = display.data_window)

plot(n3f3HasSignal ? array.get(parityTotalScore, n3f3DetailIndex) : na, "PMPD_PARITY_TOTAL_SCORE", display = display.data_window)
plot(n3f3HasSignal ? float(f_9n3f3GradeCode(array.get(parityGrade, n3f3DetailIndex))) : na, "PMPD_PARITY_GRADE_CODE", display = display.data_window)
plot(n3f3HasSignal ? float(n3f3Profile) : na, "PMPD_PARITY_PROFILE_CODE", display = display.data_window)
plot(n3f3HasSignal ? float(n3f3Priority) : na, "PMPD_PARITY_PRIORITY_CODE", display = display.data_window)
plot(n3f3HasSignal ? float(f_9n3f3TradeTypeCode(n3f3TradeType)) : na, "PMPD_PARITY_TRADE_TYPE_CODE", display = display.data_window)
plot(n3f3HasSignal ? n3f3TQS : na, "PMPD_PARITY_TQS", display = display.data_window)
plot(n3f3HasSignal ? float(f_9n3f3ConfidenceCode(n3f3Confidence)) : na, "PMPD_PARITY_CONFIDENCE_CODE", display = display.data_window)

plot(n3f3HasSignal ? (n3f3Priority >= PRIORITY_CONDITIONAL ? 1.0 : 0.0) : na, "PMPD_PARITY_DEFAULT_CONDITIONAL_PLUS_ELIGIBLE", display = display.data_window)

plot(n3f3HasSignal ? array.get(parityPenScore, n3f3DetailIndex) : na, "PMPD_PARITY_PEN_SCORE", display = display.data_window)
plot(n3f3HasSignal ? array.get(parityBodyScore, n3f3DetailIndex) : na, "PMPD_PARITY_BODY_SCORE", display = display.data_window)
plot(n3f3HasSignal ? array.get(parityCloseScore, n3f3DetailIndex) : na, "PMPD_PARITY_CLOSE_SCORE", display = display.data_window)
plot(n3f3HasSignal ? array.get(parityRangeScore, n3f3DetailIndex) : na, "PMPD_PARITY_RANGE_SCORE", display = display.data_window)
plot(n3f3HasSignal ? array.get(paritySpeedScore, n3f3DetailIndex) : na, "PMPD_PARITY_SPEED_SCORE", display = display.data_window)

plot(n3f3HasSignal ? float(array.get(parityFirstOutcome, n3f3DetailIndex)) : na, "PMPD_PARITY_FIRST_OUTCOME_CODE", display = display.data_window)
plot(n3f3HasSignal ? array.get(parityMFE, n3f3DetailIndex) : na, "PMPD_PARITY_MFE_PCT", display = display.data_window)
plot(n3f3HasSignal ? array.get(parityMAE, n3f3DetailIndex) : na, "PMPD_PARITY_MAE_PCT", display = display.data_window)

