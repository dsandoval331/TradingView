//=============================================================================
// PHASE 4A-5: V3 vs PROPOSED V4 VALIDATION TABLES
//=============================================================================

f_validationCell(
     int n,
     int fav,
     int both,
     int hit,
     float mfeSum,
     float maeSum) =>

    string result = "-"

    if n > 0
        string firstText = str.tostring(fav / float(n) * 100.0, "#.0") + "%"
        if both > 0
            firstText := firstText + "*"

        result :=
             "N " + str.tostring(n) +
             " | F " + firstText +
             " | H " + str.tostring(hit / float(n) * 100.0, "#.0") + "%" +
             "\nM " + f_signedPct(mfeSum / n) +
             " | A " + f_signedPct(maeSum / n)

    result

f_v4ProfileCell(int profile) =>
    f_validationCell(
         array.get(v4ProfileSignals, profile),
         array.get(v4ProfileFavFirst, profile),
         array.get(v4ProfileBothFirst, profile),
         array.get(v4ProfileFav2Hit, profile),
         array.get(v4ProfileMFESum, profile),
         array.get(v4ProfileMAESum, profile))

f_rescuedCell(int profile) =>
    f_validationCell(
         array.get(rescuedSignals, profile),
         array.get(rescuedFavFirst, profile),
         array.get(rescuedBothFirst, profile),
         array.get(rescuedFav2Hit, profile),
         array.get(rescuedMFESum, profile),
         array.get(rescuedMAESum, profile))

f_shortProfileName(int profile) =>
    profile == PROFILE_EXPLOSIVE ? "Explosive" :
     profile == PROFILE_CONTROLLED ? "Controlled" :
     profile == PROFILE_EFFICIENT ? "Efficient" :
     profile == PROFILE_DELAYED ? "Delayed" :
     profile == PROFILE_PRETTY_WEAK ? "Pretty Weak" :
     "Unclassified"

var table v4SummaryTable =
     table.new(
         position.bottom_left,
         4,
         9,
         border_width = 1)

var table migrationTable =
     table.new(
         position.bottom_center,
         7,
         8,
         border_width = 1)

if barstate.islast
    if enableHistoricalTracking and showV4Validation
        color h = color.new(color.gray, 35)
        color b = color.new(color.black, 15)

        table.clear(v4SummaryTable, 0, 0, 3, 8)
        table.cell(v4SummaryTable, 0, 0, "PROPOSED V4 VALIDATION", text_color = color.white, bgcolor = h, text_size = size.small)
        table.cell(v4SummaryTable, 1, 0, "V4 ALL", text_color = color.white, bgcolor = h, text_size = size.small)
        table.cell(v4SummaryTable, 2, 0, "RESCUED FROM V3 U", text_color = color.white, bgcolor = h, text_size = size.small)
        table.cell(v4SummaryTable, 3, 0, "V3 N -> V4 N", text_color = color.white, bgcolor = h, text_size = size.small)

        for p = 0 to PROFILE_COUNT - 1
            int row = p + 1
            int v3n = array.get(profileSignals, p)
            int v4n = array.get(v4ProfileSignals, p)

            table.cell(v4SummaryTable, 0, row, f_profileName(p), text_color = color.white, bgcolor = b, text_size = size.tiny)
            table.cell(v4SummaryTable, 1, row, f_v4ProfileCell(p), text_color = color.white, bgcolor = b, text_size = size.tiny)
            table.cell(v4SummaryTable, 2, row, p == PROFILE_UNCLASSIFIED ? "-" : f_rescuedCell(p), text_color = color.white, bgcolor = b, text_size = size.tiny)
            table.cell(v4SummaryTable, 3, row, str.tostring(v3n) + " -> " + str.tostring(v4n), text_color = color.white, bgcolor = b, text_size = size.tiny)

        int v3Un = array.get(profileSignals, PROFILE_UNCLASSIFIED)
        int v4Un = array.get(v4ProfileSignals, PROFILE_UNCLASSIFIED)
        int totalV4 = 0
        for p = 0 to PROFILE_COUNT - 1
            totalV4 += array.get(v4ProfileSignals, p)

        string reduction = "-"
        if v3Un > 0
            reduction := str.tostring((v3Un - v4Un) / float(v3Un) * 100.0, "#.0") + "%"

        string v4Coverage = "-"
        if totalV4 > 0
            v4Coverage := str.tostring((totalV4 - v4Un) / float(totalV4) * 100.0, "#.0") + "%"

        table.cell(v4SummaryTable, 0, 7, "Unclassified reduction", text_color = color.silver, bgcolor = b, text_size = size.tiny)
        table.cell(v4SummaryTable, 1, 7, reduction, text_color = color.white, bgcolor = b, text_size = size.tiny)
        table.cell(v4SummaryTable, 2, 7, "V4 coverage", text_color = color.silver, bgcolor = b, text_size = size.tiny)
        table.cell(v4SummaryTable, 3, 7, v4Coverage, text_color = color.white, bgcolor = b, text_size = size.tiny)

        table.cell(v4SummaryTable, 0, 8, "F=.5 First | H=1% Hit", text_color = color.silver, bgcolor = b, text_size = size.tiny)
        table.cell(v4SummaryTable, 1, 8, "M=MFE | A=MAE", text_color = color.silver, bgcolor = b, text_size = size.tiny)
        table.cell(v4SummaryTable, 2, 8, "*=both same candle", text_color = color.silver, bgcolor = b, text_size = size.tiny)
        table.cell(v4SummaryTable, 3, 8, "", bgcolor = b)

        table.clear(migrationTable, 0, 0, 6, 7)
        table.cell(migrationTable, 0, 0, "V3 -> V4 MIGRATION", text_color = color.white, bgcolor = h, text_size = size.small)

        for c = 0 to PROFILE_COUNT - 1
            table.cell(migrationTable, c + 1, 0, f_shortProfileName(c), text_color = color.white, bgcolor = h, text_size = size.tiny)

        for r = 0 to PROFILE_COUNT - 1
            table.cell(migrationTable, 0, r + 1, f_shortProfileName(r), text_color = color.white, bgcolor = b, text_size = size.tiny)

            for c = 0 to PROFILE_COUNT - 1
                int idx = r * PROFILE_COUNT + c
                table.cell(migrationTable, c + 1, r + 1, str.tostring(array.get(v3ToV4Migration, idx)), text_color = color.white, bgcolor = b, text_size = size.tiny)

        table.cell(migrationTable, 0, 7, "Rows=current V3", text_color = color.silver, bgcolor = b, text_size = size.tiny)
        table.cell(migrationTable, 1, 7, "Cols=proposed V4", text_color = color.silver, bgcolor = b, text_size = size.tiny)
        table.cell(migrationTable, 2, 7, "Focus: V3 Unclassified row", text_color = color.silver, bgcolor = b, text_size = size.tiny)
        for c = 3 to 6
            table.cell(migrationTable, c, 7, "", bgcolor = b)

    else
        table.clear(v4SummaryTable, 0, 0, 3, 8)
        table.clear(migrationTable, 0, 0, 6, 7)

//=============================================================================
// V4 FORWARD VALIDATION PANEL
//=============================================================================

f_forwardCellText(int priority) =>
    int n = array.get(forwardSignals, priority)
    string result = "-"

    if n > 0
        int fav = array.get(forwardFavFirst, priority)
        int both = array.get(forwardBothFirst, priority)
        int hit = array.get(forwardFav2Hit, priority)
        float mfe = array.get(forwardMFESum, priority) / n
        float mae = array.get(forwardMAESum, priority) / n

        string firstText = str.tostring(fav / float(n) * 100.0, "#.0") + "%"
        if both > 0
            firstText := firstText + "*"

        result :=
             "N " + str.tostring(n) +
             " | F " + firstText +
             " | H " + str.tostring(hit / float(n) * 100.0, "#.0") + "%" +
             "\nM " + f_signedPct(mfe) +
             " | A " + f_signedPct(mae)

    result

var table forwardValidationTable =
     table.new(
         position.bottom_left,
         2,
         8,
         border_width = 1)

if barstate.islast
    if showForwardValidationPanel
        color forwardHeader = color.new(color.gray, 35)
        color forwardBody = color.new(color.black, 15)

        table.clear(forwardValidationTable, 0, 0, 1, 7)

        table.cell(forwardValidationTable, 0, 0, "V4 FORWARD VALIDATION", text_color = color.white, bgcolor = forwardHeader, text_size = size.small)
        table.cell(forwardValidationTable, 1, 0, str.format_time(forwardValidationStart, "yyyy-MM-dd", tz), text_color = color.white, bgcolor = forwardHeader, text_size = size.small)

        table.cell(forwardValidationTable, 0, 1, "PRIME", text_color = color.white, bgcolor = forwardBody, text_size = size.tiny)
        table.cell(forwardValidationTable, 1, 1, f_forwardCellText(PRIORITY_PRIME), text_color = color.white, bgcolor = forwardBody, text_size = size.tiny)

        table.cell(forwardValidationTable, 0, 2, "CONDITIONAL", text_color = color.white, bgcolor = forwardBody, text_size = size.tiny)
        table.cell(forwardValidationTable, 1, 2, f_forwardCellText(PRIORITY_CONDITIONAL), text_color = color.white, bgcolor = forwardBody, text_size = size.tiny)

        table.cell(forwardValidationTable, 0, 3, "RESEARCH", text_color = color.white, bgcolor = forwardBody, text_size = size.tiny)
        table.cell(forwardValidationTable, 1, 3, f_forwardCellText(PRIORITY_RESEARCH), text_color = color.white, bgcolor = forwardBody, text_size = size.tiny)

        table.cell(forwardValidationTable, 0, 4, "LOW", text_color = color.white, bgcolor = forwardBody, text_size = size.tiny)
        table.cell(forwardValidationTable, 1, 4, f_forwardCellText(PRIORITY_LOW), text_color = color.white, bgcolor = forwardBody, text_size = size.tiny)

        table.cell(forwardValidationTable, 0, 5, "OBSERVE", text_color = color.white, bgcolor = forwardBody, text_size = size.tiny)
        table.cell(forwardValidationTable, 1, 5, f_forwardCellText(PRIORITY_OBSERVE), text_color = color.white, bgcolor = forwardBody, text_size = size.tiny)

        table.cell(forwardValidationTable, 0, 6, "ALL VALID", text_color = color.white, bgcolor = forwardHeader, text_size = size.tiny)
        table.cell(forwardValidationTable, 1, 6, f_forwardCellText(PRIORITY_ALL), text_color = color.white, bgcolor = forwardHeader, text_size = size.tiny)

        table.cell(forwardValidationTable, 0, 7, "F=.5 first | H=1% hit", text_color = color.silver, bgcolor = forwardBody, text_size = size.tiny)
        table.cell(forwardValidationTable, 1, 7, "M=MFE | A=MAE", text_color = color.silver, bgcolor = forwardBody, text_size = size.tiny)

    else
        table.clear(forwardValidationTable, 0, 0, 1, 7)

//=============================================================================
// PHASE 4A-6: GRADE x PROPOSED V4 PROFILE TQS CAPTURE
//=============================================================================

f_v4GradeProfileCellText(int gradeFamily, int profile) =>
    int idx = gradeFamily * PROFILE_COUNT + profile
    int n = array.get(v4GradeProfileSignals, idx)
    string result = "-"

    if n > 0
        int fav = array.get(v4GradeProfileFavFirst, idx)
        int both = array.get(v4GradeProfileBothFirst, idx)
        int hit = array.get(v4GradeProfileFav2Hit, idx)
        float mfe = array.get(v4GradeProfileMFESum, idx) / n
        float mae = array.get(v4GradeProfileMAESum, idx) / n

        string firstText = str.tostring(fav / float(n) * 100.0, "#.0") + "%"
        if both > 0
            firstText := firstText + "*"

        result :=
             "N " + str.tostring(n) +
             " | F " + firstText +
             " | H " + str.tostring(hit / float(n) * 100.0, "#.0") + "%" +
             "\nM " + f_signedPct(mfe) +
             " | A " + f_signedPct(mae)

    result

var table v4GradeProfileCaptureTable =
     table.new(
         position.top_right,
         5,
         8,
         border_width = 1)

if barstate.islast
    if enableHistoricalTracking and showV4GradeProfileCapture
        color captureHeader = color.new(color.gray, 35)
        color captureBody = color.new(color.black, 15)

        table.clear(v4GradeProfileCaptureTable, 0, 0, 4, 7)

        table.cell(v4GradeProfileCaptureTable, 0, 0, "V4 GRADE x PROFILE - TQS CAPTURE", text_color = color.white, bgcolor = captureHeader, text_size = size.small)
        table.cell(v4GradeProfileCaptureTable, 1, 0, "A", text_color = color.white, bgcolor = captureHeader, text_size = size.small)
        table.cell(v4GradeProfileCaptureTable, 2, 0, "B", text_color = color.white, bgcolor = captureHeader, text_size = size.small)
        table.cell(v4GradeProfileCaptureTable, 3, 0, "C", text_color = color.white, bgcolor = captureHeader, text_size = size.small)
        table.cell(v4GradeProfileCaptureTable, 4, 0, "Weak", text_color = color.white, bgcolor = captureHeader, text_size = size.small)

        for p = 0 to PROFILE_COUNT - 1
            int row = p + 1
            table.cell(v4GradeProfileCaptureTable, 0, row, f_profileName(p), text_color = color.white, bgcolor = captureBody, text_size = size.tiny)
            table.cell(v4GradeProfileCaptureTable, 1, row, f_v4GradeProfileCellText(BUCKET_A, p), text_color = color.white, bgcolor = captureBody, text_size = size.tiny)
            table.cell(v4GradeProfileCaptureTable, 2, row, f_v4GradeProfileCellText(BUCKET_B, p), text_color = color.white, bgcolor = captureBody, text_size = size.tiny)
            table.cell(v4GradeProfileCaptureTable, 3, row, f_v4GradeProfileCellText(BUCKET_C, p), text_color = color.white, bgcolor = captureBody, text_size = size.tiny)
            table.cell(v4GradeProfileCaptureTable, 4, row, f_v4GradeProfileCellText(BUCKET_WEAK, p), text_color = color.white, bgcolor = captureBody, text_size = size.tiny)

        table.cell(v4GradeProfileCaptureTable, 0, 7, "N | F=.5 First | H=1% Hit", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(v4GradeProfileCaptureTable, 1, 7, "M=MFE | A=MAE", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(v4GradeProfileCaptureTable, 2, 7, "*=both same candle", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(v4GradeProfileCaptureTable, 3, 7, "Proposed V4 profiles", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(v4GradeProfileCaptureTable, 4, 7, "", bgcolor = captureBody)

    else
        table.clear(v4GradeProfileCaptureTable, 0, 0, 4, 7)

//=============================================================================
// PHASE 4A: UNCLASSIFIED COMPONENT ANALYSIS TABLES
//=============================================================================
//
// Cell format:
// N = observations
// F = 0.5% favorable-first
// H = 1.0% favorable hit
// M = average MFE
// A = average MAE
//
// Left table: Penetration, Range/ATR, Body/Range
// Center table: Close Position, Confirmation Speed
//=============================================================================

f_unclassCellText(int component, int bucketValue, int gradeValue) =>
    int idx = f_unclassIndex(component, bucketValue, gradeValue)
    int n = array.get(unclassSignals, idx)
    string result = "-"

    if n > 0
        int favFirstCount = array.get(unclassFavFirst, idx)
        int bothCount = array.get(unclassBothFirst, idx)
        int fav2Count = array.get(unclassFav2Hit, idx)
        float mfe = array.get(unclassMFESum, idx) / n
        float mae = array.get(unclassMAESum, idx) / n

        string firstText =
             str.tostring(
                 favFirstCount / float(n) * 100.0,
                 "#.0") +
             "%"

        if bothCount > 0
            firstText := firstText + "*"

        result :=
             "N " + str.tostring(n) +
             " | F " + firstText +
             " | H " +
             str.tostring(
                 fav2Count / float(n) * 100.0,
                 "#.0") +
             "%" +
             "\nM " + f_signedPct(mfe) +
             " | A " + f_signedPct(mae)

    result

var table unclassLeftTable =
     showUnclassifiedComponentAnalysis and not showV4Validation ?
         table.new(
             position.bottom_left,
             6,
             20,
             border_width = 1) : na

var table unclassCenterTable =
     showUnclassifiedComponentAnalysis and not showV4Validation ?
         table.new(
             position.bottom_center,
             6,
             14,
             border_width = 1) : na

f_unclassHeader(table targetTable, string title) =>
    color headerColor = color.new(color.gray, 35)
    table.cell(targetTable, 0, 0, title, text_color = color.white, bgcolor = headerColor, text_size = size.small)
    table.cell(targetTable, 1, 0, "A", text_color = color.white, bgcolor = headerColor, text_size = size.small)
    table.cell(targetTable, 2, 0, "B", text_color = color.white, bgcolor = headerColor, text_size = size.small)
    table.cell(targetTable, 3, 0, "C", text_color = color.white, bgcolor = headerColor, text_size = size.small)
    table.cell(targetTable, 4, 0, "Weak", text_color = color.white, bgcolor = headerColor, text_size = size.small)
    table.cell(targetTable, 5, 0, "ALL", text_color = color.white, bgcolor = headerColor, text_size = size.small)

f_unclassSection(table targetTable, int startRow, int component) =>
    color sectionColor = color.new(color.gray, 55)
    color bodyColor = color.new(color.black, 15)

    table.cell(targetTable, 0, startRow, f_unclassComponentName(component), text_color = color.white, bgcolor = sectionColor, text_size = size.tiny)
    for col = 1 to 5
        table.cell(targetTable, col, startRow, "", bgcolor = sectionColor)

    for bucketValue = 0 to 4
        int row = startRow + 1 + bucketValue
        table.cell(targetTable, 0, row, f_unclassBucketName(component, bucketValue), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
        table.cell(targetTable, 1, row, f_unclassCellText(component, bucketValue, BUCKET_A), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
        table.cell(targetTable, 2, row, f_unclassCellText(component, bucketValue, BUCKET_B), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
        table.cell(targetTable, 3, row, f_unclassCellText(component, bucketValue, BUCKET_C), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
        table.cell(targetTable, 4, row, f_unclassCellText(component, bucketValue, BUCKET_WEAK), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
        table.cell(targetTable, 5, row, f_unclassCellText(component, bucketValue, UNCLASS_GRADE_ALL), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)

if barstate.islast
    if enableHistoricalTracking and showUnclassifiedComponentAnalysis and not showV4Validation
        table.clear(unclassLeftTable, 0, 0, 5, 19)
        table.clear(unclassCenterTable, 0, 0, 5, 13)

        f_unclassHeader(unclassLeftTable, "UNCLASSIFIED COMPONENT ANALYSIS 4A")
        f_unclassSection(unclassLeftTable, 1, 0)
        f_unclassSection(unclassLeftTable, 7, 1)
        f_unclassSection(unclassLeftTable, 13, 2)

        color footerColor = color.new(color.black, 15)
        table.cell(unclassLeftTable, 0, 19, "Cell: N | F=.5 First | H=1% Hit", text_color = color.silver, bgcolor = footerColor, text_size = size.tiny)
        table.cell(unclassLeftTable, 1, 19, "M=MFE | A=MAE", text_color = color.silver, bgcolor = footerColor, text_size = size.tiny)
        table.cell(unclassLeftTable, 2, 19, "*=both same candle", text_color = color.silver, bgcolor = footerColor, text_size = size.tiny)
        for col = 3 to 5
            table.cell(unclassLeftTable, col, 19, "", bgcolor = footerColor)

        f_unclassHeader(unclassCenterTable, "UNCLASSIFIED 4A - CLOSE / SPEED")
        f_unclassSection(unclassCenterTable, 1, 3)
        f_unclassSection(unclassCenterTable, 7, 4)

        table.cell(unclassCenterTable, 0, 13, "Only PROFILE_UNCLASSIFIED", text_color = color.silver, bgcolor = footerColor, text_size = size.tiny)
        table.cell(unclassCenterTable, 1, 13, "A/B/C/Weak + ALL", text_color = color.silver, bgcolor = footerColor, text_size = size.tiny)
        for col = 2 to 5
            table.cell(unclassCenterTable, col, 13, "", bgcolor = footerColor)

    else
        if not na(unclassLeftTable)
            table.clear(unclassLeftTable, 0, 0, 5, 19)
        if not na(unclassCenterTable)
            table.clear(unclassCenterTable, 0, 0, 5, 13)

//=============================================================================
// HISTORICAL COVERAGE DIAGNOSTIC TABLE
//=============================================================================

var table coverageTable =
     table.new(
         position.top_center,
         2,
         14,
         border_width = 1)

f_diagDate(int t) =>
    string result = "-"

    if not na(t)
        result :=
             str.format_time(
                 t,
                 "yyyy-MM-dd HH:mm",
                 tz)

    result

if barstate.islast

    table.clear(
         coverageTable,
         0,
         0,
         1,
         13)

    color diagHeader =
         color.new(
             color.gray,
             35)

    color diagBody =
         color.new(
             color.black,
             15)

    int requestedStart = historicalRecentStart
    int requestedEnd = timenow

    if historicalWindow == "Custom Historical"
        requestedStart := historicalCustomStart
        requestedEnd := historicalEndDate

    bool windowComplete = false

    if not na(diagOldestLoadedBar)
        windowComplete :=
             diagOldestLoadedBar <= requestedStart

    float requestedDays =
         (requestedEnd - requestedStart) /
         float(MS_PER_DAY)

    float actualAvailableDays = na

    if not na(diagOldestLoadedBar)
        int effectiveStart =
             math.max(
                 diagOldestLoadedBar,
                 requestedStart)

        actualAvailableDays :=
             math.max(
                 0.0,
                 (requestedEnd - effectiveStart) /
                 float(MS_PER_DAY))

    table.cell(
         coverageTable,
         0,
         0,
         "HISTORICAL COVERAGE",
         text_color = color.white,
         bgcolor = diagHeader,
         text_size = size.small)

    table.cell(
         coverageTable,
         1,
         0,
         windowComplete ? "COMPLETE" : "TRUNCATED",
         text_color = windowComplete ? color.lime : color.orange,
         bgcolor = diagHeader,
         text_size = size.small)

    table.cell(
         coverageTable,
         0,
         1,
         "Requested Start",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         1,
         f_diagDate(requestedStart),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         0,
         2,
         "Requested End",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         2,
         f_diagDate(requestedEnd),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         0,
         3,
         "Oldest Loaded Bar",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         3,
         f_diagDate(diagOldestLoadedBar),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         0,
         4,
         "Bars In Window",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         4,
         str.tostring(diagBarsInRequestedWindow),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         0,
         5,
         "Requested Days",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         5,
         str.tostring(requestedDays, "#.0"),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         0,
         6,
         "Available Days",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         6,
         na(actualAvailableDays) ?
             "-" :
             str.tostring(actualAvailableDays, "#.0"),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         0,
         7,
         "First Signal",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         7,
         f_diagDate(diagFirstSignalTime),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         0,
         8,
         "Last Signal",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         8,
         f_diagDate(diagLastSignalTime),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         0,
         9,
         "Bars With PMH",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         9,
         str.tostring(diagBarsWithPMH),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         0,
         10,
         "Bars With PML",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         10,
         str.tostring(diagBarsWithPML),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         0,
         11,
         "Bars With PDH",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         11,
         str.tostring(diagBarsWithPDH),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         0,
         12,
         "Bars With PDL",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         12,
         str.tostring(diagBarsWithPDL),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         0,
         13,
         "Levels Ready",
         text_color = color.silver,
         bgcolor = diagBody,
         text_size = size.tiny)

    table.cell(
         coverageTable,
         1,
         13,
         str.tostring(diagBarsLevelsReady),
         text_color = color.white,
         bgcolor = diagBody,
         text_size = size.tiny)

    if not showHistoricalCoverage
        table.clear(coverageTable, 0, 0, 1, 13)
