//=============================================================================
// PROFILE COMPONENT ANALYSIS ROW
//=============================================================================

f_profileComponentRow(int row, int bucket) =>
    int signalCount = array.get(profileCompSignals, bucket)
    int favFirstCount = array.get(profileCompFavFirst, bucket)
    int bothCount = array.get(profileCompBothFirst, bucket)
    int fav2Count = array.get(profileCompFav2Hit, bucket)

    float mfeSum = array.get(profileCompMFESum, bucket)
    float maeSum = array.get(profileCompMAESum, bucket)

    string favFirstText = "-"
    string fav2Text = "-"
    string avgMFEText = "-"
    string avgMAEText = "-"

    if signalCount > 0
        favFirstText := str.tostring(favFirstCount / float(signalCount) * 100.0, "#.0") + "%"

        if bothCount > 0
            favFirstText := favFirstText + "*"

        fav2Text := str.tostring(fav2Count / float(signalCount) * 100.0, "#.0") + "%"
        avgMFEText := f_signedPct(mfeSum / signalCount)
        avgMAEText := f_signedPct(maeSum / signalCount)

    int selectedComponent = f_profileAnalysisComponentIndex()

    table.cell(analysisTable, 0, row, f_profileComponentBucketName(selectedComponent, bucket), text_color = color.white, bgcolor = color.new(color.black, 15), text_size = size.small)
    table.cell(analysisTable, 1, row, str.tostring(signalCount), text_color = color.white, bgcolor = color.new(color.black, 15), text_size = size.small)
    table.cell(analysisTable, 2, row, favFirstText, text_color = color.white, bgcolor = color.new(color.black, 15), text_size = size.small)
    table.cell(analysisTable, 3, row, fav2Text, text_color = color.white, bgcolor = color.new(color.black, 15), text_size = size.small)
    table.cell(analysisTable, 4, row, avgMFEText, text_color = color.white, bgcolor = color.new(color.black, 15), text_size = size.small)
    table.cell(analysisTable, 5, row, avgMAEText, text_color = color.white, bgcolor = color.new(color.black, 15), text_size = size.small)

//=============================================================================
// GRADE x PROFILE MATRIX HELPERS
//=============================================================================

f_gradeProfileCellText(int gradeFamily, int profile) =>
    int idx = gradeFamily * PROFILE_COUNT + profile
    int n = array.get(gradeProfileSignals, idx)
    string result = "-"

    if n > 0
        int favFirstCount = array.get(gradeProfileFavFirst, idx)
        int bothCount = array.get(gradeProfileBothFirst, idx)
        int fav2Count = array.get(gradeProfileFav2Hit, idx)
        float mfe = array.get(gradeProfileMFESum, idx) / n
        float mae = array.get(gradeProfileMAESum, idx) / n
        string firstText = str.tostring(favFirstCount / float(n) * 100.0, "#.0") + "%"

        if bothCount > 0
            firstText := firstText + "*"

        result :=
             "N " + str.tostring(n) +
             " | F " + firstText +
             " | H " + str.tostring(fav2Count / float(n) * 100.0, "#.0") + "%" +
             "\nM " + f_signedPct(mfe) +
             " | A " + f_signedPct(mae)

    result

f_profileAllCellText(int profile) =>
    int n = array.get(profileSignals, profile)
    string result = "-"

    if n > 0
        int favFirstCount = array.get(profileFavFirst, profile)
        int bothCount = array.get(profileBothFirst, profile)
        int fav2Count = array.get(profileFav2Hit, profile)
        float mfe = array.get(profileMFESum, profile) / n
        float mae = array.get(profileMAESum, profile) / n
        string firstText = str.tostring(favFirstCount / float(n) * 100.0, "#.0") + "%"

        if bothCount > 0
            firstText := firstText + "*"

        result :=
             "N " + str.tostring(n) +
             " | F " + firstText +
             " | H " + str.tostring(fav2Count / float(n) * 100.0, "#.0") + "%" +
             "\nM " + f_signedPct(mfe) +
             " | A " + f_signedPct(mae)

    result

f_gradeProfileMatrixRow(int row, int profile) =>
    color bodyColor = color.new(color.black, 15)

    table.cell(
         analysisTable,
         0,
         row,
         f_profileName(profile),
         text_color = color.white,
         bgcolor = bodyColor,
         text_size = size.tiny)

    table.cell(analysisTable, 1, row, f_gradeProfileCellText(BUCKET_A, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 2, row, f_gradeProfileCellText(BUCKET_B, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 3, row, f_gradeProfileCellText(BUCKET_C, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 4, row, f_gradeProfileCellText(BUCKET_WEAK, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 5, row, f_profileAllCellText(profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)

//=============================================================================
// EXACT GRADE x PROFILE RESEARCH HELPERS
//=============================================================================

f_exactGradeProfileCellText(int exactGrade, int profile) =>
    int idx = exactGrade * PROFILE_COUNT + profile
    int n = array.get(exactGradeProfileSignals, idx)
    string result = "-"

    if n > 0
        int favFirstCount = array.get(exactGradeProfileFavFirst, idx)
        int bothCount = array.get(exactGradeProfileBothFirst, idx)
        int fav2Count = array.get(exactGradeProfileFav2Hit, idx)
        float mfe = array.get(exactGradeProfileMFESum, idx) / n
        float mae = array.get(exactGradeProfileMAESum, idx) / n
        string firstText = str.tostring(favFirstCount / float(n) * 100.0, "#.0") + "%"
        if bothCount > 0
            firstText := firstText + "*"
        result := "N " + str.tostring(n) + " | F " + firstText + " | H " + str.tostring(fav2Count / float(n) * 100.0, "#.0") + "%" + "\M " + f_signedPct(mfe) + " | A " + f_signedPct(mae)
    result

f_exactGradeProfileRow(int row, int profile) =>
    color bodyColor = color.new(color.black, 15)
    table.cell(analysisTable, 0, row, f_profileName(profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 1, row, f_exactGradeProfileCellText(V3_GRADE_A_PLUS, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 2, row, f_exactGradeProfileCellText(V3_GRADE_A, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 3, row, f_exactGradeProfileCellText(V3_GRADE_A_MINUS, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 4, row, f_exactGradeProfileCellText(V3_GRADE_B_PLUS, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 5, row, f_exactGradeProfileCellText(V3_GRADE_B, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 6, row, f_exactGradeProfileCellText(V3_GRADE_B_MINUS, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 7, row, f_exactGradeProfileCellText(V3_GRADE_C_PLUS, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 8, row, f_exactGradeProfileCellText(V3_GRADE_C, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 9, row, f_exactGradeProfileCellText(V3_GRADE_C_MINUS, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(analysisTable, 10, row, f_exactGradeProfileCellText(V3_GRADE_WEAK, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)

//=============================================================================
// RESEARCH CAPTURE TABLES - PRIMARY SIMULTANEOUS VIEWS
//=============================================================================
//
// These tables are independent of Analytics Panel View so the Grade x Profile
// Matrix and Combination Profiles can be captured in the same screenshot.
// They are display-only and do not change signal or research calculations.
//=============================================================================

var table gradeProfileCaptureTable =
     showGradeProfileMatrix and not showV4Validation ?
         table.new(
             position.bottom_left,
             6,
             9,
             border_width = 1) : na

var table combinationCaptureTable =
     showCombinationProfiles and not showV4Validation ?
         table.new(
             position.bottom_center,
             6,
             9,
             border_width = 1) : na

f_gradeProfileCaptureRow(int row, int profile) =>
    color bodyColor = color.new(color.black, 15)
    table.cell(gradeProfileCaptureTable, 0, row, f_profileName(profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(gradeProfileCaptureTable, 1, row, f_gradeProfileCellText(BUCKET_A, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(gradeProfileCaptureTable, 2, row, f_gradeProfileCellText(BUCKET_B, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(gradeProfileCaptureTable, 3, row, f_gradeProfileCellText(BUCKET_C, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(gradeProfileCaptureTable, 4, row, f_gradeProfileCellText(BUCKET_WEAK, profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(gradeProfileCaptureTable, 5, row, f_profileAllCellText(profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)

f_combinationCaptureRow(int row, int profile) =>
    int signalCount = array.get(profileSignals, profile)
    int favFirstCount = array.get(profileFavFirst, profile)
    int bothCount = array.get(profileBothFirst, profile)
    int fav2Count = array.get(profileFav2Hit, profile)
    float mfeSum = array.get(profileMFESum, profile)
    float maeSum = array.get(profileMAESum, profile)
    string favFirstText = "-"
    string fav2Text = "-"
    string avgMFEText = "-"
    string avgMAEText = "-"

    if signalCount > 0
        favFirstText := str.tostring(favFirstCount / float(signalCount) * 100.0, "#.0") + "%"
        if bothCount > 0
            favFirstText := favFirstText + "*"
        fav2Text := str.tostring(fav2Count / float(signalCount) * 100.0, "#.0") + "%"
        avgMFEText := f_signedPct(mfeSum / signalCount)
        avgMAEText := f_signedPct(maeSum / signalCount)

    color bodyColor = color.new(color.black, 15)
    table.cell(combinationCaptureTable, 0, row, f_profileName(profile), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(combinationCaptureTable, 1, row, str.tostring(signalCount), text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(combinationCaptureTable, 2, row, favFirstText, text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(combinationCaptureTable, 3, row, fav2Text, text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(combinationCaptureTable, 4, row, avgMFEText, text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)
    table.cell(combinationCaptureTable, 5, row, avgMAEText, text_color = color.white, bgcolor = bodyColor, text_size = size.tiny)

if barstate.islast
    color captureHeader = color.new(color.gray, 35)
    color captureBody = color.new(color.black, 15)

    if enableHistoricalTracking and showGradeProfileMatrix and not showV4Validation
        table.clear(gradeProfileCaptureTable, 0, 0, 5, 8)
        table.cell(gradeProfileCaptureTable, 0, 0, "GRADE x PROFILE MATRIX", text_color = color.white, bgcolor = captureHeader, text_size = size.small)
        table.cell(gradeProfileCaptureTable, 1, 0, "A", text_color = color.white, bgcolor = captureHeader, text_size = size.small)
        table.cell(gradeProfileCaptureTable, 2, 0, "B", text_color = color.white, bgcolor = captureHeader, text_size = size.small)
        table.cell(gradeProfileCaptureTable, 3, 0, "C", text_color = color.white, bgcolor = captureHeader, text_size = size.small)
        table.cell(gradeProfileCaptureTable, 4, 0, "Weak", text_color = color.white, bgcolor = captureHeader, text_size = size.small)
        table.cell(gradeProfileCaptureTable, 5, 0, "ALL", text_color = color.white, bgcolor = captureHeader, text_size = size.small)
        table.cell(gradeProfileCaptureTable, 0, 1, "Cell format", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(gradeProfileCaptureTable, 1, 1, "N | F=.5 First | H=1% Hit", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(gradeProfileCaptureTable, 2, 1, "M=MFE | A=MAE", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        for col = 3 to 5
            table.cell(gradeProfileCaptureTable, col, 1, "", bgcolor = captureBody)

        f_gradeProfileCaptureRow(2, PROFILE_CONTROLLED)
        f_gradeProfileCaptureRow(3, PROFILE_EXPLOSIVE)
        f_gradeProfileCaptureRow(4, PROFILE_EFFICIENT)
        f_gradeProfileCaptureRow(5, PROFILE_PRETTY_WEAK)
        f_gradeProfileCaptureRow(6, PROFILE_DELAYED)
        f_gradeProfileCaptureRow(7, PROFILE_UNCLASSIFIED)

        table.cell(gradeProfileCaptureTable, 0, 8, "Research capture", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(gradeProfileCaptureTable, 1, 8, "A/B/C = grade families", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(gradeProfileCaptureTable, 2, 8, "*=both targets same candle", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        for col = 3 to 5
            table.cell(gradeProfileCaptureTable, col, 8, "", bgcolor = captureBody)
    else if not na(gradeProfileCaptureTable)
        table.clear(gradeProfileCaptureTable, 0, 0, 5, 8)

    if enableHistoricalTracking and showCombinationProfiles and not showV4Validation
        table.clear(combinationCaptureTable, 0, 0, 5, 8)
        table.cell(combinationCaptureTable, 0, 0, "COMBINATION PROFILES", text_color = color.white, bgcolor = captureHeader, text_size = size.small)
        for col = 1 to 5
            table.cell(combinationCaptureTable, col, 0, "", bgcolor = captureHeader)
        table.cell(combinationCaptureTable, 0, 1, "Profile", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(combinationCaptureTable, 1, 1, "N", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(combinationCaptureTable, 2, 1, str.tostring(favorableTarget1, "#.##") + "% First", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(combinationCaptureTable, 3, 1, str.tostring(favorableTarget2, "#.##") + "% Hit", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(combinationCaptureTable, 4, 1, "Avg MFE", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(combinationCaptureTable, 5, 1, "Avg MAE", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)

        f_combinationCaptureRow(2, PROFILE_CONTROLLED)
        f_combinationCaptureRow(3, PROFILE_EXPLOSIVE)
        f_combinationCaptureRow(4, PROFILE_EFFICIENT)
        f_combinationCaptureRow(5, PROFILE_PRETTY_WEAK)
        f_combinationCaptureRow(6, PROFILE_DELAYED)
        f_combinationCaptureRow(7, PROFILE_UNCLASSIFIED)

        int classifiedCountCapture =
             array.get(profileSignals, PROFILE_CONTROLLED) +
             array.get(profileSignals, PROFILE_EXPLOSIVE) +
             array.get(profileSignals, PROFILE_EFFICIENT) +
             array.get(profileSignals, PROFILE_PRETTY_WEAK) +
             array.get(profileSignals, PROFILE_DELAYED)
        int totalProfileCountCapture = classifiedCountCapture + array.get(profileSignals, PROFILE_UNCLASSIFIED)
        string profileCoverageText = "-"
        if totalProfileCountCapture > 0
            profileCoverageText := str.tostring(classifiedCountCapture / float(totalProfileCountCapture) * 100.0, "#.0") + "%"

        table.cell(combinationCaptureTable, 0, 8, "Profile Coverage", text_color = color.silver, bgcolor = captureBody, text_size = size.tiny)
        table.cell(combinationCaptureTable, 1, 8, profileCoverageText, text_color = color.white, bgcolor = captureBody, text_size = size.tiny)
        for col = 2 to 5
            table.cell(combinationCaptureTable, col, 8, "", bgcolor = captureBody)
    else if not na(combinationCaptureTable)
        table.clear(combinationCaptureTable, 0, 0, 5, 8)

//=============================================================================
// DRAW ANALYTICS TABLE
//=============================================================================

if barstate.islast

    if enableHistoricalTracking and
       showAnalysisPanel

        table.clear(
             analysisTable,
             0,
             0,
             10,
             8)

        color analyticsHeader =
             color.new(
                 color.gray,
                 35)

        color analyticsBody =
             color.new(
                 color.black,
                 15)

        //=====================================================================
        // VIEW 1: COMBINATION PROFILES
        //=====================================================================

        if analyticsView == "Combination Profiles"

            table.cell(
                 analysisTable,
                 0,
                 0,
                 "COMBINATION PROFILES",
                 text_color = color.white,
                 bgcolor = analyticsHeader,
                 text_size = size.small)

            table.cell(
                 analysisTable,
                 1,
                 0,
                 "",
                 bgcolor = analyticsHeader)

            table.cell(
                 analysisTable,
                 2,
                 0,
                 "",
                 bgcolor = analyticsHeader)

            table.cell(
                 analysisTable,
                 3,
                 0,
                 "",
                 bgcolor = analyticsHeader)

            table.cell(
                 analysisTable,
                 4,
                 0,
                 "",
                 bgcolor = analyticsHeader)

            table.cell(
                 analysisTable,
                 5,
                 0,
                 "",
                 bgcolor = analyticsHeader)

            table.cell(
                 analysisTable,
                 0,
                 1,
                 "Profile",
                 text_color = color.silver,
                 bgcolor = analyticsBody,
                 text_size = size.tiny)

            table.cell(
                 analysisTable,
                 1,
                 1,
                 "N",
                 text_color = color.silver,
                 bgcolor = analyticsBody,
                 text_size = size.tiny)

            table.cell(
                 analysisTable,
                 2,
                 1,
                 str.tostring(
                     favorableTarget1,
                     "#.##") +
                 "% First",
                 text_color = color.silver,
                 bgcolor = analyticsBody,
                 text_size = size.tiny)

            table.cell(
                 analysisTable,
                 3,
                 1,
                 str.tostring(
                     favorableTarget2,
                     "#.##") +
                 "% Hit",
                 text_color = color.silver,
                 bgcolor = analyticsBody,
                 text_size = size.tiny)

            table.cell(
                 analysisTable,
                 4,
                 1,
                 "Avg MFE",
                 text_color = color.silver,
                 bgcolor = analyticsBody,
                 text_size = size.tiny)

            table.cell(
                 analysisTable,
                 5,
                 1,
                 "Avg MAE",
                 text_color = color.silver,
                 bgcolor = analyticsBody,
                 text_size = size.tiny)

            f_profileRow(
                 2,
                 PROFILE_CONTROLLED)

            f_profileRow(
                 3,
                 PROFILE_EXPLOSIVE)

            f_profileRow(
                 4,
                 PROFILE_EFFICIENT)

            f_profileRow(
                 5,
                 PROFILE_PRETTY_WEAK)

            f_profileRow(
                 6,
                 PROFILE_DELAYED)

            f_profileRow(
                 7,
                 PROFILE_UNCLASSIFIED)

            int classifiedCount =
                 array.get(
                     profileSignals,
                     PROFILE_CONTROLLED) +
                 array.get(
                     profileSignals,
                     PROFILE_EXPLOSIVE) +
                 array.get(
                     profileSignals,
                     PROFILE_EFFICIENT) +
                 array.get(
                     profileSignals,
                     PROFILE_PRETTY_WEAK) +
                 array.get(
                     profileSignals,
                     PROFILE_DELAYED)

            int totalProfileCount =
                 classifiedCount +
                 array.get(
                     profileSignals,
                     PROFILE_UNCLASSIFIED)

            string coverageText = "-"

            if totalProfileCount > 0
                coverageText :=
                     str.tostring(
                         classifiedCount /
                         float(totalProfileCount) *
                         100.0,
                         "#.0") +
                     "%"

            table.cell(
                 analysisTable,
                 0,
                 8,
                 "Profile Coverage",
                 text_color = color.silver,
                 bgcolor = analyticsBody,
                 text_size = size.tiny)

            table.cell(
                 analysisTable,
