FROM python:3.12-slim

ARG TR_GIT_SHA
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TR_WORK_ROOT=/workspace \
    TR_GIT_SHA=${TR_GIT_SHA}

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY . /app
RUN mkdir -p /workspace/research_outputs \
    && python -m cloud_compute.container_contract

ENTRYPOINT ["python", "-m", "research_runner.runner"]
CMD ["status"]
