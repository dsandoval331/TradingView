//=============================================================================
// BUILD 4.4 — SEPARATION BUCKET CALCULATIONS
//=============================================================================

f_bucketAvg(array<float> totals, array<int> counts, int bucket) =>
    int n = array.get(counts, bucket)
    n > 0 ? array.get(totals, bucket) / float(n) : na

f_bucketRate(array<int> hits, array<int> counts, int bucket) =>
    int n = array.get(counts, bucket)
    n > 0 ? float(array.get(hits, bucket)) / float(n) * 100.0 : na

f_sep10MedMFE(int bucket) =>
    bucket == 0 ? f_median(sep10MfeB0) :
     bucket == 1 ? f_median(sep10MfeB1) :
     bucket == 2 ? f_median(sep10MfeB2) :
     bucket == 3 ? f_median(sep10MfeB3) :
     na

f_sep10MedMAE(int bucket) =>
    bucket == 0 ? f_median(sep10MaeB0) :
     bucket == 1 ? f_median(sep10MaeB1) :
     bucket == 2 ? f_median(sep10MaeB2) :
     bucket == 3 ? f_median(sep10MaeB3) :
     na

f_sep15MedMFE(int bucket) =>
    bucket == 0 ? f_median(sep15MfeB0) :
     bucket == 1 ? f_median(sep15MfeB1) :
     bucket == 2 ? f_median(sep15MfeB2) :
     bucket == 3 ? f_median(sep15MfeB3) :
     na

f_sep15MedMAE(int bucket) =>
    bucket == 0 ? f_median(sep15MaeB0) :
     bucket == 1 ? f_median(sep15MaeB1) :
     bucket == 2 ? f_median(sep15MaeB2) :
     bucket == 3 ? f_median(sep15MaeB3) :
     na


//=============================================================================
// BUILD 4.6 — TRAJECTORY RATIO CALCULATION HELPERS
//=============================================================================

f_ratioAvg(array<float> totals, int bucket) =>
    int n = array.get(ratioN, bucket)
    n > 0 ? array.get(totals, bucket) / float(n) : na

f_ratioRate(array<int> hits, int bucket) =>
    int n = array.get(ratioN, bucket)
    n > 0 ? float(array.get(hits, bucket)) / float(n) * 100.0 : na

f_ratioMedMFE(int bucket) =>
    bucket == 0 ? f_median(ratioMfeB0) :
     bucket == 1 ? f_median(ratioMfeB1) :
     bucket == 2 ? f_median(ratioMfeB2) :
     bucket == 3 ? f_median(ratioMfeB3) :
     bucket == 4 ? f_median(ratioMfeB4) :
     na

f_ratioMedMAE(int bucket) =>
    bucket == 0 ? f_median(ratioMaeB0) :
     bucket == 1 ? f_median(ratioMaeB1) :
     bucket == 2 ? f_median(ratioMaeB2) :
     bucket == 3 ? f_median(ratioMaeB3) :
     bucket == 4 ? f_median(ratioMaeB4) :
     na


//=============================================================================
// BUILD 5.3 — STRONG EXPANSION SPLIT CALCULATION HELPERS
//=============================================================================

f_strongExpAvg(array<float> totals, int group) =>
    int n = array.get(strongExpSepN, group)
    n > 0 ? array.get(totals, group) / float(n) : na

f_strongExpRate(array<int> hits, int group) =>
    int n = array.get(strongExpSepN, group)
    n > 0 ? float(array.get(hits, group)) / float(n) * 100.0 : na

f_strongExpMedMFE(int group) =>
    group == 0 ? f_median(strongExpSepMfeB0) :
     group == 1 ? f_median(strongExpSepMfeB1) :
     na

f_strongExpMedMAE(int group) =>
    group == 0 ? f_median(strongExpSepMaeB0) :
     group == 1 ? f_median(strongExpSepMaeB1) :
     na

f_strongExpGroupName(int group) =>
    group == 0 ? "10m Sep <100%" :
     group == 1 ? "10m Sep >=100%" :
     "Invalid"


