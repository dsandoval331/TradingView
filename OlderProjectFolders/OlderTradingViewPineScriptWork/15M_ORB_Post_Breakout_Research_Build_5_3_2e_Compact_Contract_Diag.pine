        table.cell(extDepthTable, 0, 0, "EXT DEPTH", bgcolor = color.new(color.orange, 65), text_color = color.white)
        table.cell(extDepthTable, 1, 0, "N", bgcolor = color.new(color.orange, 65), text_color = color.white)
        table.cell(extDepthTable, 2, 0, ".50F", bgcolor = color.new(color.orange, 65), text_color = color.white)
        table.cell(extDepthTable, 3, 0, ".75", bgcolor = color.new(color.orange, 65), text_color = color.white)
        table.cell(extDepthTable, 4, 0, "1.0", bgcolor = color.new(color.orange, 65), text_color = color.white)
        table.cell(extDepthTable, 5, 0, "AVG MFE", bgcolor = color.new(color.orange, 65), text_color = color.white)
        table.cell(extDepthTable, 6, 0, "AVG MAE", bgcolor = color.new(color.orange, 65), text_color = color.white)

        for edb = 0 to 2
            int row = edb + 1
            table.cell(extDepthTable, 0, row, f_extDepthName(edb))
            table.cell(extDepthTable, 1, row, f_num(array.get(extDepthN, edb)))
            table.cell(extDepthTable, 2, row, f_pct(f_extDepthRate(extDepthFav050, edb)))
            table.cell(extDepthTable, 3, row, f_pct(f_extDepthRate(extDepthHit075, edb)))
            table.cell(extDepthTable, 4, row, f_pct(f_extDepthRate(extDepthHit100, edb)))
            table.cell(extDepthTable, 5, row, f_pct(f_extDepthAvg(extDepthMfeTotal, edb)))
            table.cell(extDepthTable, 6, row, f_pct(f_extDepthAvg(extDepthMaeTotal, edb)))
    else
