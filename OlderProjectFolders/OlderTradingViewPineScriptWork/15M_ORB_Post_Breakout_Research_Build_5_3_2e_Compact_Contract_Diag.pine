//=============================================================================
// BUILD 5.3 — 10M QUALITY STUDY AGGREGATES
//
// Unlike the existing NR checkpoint studies, this population includes EVERY
// active breakout that survives to the 10-minute timestamp, even if a retest
// has already occurred. This is intentionally descriptive and does not alter
// signal qualification.
//=============================================================================

var array<int> qualityN = array.new_int(3, 0)
var array<float> qualityMfe10Total = array.new_float(3, 0.0)
var array<float> qualityMae10Total = array.new_float(3, 0.0)
var array<float> qualityRatio10Total = array.new_float(3, 0.0)
var array<float> qualityTrajectoryTotal = array.new_float(3, 0.0)
