var array<int> qualityHit100 = array.new_int(3, 0)

f_qualityAvg(array<float> totals, int group) =>
    int n = array.get(qualityN, group)
    n > 0 ? array.get(totals, group) / n : na

f_qualityTrajectoryAvg(int group) =>
    int n = array.get(qualityTrajectoryN, group)
    n > 0 ? array.get(qualityTrajectoryTotal, group) / n : na

f_qualityRate(array<int> counts, int group) =>
    int n = array.get(qualityN, group)
    n > 0 ? array.get(counts, group) * 100.0 / n : na


