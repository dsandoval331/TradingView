//@version=6
indicator(
     "15M ORB Post-Breakout Research - Build 5.3.2e",
     overlay = true,
     max_labels_count = 500)

//=============================================================================
// BUILD 5.3 — STRONG EXPANSION / INITIAL SEPARATION STUDY
//
// CORE RULES
//
// BUILD 5.3.2e — COMPACT CONTRACT DIAGNOSTIC LAYOUT:
// • Preserves all Build 5.3.1 signal, checkpoint, retest, trajectory,
//   quality, failure-audit, and outcome logic unchanged.
// • Adds diagnostic instrumentation ONLY for EST events classified
//   CONTRACT from the 10m→15m separation trajectory.
// • Goal: distinguish EST CONTRACT winners from EST CONTRACT failures.
// • Predetermined diagnostics: 10M state, 10M separation, 10M MFE,
//   10M MAE, 10M Q, Bull/Bear direction, and contraction severity.
// • Compiler refactor: large top-center table rendering moved into functions.
// • Research calculations, thresholds, classifications, and outcomes unchanged.
// • CONTRACT severity respects the existing CONTRACT <0.80 definition:
//   Severe <0.50, Moderate 0.50–<0.65, Mild 0.65–<0.80.
//
// • 1-minute chart only.
// • ORB = 09:30–09:44 ET.
// • ORB freezes at 09:45 ET.
// • First qualified 1M close outside ORB is the day's primary breakout.
// • Only one primary breakout per day.
//
// PRIMARY BASELINE:
// +0.50% favorable BEFORE -0.50% adverse from breakout close.
//
// RETEST:
// • ATR freezes at breakout.
// • Retest zone = ±10% frozen 1M ATR around broken ORB boundary.
// • Wick/high-low overlap with zone = retest.
// • Provisional failure = close ≥25% frozen ATR back inside ORB.
// • Successful confirmation = later directional candle closes back outside
//   the outer retest-zone boundary.
//
// FIRST-EVENT PATH PRINCIPLE:
//
// NR CONTINUE:
// +0.50% favorable reached before first retest.
//
// NR FAIL:
// -0.50% adverse reached before first retest and before +0.50% favorable.
//
// RETEST CONTINUE:
// Retest occurs first → no failure → confirmation → +0.50% favorable later.
//
// RETEST FAIL:
// Retest occurs first → provisional failure before successful confirmation.
//
// RETEST UNCONFIRMED:
// Retest occurs, but no failure and no confirmation by RTH close.
//
// UNRESOLVED:
// Does not meet another path by RTH close.
//
// MARKET REGIME:
// RTH and Daily regime metadata remain available for future Build 4 analysis.
//=============================================================================


//=============================================================================
// CONSTANTS
//=============================================================================

string TZ = "America/New_York"

int REGIME_BULL = 1
int REGIME_MIXED = 0
int REGIME_BEAR = -1
int REGIME_INVALID = 99

int PATH_NONE = 0
int PATH_NR_CONTINUE = 1
int PATH_RETEST_CONTINUE = 2
int PATH_RETEST_FAIL = 3
int PATH_NR_FAIL = 4
int PATH_RETEST_UNCONFIRMED = 5
int PATH_UNRESOLVED = 6


//=============================================================================
// INPUTS — RESEARCH PERIOD
//=============================================================================

groupResearch = "Research Period"

useStartDate =
     input.bool(
         true,
         "Use Research Start Date",
         group = groupResearch)

researchStart =
     input.time(
         timestamp("13 Jul 2026 00:00 -0500"),
         "Research Start Date",
         group = groupResearch)

useEndDate =
     input.bool(
         true,
         "Use Research End Date",
         group = groupResearch)

researchEnd =
     input.time(
         timestamp("20 Aug 2026 23:59 -0500"),
         "Research End Date",
         group = groupResearch)


//=============================================================================
// INPUTS — OUTCOME RESEARCH
//=============================================================================

groupOutcome = "Outcome Research"

primaryPct =
     input.float(
         0.50,
         "Primary Favorable / Adverse %",
         minval = 0.01,
         step = 0.05,
         group = groupOutcome)

secondary025 =
     input.float(
         0.25,
         "Secondary Favorable 1 %",
         minval = 0.01,
         step = 0.05,
         group = groupOutcome)

secondary075 =
     input.float(
         0.75,
         "Secondary Favorable 2 %",
         minval = 0.01,
         step = 0.05,
         group = groupOutcome)

secondary100 =
     input.float(
         1.00,
         "Secondary Favorable 3 %",
         minval = 0.01,
         step = 0.05,
         group = groupOutcome)


//=============================================================================
// INPUTS — BREAKOUT CONFIRMATION
//=============================================================================

groupBreakout = "Breakout Confirmation"

atrLength =
     input.int(
         14,
         "1M ATR Length",
         minval = 1,
         group = groupBreakout)

reqDirectional =
     input.bool(
         false,
         "Require Directional Candle",
         group = groupBreakout)

reqPenetration =
     input.bool(
         false,
         "Require Minimum ATR Penetration",
         group = groupBreakout)

minPenetrationPct =
     input.float(
         10.0,
         "Minimum Penetration % ATR",
         minval = 0.0,
         step = 1.0,
         group = groupBreakout)

reqBody =
     input.bool(
         false,
         "Require Body / Range Strength",
         group = groupBreakout)

minBodyPct =
     input.float(
         50.0,
         "Minimum Body / Range %",
         minval = 0.0,
         maxval = 100.0,
         step = 1.0,
         group = groupBreakout)

reqRange =
     input.bool(
         false,
         "Require Minimum Candle Range vs ATR",
         group = groupBreakout)

minRangeAtrPct =
     input.float(
         25.0,
         "Minimum Range % ATR",
         minval = 0.0,
         step = 1.0,
         group = groupBreakout)

reqClosePosition =
     input.bool(
         false,
         "Require Strong Close Position",
         group = groupBreakout)

minClosePositionPct =
     input.float(
         80.0,
         "Minimum Close Position %",
         minval = 0.0,
         maxval = 100.0,
         step = 1.0,
         group = groupBreakout)


//=============================================================================
// INPUTS — STRENGTH SCORE
//=============================================================================

groupStrength = "Strength Score"

enableStrengthScore =
     input.bool(
         true,
         "Enable Strength Score",
         group = groupStrength)

showScoreOnLabel =
     input.bool(
         true,
         "Show Score on Breakout Label",
         group = groupStrength)

reqMinimumGrade =
     input.bool(
         false,
         "Require Minimum Grade",
         group = groupStrength)

minimumGrade =
     input.string(
         "B",
         "Minimum Signal Grade",
         options = [
             "A+",
             "A",
             "A-",
             "B+",
             "B",
             "B-",
             "C+",
             "C",
             "C-",
             "Weak"
         ],
         group = groupStrength)


//=============================================================================
// INPUTS — RETEST RESEARCH
//=============================================================================

groupRetest = "Retest Research"

retestZoneAtrPct =
     input.float(
         10.0,
         "Retest Zone ± % of Frozen ATR",
         minval = 0.0,
         step = 1.0,
         group = groupRetest)

failureAtrPct =
     input.float(
         25.0,
         "Failure Close Penetration % of Frozen ATR",
         minval = 0.0,
         step = 1.0,
         group = groupRetest)

requireDirectionalConfirmation =
     input.bool(
         true,
         "Require Directional Retest Confirmation Candle",
         group = groupRetest)

showRetestZone =
     input.bool(
         false,
         "Show Active Retest Zone",
         group = groupRetest)

showRetestLabels =
     input.bool(
         true,
         "Show Retest / Confirmation / Failure Labels",
         group = groupRetest)


//=============================================================================
// INPUTS — NO-RETEST CHECKPOINT RESEARCH
//=============================================================================

groupCheckpoint = "No-Retest Checkpoints"

enableCheckpointResearch =
     input.bool(
         true,
         "Enable No-Retest Checkpoint Research",
         group = groupCheckpoint)

showCheckpointTable =
     input.bool(
         true,
         "Show No-Retest Checkpoint Table",
         group = groupCheckpoint)


showContractDiagnostic =
     input.bool(
         true,
         "Show Build 5.3.2 CONTRACT Diagnostic",
         group = groupCheckpoint)

showCheckpointLabels =
     input.bool(
         false,
         "Show 5/10/15/30m Checkpoint Labels",
         group = groupCheckpoint)


//=============================================================================
// INPUTS — MARKET REGIME
//=============================================================================

groupRegime = "Market Regime"

spxSymbol =
     input.symbol(
         "SP:SPX",
         "S&P 500 Symbol",
         group = groupRegime)

nasdaqSymbol =
     input.symbol(
         "NASDAQ:IXIC",
         "Nasdaq Composite Symbol",
         group = groupRegime)

dowSymbol =
     input.symbol(
         "TVC:DJI",
         "Dow Jones Symbol",
         group = groupRegime)


//=============================================================================
// INPUTS — DISPLAY
//=============================================================================

groupDisplay = "Display"

showORB =
     input.bool(
         true,
         "Show ORB High / Low",
         group = groupDisplay)

showBreakoutLabels =
     input.bool(
         true,
         "Show Breakout Labels",
         group = groupDisplay)

showBaselineTable =
     input.bool(
         true,
         "Show Baseline Table",
         group = groupDisplay)

showPathTable =
     input.bool(
         true,
         "Show Post-Breakout Path Table",
         group = groupDisplay)

showRetestTable =
     input.bool(
         true,
         "Show Retest Summary",
         group = groupDisplay)

showDebug =
     input.bool(
         false,
         "Show Debug Table",
         group = groupDisplay)


//=============================================================================
// HELPERS
//=============================================================================

f_clamp(float value, float minValue, float maxValue) =>
    math.max(
         minValue,
         math.min(
             maxValue,
             value))


f_grade(float score) =>
    score >= 95.0 ? "A+" :
     score >= 90.0 ? "A" :
     score >= 85.0 ? "A-" :
     score >= 80.0 ? "B+" :
     score >= 75.0 ? "B" :
     score >= 70.0 ? "B-" :
     score >= 65.0 ? "C+" :
     score >= 60.0 ? "C" :
     score >= 55.0 ? "C-" :
     "Weak"


f_minGradeScore(string grade) =>
    grade == "A+" ? 95.0 :
     grade == "A" ? 90.0 :
     grade == "A-" ? 85.0 :
     grade == "B+" ? 80.0 :
     grade == "B" ? 75.0 :
     grade == "B-" ? 70.0 :
     grade == "C+" ? 65.0 :
     grade == "C" ? 60.0 :
     grade == "C-" ? 55.0 :
     0.0


f_speedScore(int minuteOfDay) =>
    minuteOfDay < 600 ? 10.0 :
     minuteOfDay < 630 ? 8.0 :
     minuteOfDay < 660 ? 6.0 :
     minuteOfDay < 720 ? 4.0 :
     2.0


f_pct(float value) =>
    na(value)
     ? "—"
     : str.tostring(
         value,
         "#.##") + "%"


f_num(int value) =>
    str.tostring(value)


f_rate(int fav, int adv) =>
    int decisive =
         fav + adv

    decisive > 0
     ? float(fav) /
       float(decisive) *
       100.0
     : na


f_share(int hits, int population) =>
    population > 0
     ? float(hits) /
       float(population) *
       100.0
     : na


f_median(array<float> values) =>
    int n = array.size(values)
    if n == 0
        na
    else
        array<float> sorted = array.copy(values)
        array.sort(sorted, order.ascending)
        int mid = int(math.floor(n / 2))
        n % 2 == 1
         ? array.get(sorted, mid)
         : (array.get(sorted, mid - 1) + array.get(sorted, mid)) / 2.0


// Separation bucket based on checkpoint distance from broken ORB,
// expressed as % of frozen 1M ATR.
// 0 = <100%, 1 = 100-200%, 2 = 200-300%, 3 = >300%.
f_sepBucket(float sepAtrPct) =>
    na(sepAtrPct) ? -1 :
     sepAtrPct < 100.0 ? 0 :
     sepAtrPct < 200.0 ? 1 :
     sepAtrPct < 300.0 ? 2 :
     3


f_sepBucketName(int bucket) =>
    bucket == 0 ? "<100%" :
     bucket == 1 ? "100-200%" :
     bucket == 2 ? "200-300%" :
     bucket == 3 ? ">300%" :
     "Invalid"


// 10m -> 15m separation ratio study.
// Ratio = 15m separation / 10m separation.
//
// 0 = Strong Contraction   (<0.50)
// 1 = Moderate Contraction (0.50-0.79)
// 2 = Stable               (0.80-1.19)
// 3 = Moderate Expansion   (1.20-1.99)
// 4 = Strong Expansion     (>=2.00)
f_ratioBucket(float sep10, float sep15) =>
    na(sep10) or na(sep15) or sep10 <= 0.0
     ? -1
     : sep15 / sep10 < 0.50
       ? 0
       : sep15 / sep10 < 0.80
         ? 1
         : sep15 / sep10 < 1.20
           ? 2
           : sep15 / sep10 < 2.00
             ? 3
             : 4


f_ratioName(int bucket) =>
    bucket == 0 ? "Strong Contract" :
     bucket == 1 ? "Mod Contract" :
     bucket == 2 ? "Stable" :
     bucket == 3 ? "Mod Expand" :
     bucket == 4 ? "Strong Expand" :
     "Invalid"


// BUILD 5.3 — 10M QUALITY STUDY helpers.
// 0 = Low (<100% ATR)
// 1 = Established (100-300% ATR)
// 2 = Extended (>300% ATR)
f_qualitySepGroup(float sepAtrPct) =>
    na(sepAtrPct) ? -1 :
     sepAtrPct < 100.0 ? 0 :
     sepAtrPct <= 300.0 ? 1 :
     2

f_qualitySepName(int group) =>
    group == 0 ? "LOW <100%" :
     group == 1 ? "EST 100-300%" :
     group == 2 ? "EXT >300%" :
     "Invalid"

// Snapshot retest state.
// 0 = no retest, 1 = retest hold confirmed, 2 = retest failure,
// 3 = retest occurred but was still unresolved at the snapshot.
f_qualityRetestName(int state) =>
    state == 0 ? "NR" :
     state == 1 ? "RH" :
     state == 2 ? "RF" :
     state == 3 ? "RT OPEN" :
     "—"


f_auditTrajectoryClass(float ratio) =>
    na(ratio) ? -1 :
     ratio < 0.80 ? 0 :
     ratio < 1.20 ? 1 :
     2

f_extDepthBucket(float sepAtrPct) =>
    na(sepAtrPct) or sepAtrPct <= 300.0 ? -1 :
     sepAtrPct < 400.0 ? 0 :
     sepAtrPct < 600.0 ? 1 :
     2

f_extDepthName(int bucket) =>
    bucket == 0 ? "300-400%" :
     bucket == 1 ? "400-600%" :
     bucket == 2 ? ">600%" :
     "—"


f_contractSepBucket(float v) =>
    na(v) ? -1 :
     v < 150.0 ? 0 :
     v < 200.0 ? 1 :
     v < 250.0 ? 2 :
     v < 300.0 ? 3 :
     -1

f_contractMfeBucket(float v) =>
    na(v) ? -1 :
     v < 0.25 ? 0 :
     v < 0.50 ? 1 :
     v < 0.75 ? 2 :
     3

f_contractMaeBucket(float v) =>
    na(v) ? -1 :
     v < 0.10 ? 0 :
     v < 0.25 ? 1 :
     v < 0.40 ? 2 :
     3

f_contractQBucket(float v) =>
    na(v) ? -1 :
     v < 1.0 ? 0 :
     v < 2.0 ? 1 :
     v < 4.0 ? 2 :
     3

f_contractSeverityBucket(float ratio) =>
    na(ratio) or ratio >= 0.80 ? -1 :
     ratio < 0.50 ? 0 :
     ratio < 0.65 ? 1 :
     2

f_contractFailPct(int wins, int fails) =>
    int n = wins + fails
    n > 0 ? float(fails) / float(n) * 100.0 : na


f_date(int ts) =>
    na(ts)
     ? "—"
     : str.format_time(
         ts,
         "yyyy-MM-dd",
         TZ)


f_pathName(int path) =>
    path == PATH_NR_CONTINUE ? "NR Continue" :
     path == PATH_RETEST_CONTINUE ? "Retest Continue" :
     path == PATH_RETEST_FAIL ? "Retest Fail" :
     path == PATH_NR_FAIL ? "NR Fail" :
     path == PATH_RETEST_UNCONFIRMED ? "Retest Unconfirmed" :
     path == PATH_UNRESOLVED ? "Unresolved" :
     "Pending"


//=============================================================================
// TIMEFRAME + SESSION
//=============================================================================

bool isOneMinuteChart =
     timeframe.in_seconds(
         timeframe.period) == 60

int hh =
     hour(
         time,
         TZ)

int mm =
     minute(
         time,
         TZ)

int mins =
     hh * 60 + mm

bool isRTH =
     mins >= 570 and
     mins < 960

bool isORB =
     mins >= 570 and
     mins < 585

bool canTrigger =
     mins >= 585 and
     mins < 960

bool is930 =
     mins == 570

bool isLastRTH =
     mins == 959

bool afterStartDate =
     not useStartDate or
     time >= researchStart

bool beforeEndDate =
     not useEndDate or
     time <= researchEnd

bool researchEligible =
     isOneMinuteChart and
     afterStartDate and
     beforeEndDate


//=============================================================================
// ATR
//=============================================================================

float atr1m =
     ta.atr(
         atrLength)


//=============================================================================
// MARKET DATA
// Retained for future Build 4 regime analysis.
//=============================================================================

float spxOpen1m =
     request.security(
         spxSymbol,
         "1",
         open,
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off)

float spxClose1m =
     request.security(
         spxSymbol,
         "1",
         close,
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off)

float nasdaqOpen1m =
     request.security(
         nasdaqSymbol,
         "1",
         open,
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off)

float nasdaqClose1m =
     request.security(
         nasdaqSymbol,
         "1",
         close,
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off)

float dowOpen1m =
     request.security(
         dowSymbol,
         "1",
         open,
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off)

float dowClose1m =
     request.security(
         dowSymbol,
         "1",
         close,
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off)


float spxPrevClose =
     request.security(
         spxSymbol,
         "1D",
         close[1],
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_on)

float nasdaqPrevClose =
     request.security(
         nasdaqSymbol,
         "1D",
         close[1],
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_on)

float dowPrevClose =
     request.security(
         dowSymbol,
         "1D",
         close[1],
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_on)


//=============================================================================
// MARKET RTH OPEN
//=============================================================================

var float spxRthOpen = na
var float nasdaqRthOpen = na
var float dowRthOpen = na

if is930

    spxRthOpen :=
         spxOpen1m

    nasdaqRthOpen :=
         nasdaqOpen1m

    dowRthOpen :=
         dowOpen1m


float spxRthPct =
     not na(spxRthOpen) and
     spxRthOpen != 0.0
     ? (
         spxClose1m -
         spxRthOpen
       ) /
       spxRthOpen *
       100.0
     : na

float nasdaqRthPct =
     not na(nasdaqRthOpen) and
     nasdaqRthOpen != 0.0
     ? (
         nasdaqClose1m -
         nasdaqRthOpen
       ) /
       nasdaqRthOpen *
       100.0
     : na

float dowRthPct =
     not na(dowRthOpen) and
     dowRthOpen != 0.0
     ? (
         dowClose1m -
         dowRthOpen
       ) /
       dowRthOpen *
       100.0
     : na


float spxDailyPct =
     not na(spxPrevClose) and
     spxPrevClose != 0.0
     ? (
         spxClose1m -
         spxPrevClose
       ) /
       spxPrevClose *
       100.0
     : na

float nasdaqDailyPct =
     not na(nasdaqPrevClose) and
     nasdaqPrevClose != 0.0
     ? (
         nasdaqClose1m -
         nasdaqPrevClose
       ) /
       nasdaqPrevClose *
       100.0
     : na

float dowDailyPct =
     not na(dowPrevClose) and
     dowPrevClose != 0.0
     ? (
         dowClose1m -
         dowPrevClose
       ) /
       dowPrevClose *
       100.0
     : na


bool rthIndexesValid =
     not na(spxRthPct) and
     not na(nasdaqRthPct) and
     not na(dowRthPct)

bool dailyIndexesValid =
     not na(spxDailyPct) and
     not na(nasdaqDailyPct) and
     not na(dowDailyPct)


int currentRthRegime =
     REGIME_INVALID

if rthIndexesValid

    if spxRthPct > 0.0 and
       nasdaqRthPct > 0.0 and
       dowRthPct > 0.0

        currentRthRegime :=
             REGIME_BULL

    else if spxRthPct < 0.0 and nasdaqRthPct < 0.0 and dowRthPct < 0.0

        currentRthRegime :=
             REGIME_BEAR

    else

        currentRthRegime :=
             REGIME_MIXED


int currentDailyRegime =
     REGIME_INVALID

if dailyIndexesValid

    if spxDailyPct > 0.0 and
       nasdaqDailyPct > 0.0 and
       dowDailyPct > 0.0

        currentDailyRegime :=
             REGIME_BULL

    else if spxDailyPct < 0.0 and nasdaqDailyPct < 0.0 and dowDailyPct < 0.0

        currentDailyRegime :=
             REGIME_BEAR

    else

        currentDailyRegime :=
             REGIME_MIXED


//=============================================================================
// ORB
//=============================================================================

var float orbHigh = na
var float orbLow = na

if is930

    orbHigh :=
         high

    orbLow :=
         low

else if isORB

    orbHigh :=
         na(orbHigh)
         ? high
         : math.max(
             orbHigh,
             high)

    orbLow :=
         na(orbLow)
         ? low
         : math.min(
             orbLow,
             low)


//=============================================================================
// RESEARCH SAMPLE METADATA
//=============================================================================

var int firstAnalyzedDate = na
var int lastAnalyzedDate = na
var int analyzedDays = 0

if is930 and
   researchEligible

    analyzedDays += 1

    if na(firstAnalyzedDate)

        firstAnalyzedDate :=
             time

    lastAnalyzedDate :=
         time


//=============================================================================
// DAILY SIGNAL STATE
//=============================================================================

var bool signalTakenToday = false

if is930

    signalTakenToday :=
         false


//=============================================================================
// BASELINE STATISTICS
//=============================================================================

var int totalSignals = 0
var int completed = 0

var int bullishSignals = 0
var int bearishSignals = 0

var int favorableFirst = 0
var int adverseFirst = 0
var int bothSameBar = 0
var int unresolved = 0

var int hits025 = 0
var int hits075 = 0
var int hits100 = 0

var float totalMFE = 0.0
var float totalMAE = 0.0


//=============================================================================
// CHECKPOINT AGGREGATES
//=============================================================================

var int cp5NoRetestN = 0
var int cp10NoRetestN = 0
var int cp15NoRetestN = 0
var int cp30NoRetestN = 0

var int cp5ForwardN = 0
var int cp10ForwardN = 0
var int cp15ForwardN = 0
var int cp30ForwardN = 0

var int cp5Fav = 0
var int cp5Adv = 0
var int cp5Both = 0
var int cp5Unresolved = 0

var int cp10Fav = 0
var int cp10Adv = 0
var int cp10Both = 0
var int cp10Unresolved = 0

var int cp15Fav = 0
var int cp15Adv = 0
var int cp15Both = 0
var int cp15Unresolved = 0

var int cp30Fav = 0
var int cp30Adv = 0
var int cp30Both = 0
var int cp30Unresolved = 0

var float cp5SepAtrTotal = 0.0
var float cp10SepAtrTotal = 0.0
var float cp15SepAtrTotal = 0.0
var float cp30SepAtrTotal = 0.0


//=============================================================================
// BUILD 4.2 — NO-RETEST RUNNER AGGREGATES
//
// Each checkpoint cohort contains every breakout that has NOT retested by
// that checkpoint. These statistics are descriptive and independent of the
// stricter fresh ±0.50% forward test.
//
// EXTENSION = later session high/low reaches the stated favorable percentage
//             from the ORIGINAL breakout close.
// POST-CP MFE = maximum favorable excursion from the CHECKPOINT close,
//               beginning on the NEXT 1-minute bar.
// EVENTUAL RETEST = first ORB retest occurs AFTER that checkpoint.
// RETEST MIN = minutes from checkpoint close to that later first retest.
//=============================================================================

var int cp5Ext075 = 0
var int cp5Ext100 = 0
var int cp5Ext150 = 0
var int cp5Ext200 = 0
var float cp5PostMfeTotal = 0.0
