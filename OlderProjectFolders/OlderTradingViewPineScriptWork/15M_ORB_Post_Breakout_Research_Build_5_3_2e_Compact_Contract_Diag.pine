//=============================================================================
// PERFORMANCE CALCULATIONS
//=============================================================================

int decisive =
     favorableFirst +
     adverseFirst

float baselineFavRate =
     decisive > 0
     ? float(
         favorableFirst) /
       float(
         decisive) *
       100.0
     : na

float avgMFE =
     completed > 0
     ? totalMFE /
       float(
         completed)
     : na

float avgMAE =
     completed > 0
     ? totalMAE /
       float(
         completed)
     : na

float hit025Rate =
     completed > 0
