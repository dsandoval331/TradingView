//=============================================================================
// BUILD 4.4 — 10M / 15M ORB SEPARATION TABLE
//=============================================================================

var table separationTable =
     table.new(
         position.middle_center,
         9,
         9,
         border_width = 1)


if barstate.islast

    if showCheckpointTable

        table.cell(separationTable, 0, 0, "SEP STUDY", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(separationTable, 1, 0, "BUCKET", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(separationTable, 2, 0, "N", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(separationTable, 3, 0, "AVG MFE", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(separationTable, 4, 0, "MED MFE", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(separationTable, 5, 0, "AVG MAE", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(separationTable, 6, 0, "MED MAE", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(separationTable, 7, 0, ".50/.75/1.0", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(separationTable, 8, 0, "RETEST", bgcolor = color.new(color.blue, 75), text_color = color.white)

        for b = 0 to 3
            int row10 = b + 1
            int n10 = array.get(sep10N, b)
            float avg10Mfe = f_bucketAvg(sep10MfeTotal, sep10N, b)
            float avg10Mae = f_bucketAvg(sep10MaeTotal, sep10N, b)
            float hit10_50 = f_bucketRate(sep10Hit050, sep10N, b)
            float hit10_75 = f_bucketRate(sep10Hit075, sep10N, b)
            float hit10_100 = f_bucketRate(sep10Hit100, sep10N, b)
            float rt10 = f_bucketRate(sep10RetestN, sep10N, b)

            table.cell(separationTable, 0, row10, "10m")
            table.cell(separationTable, 1, row10, f_sepBucketName(b))
            table.cell(separationTable, 2, row10, f_num(n10))
            table.cell(separationTable, 3, row10, f_pct(avg10Mfe))
            table.cell(separationTable, 4, row10, f_pct(f_sep10MedMFE(b)))
            table.cell(separationTable, 5, row10, f_pct(avg10Mae))
            table.cell(separationTable, 6, row10, f_pct(f_sep10MedMAE(b)))
            table.cell(separationTable, 7, row10, f_pct(hit10_50) + "/" + f_pct(hit10_75) + "/" + f_pct(hit10_100))
            table.cell(separationTable, 8, row10, f_pct(rt10))

        for b = 0 to 3
            int row15 = b + 5
            int n15 = array.get(sep15N, b)
            float avg15Mfe = f_bucketAvg(sep15MfeTotal, sep15N, b)
            float avg15Mae = f_bucketAvg(sep15MaeTotal, sep15N, b)
            float hit15_50 = f_bucketRate(sep15Hit050, sep15N, b)
            float hit15_75 = f_bucketRate(sep15Hit075, sep15N, b)
            float hit15_100 = f_bucketRate(sep15Hit100, sep15N, b)
            float rt15 = f_bucketRate(sep15RetestN, sep15N, b)

            table.cell(separationTable, 0, row15, "15m")
            table.cell(separationTable, 1, row15, f_sepBucketName(b))
            table.cell(separationTable, 2, row15, f_num(n15))
            table.cell(separationTable, 3, row15, f_pct(avg15Mfe))
            table.cell(separationTable, 4, row15, f_pct(f_sep15MedMFE(b)))
            table.cell(separationTable, 5, row15, f_pct(avg15Mae))
            table.cell(separationTable, 6, row15, f_pct(f_sep15MedMAE(b)))
            table.cell(separationTable, 7, row15, f_pct(hit15_50) + "/" + f_pct(hit15_75) + "/" + f_pct(hit15_100))
            table.cell(separationTable, 8, row15, f_pct(rt15))

    else

        table.clear(
             separationTable,
             0,
             0,
             8,
             8)


//=============================================================================
// BUILD 4.6 — 10M -> 15M TRAJECTORY RATIO TABLE
//=============================================================================

var table ratioTable =
     table.new(
         position.middle_left,
         11,
         10,
         border_width = 1)


if barstate.islast

    if showCheckpointTable

        table.cell(ratioTable, 0, 0, "RATIO STUDY", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(ratioTable, 1, 0, "N", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(ratioTable, 2, 0, "AVG RATIO", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(ratioTable, 3, 0, "10M SEP", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(ratioTable, 4, 0, "15M SEP", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(ratioTable, 5, 0, "AVG MFE", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(ratioTable, 6, 0, "MED MFE", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(ratioTable, 7, 0, "AVG MAE", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(ratioTable, 8, 0, "MED MAE", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(ratioTable, 9, 0, ".50/.75/1.0", bgcolor = color.new(color.blue, 75), text_color = color.white)
        table.cell(ratioTable, 10, 0, "RETEST", bgcolor = color.new(color.blue, 75), text_color = color.white)

        for rb = 0 to 4
            int row = rb + 1
            int n = array.get(ratioN, rb)

            table.cell(ratioTable, 0, row, f_ratioName(rb))
            table.cell(ratioTable, 1, row, f_num(n))
            table.cell(ratioTable, 2, row, na(f_ratioAvg(ratioValueTotal, rb)) ? "—" : str.tostring(f_ratioAvg(ratioValueTotal, rb), "#.##"))
            table.cell(ratioTable, 3, row, f_pct(f_ratioAvg(ratioSep10Total, rb)))
            table.cell(ratioTable, 4, row, f_pct(f_ratioAvg(ratioSep15Total, rb)))
            table.cell(ratioTable, 5, row, f_pct(f_ratioAvg(ratioMfeTotal, rb)))
            table.cell(ratioTable, 6, row, f_pct(f_ratioMedMFE(rb)))
            table.cell(ratioTable, 7, row, f_pct(f_ratioAvg(ratioMaeTotal, rb)))
            table.cell(ratioTable, 8, row, f_pct(f_ratioMedMAE(rb)))
            table.cell(
                 ratioTable,
                 9,
                 row,
                 f_pct(f_ratioRate(ratioHit050, rb)) + "/" +
                 f_pct(f_ratioRate(ratioHit075, rb)) + "/" +
                 f_pct(f_ratioRate(ratioHit100, rb)))
            table.cell(ratioTable, 10, row, f_pct(f_ratioRate(ratioRetestN, rb)))

        // BUILD 5.3 — Strong Expansion split. Kept in the same panel to
        // avoid adding another chart-position collision.
        table.cell(ratioTable, 0, 7, "STRONG EXP STUDY", bgcolor = color.new(color.orange, 70), text_color = color.white)
        table.cell(ratioTable, 1, 7, "N", bgcolor = color.new(color.orange, 70), text_color = color.white)
        table.cell(ratioTable, 2, 7, "", bgcolor = color.new(color.orange, 70))
        table.cell(ratioTable, 3, 7, "", bgcolor = color.new(color.orange, 70))
        table.cell(ratioTable, 4, 7, "", bgcolor = color.new(color.orange, 70))
        table.cell(ratioTable, 5, 7, "AVG MFE", bgcolor = color.new(color.orange, 70), text_color = color.white)
        table.cell(ratioTable, 6, 7, "MED MFE", bgcolor = color.new(color.orange, 70), text_color = color.white)
        table.cell(ratioTable, 7, 7, "AVG MAE", bgcolor = color.new(color.orange, 70), text_color = color.white)
        table.cell(ratioTable, 8, 7, "MED MAE", bgcolor = color.new(color.orange, 70), text_color = color.white)
        table.cell(ratioTable, 9, 7, ".50/.75/1.0", bgcolor = color.new(color.orange, 70), text_color = color.white)
        table.cell(ratioTable, 10, 7, "RETEST", bgcolor = color.new(color.orange, 70), text_color = color.white)

        for sg = 0 to 1
            int seRow = sg + 8
            int seN = array.get(strongExpSepN, sg)
            table.cell(ratioTable, 0, seRow, f_strongExpGroupName(sg))
            table.cell(ratioTable, 1, seRow, f_num(seN))
            table.cell(ratioTable, 2, seRow, "")
            table.cell(ratioTable, 3, seRow, "")
            table.cell(ratioTable, 4, seRow, "")
            table.cell(ratioTable, 5, seRow, f_pct(f_strongExpAvg(strongExpSepMfeTotal, sg)))
            table.cell(ratioTable, 6, seRow, f_pct(f_strongExpMedMFE(sg)))
            table.cell(ratioTable, 7, seRow, f_pct(f_strongExpAvg(strongExpSepMaeTotal, sg)))
            table.cell(ratioTable, 8, seRow, f_pct(f_strongExpMedMAE(sg)))
            table.cell(
                 ratioTable,
                 9,
                 seRow,
                 f_pct(f_strongExpRate(strongExpSepHit050, sg)) + "/" +
                 f_pct(f_strongExpRate(strongExpSepHit075, sg)) + "/" +
                 f_pct(f_strongExpRate(strongExpSepHit100, sg)))
            table.cell(ratioTable, 10, seRow, f_pct(f_strongExpRate(strongExpSepRetestN, sg)))

    else

        table.clear(
             ratioTable,
             0,
             0,
             10,
             9)



//=============================================================================
// BUILD 5.3 — 10M QUALITY STUDY TABLE
//
// Population: all active breakouts that reached the 10m timestamp.
// SEP groups are intentionally broad to avoid threshold overfitting:
// Low <100%, Established 100-300%, Extended >300% of frozen 1M ATR.
// Q = 10m MFE / max(10m MAE, 0.01%).
// RT column = NR / RH / RF / RT OPEN counts observed at 10m.
// TRAJ = average 15m separation / 10m separation where 15m was available.
// .50F is original +0.50% favorable-first rate; .75/1.0 are eventual hits.
//=============================================================================

var table qualityTable =
     table.new(
         position.bottom_center,
         10,
         4,
         border_width = 1)

if barstate.islast

    if showCheckpointTable

        table.cell(qualityTable, 0, 0, "10M QUALITY", bgcolor = color.new(color.purple, 70), text_color = color.white)
        table.cell(qualityTable, 1, 0, "N", bgcolor = color.new(color.purple, 70), text_color = color.white)
        table.cell(qualityTable, 2, 0, "10M MFE", bgcolor = color.new(color.purple, 70), text_color = color.white)
        table.cell(qualityTable, 3, 0, "10M MAE", bgcolor = color.new(color.purple, 70), text_color = color.white)
        table.cell(qualityTable, 4, 0, "Q MFE/MAE", bgcolor = color.new(color.purple, 70), text_color = color.white)
        table.cell(qualityTable, 5, 0, "RT @10M", bgcolor = color.new(color.purple, 70), text_color = color.white)
        table.cell(qualityTable, 6, 0, "AVG TRAJ", bgcolor = color.new(color.purple, 70), text_color = color.white)
        table.cell(qualityTable, 7, 0, ".50F", bgcolor = color.new(color.purple, 70), text_color = color.white)
        table.cell(qualityTable, 8, 0, ".75", bgcolor = color.new(color.purple, 70), text_color = color.white)
        table.cell(qualityTable, 9, 0, "1.0", bgcolor = color.new(color.purple, 70), text_color = color.white)

        for qg = 0 to 2
            int row = qg + 1
            int qn = array.get(qualityN, qg)

            string rtText =
                 str.tostring(array.get(qualityNR, qg)) + "/" +
                 str.tostring(array.get(qualityRH, qg)) + "/" +
                 str.tostring(array.get(qualityRF, qg)) + "/" +
                 str.tostring(array.get(qualityRTOpen, qg))

            table.cell(qualityTable, 0, row, f_qualitySepName(qg))
            table.cell(qualityTable, 1, row, f_num(qn))
            table.cell(qualityTable, 2, row, f_pct(f_qualityAvg(qualityMfe10Total, qg)))
            table.cell(qualityTable, 3, row, f_pct(f_qualityAvg(qualityMae10Total, qg)))
            table.cell(qualityTable, 4, row, na(f_qualityAvg(qualityRatio10Total, qg)) ? "—" : str.tostring(f_qualityAvg(qualityRatio10Total, qg), "#.##"))
            table.cell(qualityTable, 5, row, rtText)
            table.cell(qualityTable, 6, row, na(f_qualityTrajectoryAvg(qg)) ? "—" : str.tostring(f_qualityTrajectoryAvg(qg), "#.##"))
            table.cell(qualityTable, 7, row, f_pct(f_qualityRate(qualityFav050, qg)))
            table.cell(qualityTable, 8, row, f_pct(f_qualityRate(qualityHit075, qg)))
            table.cell(qualityTable, 9, row, f_pct(f_qualityRate(qualityHit100, qg)))

    else
        table.clear(qualityTable, 0, 0, 9, 3)



//=============================================================================
// BUILD 5.3.2 — FAILURE AUDIT / CONTRACT DIAGNOSTIC TABLE
//=============================================================================
var table failureAuditTable = table.new(position.top_center, 5, 20, border_width = 1)

f_renderContractDiagnostic(t) =>
    table.clear(t, 0, 0, 4, 19)

    int cWin = array.get(contractDiagN, 0)
    int cFail = array.get(contractDiagN, 1)

    table.cell(t, 0, 0, "CONTRACT DIAG 5.3.2e", bgcolor = color.new(color.purple, 55), text_color = color.white)
    table.cell(t, 1, 0, "WIN", bgcolor = color.new(color.purple, 55), text_color = color.white)
    table.cell(t, 2, 0, "FAIL", bgcolor = color.new(color.purple, 55), text_color = color.white)
    table.cell(t, 3, 0, "FAIL %", bgcolor = color.new(color.purple, 55), text_color = color.white)
    table.cell(t, 4, 0, "N", bgcolor = color.new(color.purple, 55), text_color = color.white)

    table.cell(t, 0, 1, "TOTAL")
    table.cell(t, 1, 1, f_num(cWin))
    table.cell(t, 2, 1, f_num(cFail))
    table.cell(t, 3, 1, f_pct(f_contractFailPct(cWin, cFail)))
    table.cell(t, 4, 1, f_num(cWin + cFail))

    table.cell(t, 0, 2, "AVG 10M SEP")
    table.cell(t, 1, 2, f_pct(f_contractAvg(contractDiagSepTotal, 0)))
    table.cell(t, 2, 2, f_pct(f_contractAvg(contractDiagSepTotal, 1)))
    table.cell(t, 0, 3, "AVG 10M MFE")
    table.cell(t, 1, 3, f_pct(f_contractAvg(contractDiagMfeTotal, 0)))
    table.cell(t, 2, 3, f_pct(f_contractAvg(contractDiagMfeTotal, 1)))
    table.cell(t, 0, 4, "AVG 10M MAE")
    table.cell(t, 1, 4, f_pct(f_contractAvg(contractDiagMaeTotal, 0)))
    table.cell(t, 2, 4, f_pct(f_contractAvg(contractDiagMaeTotal, 1)))
    table.cell(t, 0, 5, "AVG Q")
    table.cell(t, 1, 5, na(f_contractAvg(contractDiagQTotal, 0)) ? "—" : str.tostring(f_contractAvg(contractDiagQTotal, 0), "#.##"))
    table.cell(t, 2, 5, na(f_contractAvg(contractDiagQTotal, 1)) ? "—" : str.tostring(f_contractAvg(contractDiagQTotal, 1), "#.##"))
    table.cell(t, 0, 6, "BULL / BEAR")
    table.cell(t, 1, 6, f_num(array.get(contractDiagBull, 0)) + " / " + f_num(array.get(contractDiagBear, 0)))
    table.cell(t, 2, 6, f_num(array.get(contractDiagBull, 1)) + " / " + f_num(array.get(contractDiagBear, 1)))

    string[] stateNames = array.from("NR @10M","RH @10M","RF @10M","RT OPEN")
    for b = 0 to 3
        int row = 8 + b
        int w = f_contractCount(contractState, b, 0)
        int f = f_contractCount(contractState, b, 1)
        table.cell(t, 0, row, array.get(stateNames, b))
        table.cell(t, 1, row, f_num(w))
        table.cell(t, 2, row, f_num(f))
        table.cell(t, 3, row, f_pct(f_contractFailPct(w, f)))
        table.cell(t, 4, row, f_num(w + f))

    string[] sepNames = array.from("SEP 100-150","SEP 150-200","SEP 200-250","SEP 250-300")
    for b = 0 to 3
        int row = 13 + b
        int w = f_contractCount(contractSep, b, 0)
        int f = f_contractCount(contractSep, b, 1)
        table.cell(t, 0, row, array.get(sepNames, b))
        table.cell(t, 1, row, f_num(w))
        table.cell(t, 2, row, f_num(f))
        table.cell(t, 3, row, f_pct(f_contractFailPct(w, f)))
        table.cell(t, 4, row, f_num(w + f))

    string[] mfeNames = array.from("MFE <.25","MFE .25-.50","MFE .50-.75","MFE >=.75")
    for b = 0 to 3
        int row = 18 + b
        int w = f_contractCount(contractMfe, b, 0)
        int f = f_contractCount(contractMfe, b, 1)
        table.cell(t, 0, row, array.get(mfeNames, b))
        table.cell(t, 1, row, f_num(w))
        table.cell(t, 2, row, f_num(f))
        table.cell(t, 3, row, f_pct(f_contractFailPct(w, f)))
        table.cell(t, 4, row, f_num(w + f))

    string[] maeNames = array.from("MAE <.10","MAE .10-.25","MAE .25-.40","MAE >=.40")
    for b = 0 to 3
        int row = 23 + b
        int w = f_contractCount(contractMae, b, 0)
        int f = f_contractCount(contractMae, b, 1)
        table.cell(t, 0, row, array.get(maeNames, b))
        table.cell(t, 1, row, f_num(w))
        table.cell(t, 2, row, f_num(f))
        table.cell(t, 3, row, f_pct(f_contractFailPct(w, f)))
        table.cell(t, 4, row, f_num(w + f))

    string[] qNames = array.from("Q <1","Q 1-2","Q 2-4","Q >4")
    for b = 0 to 3
        int row = 28 + b
        int w = f_contractCount(contractQ, b, 0)
        int f = f_contractCount(contractQ, b, 1)
        table.cell(t, 0, row, array.get(qNames, b))
        table.cell(t, 1, row, f_num(w))
        table.cell(t, 2, row, f_num(f))
        table.cell(t, 3, row, f_pct(f_contractFailPct(w, f)))
        table.cell(t, 4, row, f_num(w + f))

    string[] sevNames = array.from("SEV <.50","MOD .50-.65","MILD .65-.80")
    for b = 0 to 2
        int row = 32 + b
        int w = f_contractCount(contractSeverity, b, 0)
        int f = f_contractCount(contractSeverity, b, 1)
        table.cell(t, 0, row, array.get(sevNames, b))
        table.cell(t, 1, row, f_num(w))
        table.cell(t, 2, row, f_num(f))
        table.cell(t, 3, row, f_pct(f_contractFailPct(w, f)))
        table.cell(t, 4, row, f_num(w + f))

f_renderFailureAudit(t) =>
    table.clear(t, 0, 0, 4, 19)

    table.cell(t, 0, 0, "FAILURE AUDIT", bgcolor = color.new(color.maroon, 65), text_color = color.white)
    table.cell(t, 1, 0, "EST WIN", bgcolor = color.new(color.maroon, 65), text_color = color.white)
    table.cell(t, 2, 0, "EST FAIL", bgcolor = color.new(color.maroon, 65), text_color = color.white)
    table.cell(t, 3, 0, "EXT WIN", bgcolor = color.new(color.maroon, 65), text_color = color.white)
    table.cell(t, 4, 0, "EXT FAIL", bgcolor = color.new(color.maroon, 65), text_color = color.white)

    string[] labels = array.from(
         "N","NR @10M","RH @10M","RF @10M","RT OPEN",
         "CONTRACT","STABLE","EXPAND","NO 15M","BULL","BEAR",
         "AVG 10M SEP","AVG 10M MFE","AVG 10M MAE","AVG Q")

    for r = 0 to 14
        table.cell(t, 0, r + 1, array.get(labels, r))

    for c = 0 to 3
        int col = c + 1
        table.cell(t, col, 1, f_num(array.get(auditN, c)))
        table.cell(t, col, 2, f_num(array.get(auditNR, c)))
        table.cell(t, col, 3, f_num(array.get(auditRH, c)))
        table.cell(t, col, 4, f_num(array.get(auditRF, c)))
        table.cell(t, col, 5, f_num(array.get(auditRTOpen, c)))
        table.cell(t, col, 6, f_num(array.get(auditContract, c)))
        table.cell(t, col, 7, f_num(array.get(auditStable, c)))
        table.cell(t, col, 8, f_num(array.get(auditExpand, c)))
        table.cell(t, col, 9, f_num(array.get(auditNo15, c)))
        table.cell(t, col, 10, f_num(array.get(auditBull, c)))
        table.cell(t, col, 11, f_num(array.get(auditBear, c)))
        table.cell(t, col, 12, f_pct(f_auditAvg(auditSep10Total, c)))
        table.cell(t, col, 13, f_pct(f_auditAvg(auditMfe10Total, c)))
        table.cell(t, col, 14, f_pct(f_auditAvg(auditMae10Total, c)))
        table.cell(t, col, 15, na(f_auditAvg(auditQ10Total, c)) ? "—" : str.tostring(f_auditAvg(auditQ10Total, c), "#.##"))

    table.cell(t, 0, 16, "BOTH / U")
    table.cell(t, 1, 16, f_num(auditEstBoth) + " / " + f_num(auditEstUnresolved))
    table.cell(t, 3, 16, f_num(auditExtBoth) + " / " + f_num(auditExtUnresolved))
    table.cell(t, 0, 17, "Trajectory = 10→15m")

if barstate.islast
    if showCheckpointTable and showContractDiagnostic
        f_renderContractDiagnostic(failureAuditTable)
    else if showCheckpointTable
        f_renderFailureAudit(failureAuditTable)
    else
        table.clear(failureAuditTable, 0, 0, 4, 34)


