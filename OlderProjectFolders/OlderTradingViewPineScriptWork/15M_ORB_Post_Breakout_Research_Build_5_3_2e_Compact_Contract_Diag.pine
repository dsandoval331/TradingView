//=============================================================================
// BUILD 5.3.2 — EST CONTRACT DIAGNOSTIC AGGREGATES
// 0 = EST CONTRACT WIN, 1 = EST CONTRACT FAIL
//=============================================================================

var array<int> contractDiagN = array.new_int(2, 0)
var array<float> contractDiagSepTotal = array.new_float(2, 0.0)
var array<float> contractDiagMfeTotal = array.new_float(2, 0.0)
var array<float> contractDiagMaeTotal = array.new_float(2, 0.0)
var array<float> contractDiagQTotal = array.new_float(2, 0.0)
var array<int> contractDiagBull = array.new_int(2, 0)
var array<int> contractDiagBear = array.new_int(2, 0)

// Flattened arrays: index = bucket * 2 + outcome column.
var array<int> contractState = array.new_int(8, 0)
var array<int> contractSep = array.new_int(8, 0)
var array<int> contractMfe = array.new_int(8, 0)
var array<int> contractMae = array.new_int(8, 0)
var array<int> contractQ = array.new_int(8, 0)
var array<int> contractSeverity = array.new_int(6, 0)

f_contractIdx(int bucket, int outcomeCol) =>
    bucket >= 0 and outcomeCol >= 0 ? bucket * 2 + outcomeCol : -1

f_contractCount(array<int> a, int bucket, int outcomeCol) =>
    int idx = f_contractIdx(bucket, outcomeCol)
    idx >= 0 ? array.get(a, idx) : 0

f_contractAvg(array<float> totals, int outcomeCol) =>
    int n = array.get(contractDiagN, outcomeCol)
    n > 0 ? array.get(totals, outcomeCol) / float(n) : na

//=============================================================================
// BUILD 5.3 — EXT DEPTH AGGREGATES
//=============================================================================

var array<int> extDepthN = array.new_int(3, 0)
var array<int> extDepthFav050 = array.new_int(3, 0)
var array<int> extDepthHit075 = array.new_int(3, 0)
var array<int> extDepthHit100 = array.new_int(3, 0)
var array<float> extDepthMfeTotal = array.new_float(3, 0.0)
var array<float> extDepthMaeTotal = array.new_float(3, 0.0)

f_extDepthAvg(array<float> totals, int bucket) =>
    int n = array.get(extDepthN, bucket)
    n > 0 ? array.get(totals, bucket) / float(n) : na

f_extDepthRate(array<int> hits, int bucket) =>
    int n = array.get(extDepthN, bucket)
    n > 0 ? float(array.get(hits, bucket)) / float(n) * 100.0 : na


//=============================================================================
// ACTIVE RETEST STATE
//=============================================================================

var bool firstRetestOccurred = false
var int firstRetestTime = na

var float preRetestMFE = 0.0
var float preRetestMAE = 0.0

var float maxWickPenAtrPct = 0.0
var float maxClosePenAtrPct = 0.0

// Stops first-retest penetration measurements after
// confirmation or provisional failure.
var bool retestPenetrationFrozen = false

var bool provisionalFailure = false
var int failureTime = na

var bool retestConfirmed = false
var int confirmationTime = na
var float confirmationPrice = na

var bool reclaimedAfterFailure = false
var int reclaimTime = na

var int retestCount = 0

var bool inRetestZonePrev = false


//=============================================================================
// ACTIVE REGIME SNAPSHOT
//=============================================================================

var int breakoutRthRegime = REGIME_INVALID
var int breakoutDailyRegime = REGIME_INVALID


//=============================================================================
// BREAKOUT CANDLE METRICS
//=============================================================================

bool validORB =
     not na(orbHigh) and
     not na(orbLow)

float candleRange =
     high - low

float candleBody =
     math.abs(
         close -
         open)

float bodyPct =
     candleRange > 0.0
     ? candleBody /
       candleRange *
       100.0
     : 0.0

bool bullDirectional =
     close > open

bool bearDirectional =
     close < open


float bullPenetration =
     validORB
     ? math.max(
         close -
         orbHigh,
         0.0)
     : 0.0

float bearPenetration =
     validORB
     ? math.max(
         orbLow -
         close,
         0.0)
     : 0.0


float bullPenetrationPct =
     atr1m > 0.0
     ? bullPenetration /
       atr1m *
       100.0
     : 0.0

float bearPenetrationPct =
     atr1m > 0.0
     ? bearPenetration /
       atr1m *
       100.0
     : 0.0


float bullClosePct =
     candleRange > 0.0
     ? (
         close -
         low
       ) /
       candleRange *
       100.0
     : 0.0

float bearClosePct =
     candleRange > 0.0
     ? (
         high -
         close
       ) /
       candleRange *
       100.0
     : 0.0


float rangeAtrPct =
     atr1m > 0.0
     ? candleRange /
       atr1m *
       100.0
     : 0.0


//=============================================================================
// STRENGTH SCORE
//=============================================================================

float bullPenScore =
     f_clamp(
         bullPenetrationPct /
         50.0 *
         30.0,
         0.0,
         30.0)

float bearPenScore =
     f_clamp(
         bearPenetrationPct /
         50.0 *
         30.0,
         0.0,
         30.0)

float bodyScore =
     f_clamp(
         bodyPct /
         100.0 *
         25.0,
         0.0,
         25.0)

float bullCloseScore =
     f_clamp(
         bullClosePct /
         100.0 *
         20.0,
         0.0,
         20.0)

float bearCloseScore =
     f_clamp(
         bearClosePct /
         100.0 *
         20.0,
         0.0,
         20.0)

float rangeScore =
     f_clamp(
         rangeAtrPct /
         150.0 *
         15.0,
         0.0,
         15.0)

float speedScore =
     f_speedScore(
         mins)

float bullScore =
     enableStrengthScore
     ? bullPenScore +
       bodyScore +
       bullCloseScore +
       rangeScore +
       speedScore
     : 0.0

float bearScore =
     enableStrengthScore
     ? bearPenScore +
       bodyScore +
       bearCloseScore +
       rangeScore +
       speedScore
     : 0.0


//=============================================================================
// FILTERS
//=============================================================================

float requiredGradeScore =
     f_minGradeScore(
         minimumGrade)

bool bullDirectionalOK =
     not reqDirectional or
     bullDirectional

bool bearDirectionalOK =
     not reqDirectional or
     bearDirectional

bool bullPenOK =
     not reqPenetration or
     bullPenetrationPct >=
     minPenetrationPct

bool bearPenOK =
     not reqPenetration or
     bearPenetrationPct >=
     minPenetrationPct

bool bodyOK =
     not reqBody or
     bodyPct >=
     minBodyPct

bool rangeOK =
     not reqRange or
     rangeAtrPct >=
     minRangeAtrPct

bool bullCloseOK =
     not reqClosePosition or
     bullClosePct >=
     minClosePositionPct

bool bearCloseOK =
     not reqClosePosition or
     bearClosePct >=
     minClosePositionPct

bool bullGradeOK =
     not reqMinimumGrade or
     bullScore >=
     requiredGradeScore

bool bearGradeOK =
     not reqMinimumGrade or
     bearScore >=
     requiredGradeScore


//=============================================================================
// BREAKOUT DETECTION
//=============================================================================

bool rawBull =
     researchEligible and
     canTrigger and
     validORB and
     not signalTakenToday and
     close > orbHigh

bool rawBear =
     researchEligible and
     canTrigger and
     validORB and
     not signalTakenToday and
     close < orbLow

bool bullBreak =
     rawBull and
     bullDirectionalOK and
     bullPenOK and
     bodyOK and
     rangeOK and
     bullCloseOK and
     bullGradeOK

bool bearBreak =
     rawBear and
     bearDirectionalOK and
     bearPenOK and
     bodyOK and
     rangeOK and
     bearCloseOK and
     bearGradeOK


//=============================================================================
// NEW BREAKOUT INITIALIZATION
//=============================================================================

if bullBreak or bearBreak

    signalTakenToday :=
         true

    activeSignal :=
         true

    activeDir :=
         bullBreak
         ? 1
         : -1

    entryPrice :=
         close

    entryTime :=
         time

    frozenAtr :=
         atr1m

    brokenOrbLevel :=
         activeDir == 1
         ? orbHigh
         : orbLow

    retestTolerance :=
         frozenAtr *
         (
             retestZoneAtrPct /
             100.0
         )

    failureTolerance :=
         frozenAtr *
         (
             failureAtrPct /
             100.0
         )

    retestUpper :=
         brokenOrbLevel +
         retestTolerance

    retestLower :=
         brokenOrbLevel -
         retestTolerance


    primaryOutcome :=
         0

    hit025 :=
         false

    hit075 :=
         false

    hit100 :=
         false

    mfePct :=
         0.0

    maePct :=
         0.0

    activePath :=
         PATH_NONE


    firstRetestOccurred :=
         false

    firstRetestTime :=
         na

    preRetestMFE :=
         0.0

    preRetestMAE :=
         0.0

    maxWickPenAtrPct :=
         0.0

    maxClosePenAtrPct :=
         0.0

    retestPenetrationFrozen :=
         false

    provisionalFailure :=
         false

    failureTime :=
         na

    retestConfirmed :=
         false

    confirmationTime :=
         na

    confirmationPrice :=
         na

    reclaimedAfterFailure :=
         false

    reclaimTime :=
         na

    retestCount :=
         0

    inRetestZonePrev :=
         false


    breakoutRthRegime :=
         currentRthRegime

    breakoutDailyRegime :=
         currentDailyRegime


    totalSignals += 1

    if activeDir == 1
        bullishSignals += 1
    else
        bearishSignals += 1


    cp5Captured := false
    cp10Captured := false
    cp15Captured := false
    cp30Captured := false

    cp5ForwardEligible := false
    cp10ForwardEligible := false
    cp15ForwardEligible := false
    cp30ForwardEligible := false

    cp5Entry := na
    cp10Entry := na
    cp15Entry := na
    cp30Entry := na

    cp5Time := na
    cp10Time := na
    cp15Time := na
    cp30Time := na

    cp5Outcome := 0
    cp10Outcome := 0
    cp15Outcome := 0
    cp30Outcome := 0

    cp10SepBucket := -1
    cp15SepBucket := -1

    cp10SepAtrPct := na
    cp15SepAtrPct := na
    cpTrajectoryRatio := na
    cpRatioBucket := -1

    cp5PostMFE := 0.0
    cp10PostMFE := 0.0
    cp15PostMFE := 0.0
    cp30PostMFE := 0.0

    cp5EventualRetest := false
    cp10EventualRetest := false
    cp15EventualRetest := false
    cp30EventualRetest := false

    cp5EventualRetestTime := na
    cp10EventualRetestTime := na
    cp15EventualRetestTime := na
    cp30EventualRetestTime := na

    cp5WindowMFE := 0.0
    cp5WindowMAE := 0.0
    cp10WindowMFE := 0.0
    cp10WindowMAE := 0.0
    cp15WindowMFE := 0.0
    cp15WindowMAE := 0.0

    quality10Captured := false
    quality15Captured := false
    quality10SepAtrPct := na
    quality15SepAtrPct := na
    quality10SepGroup := -1
    quality10MFE := na
    quality10MAE := na
    quality10Ratio := na
    quality10RetestState := -1
    qualityTrajectoryRatio := na
    auditEligible := false
    auditSepGroup := -1
    auditDir := 0
    auditSep10 := na
    auditMfe10 := na
    auditMae10 := na
    auditQ10 := na
    auditRetestState10 := -1
    auditTrajectoryRatio := na
    auditTrajectoryClass := -1
    cp30WindowMFE := 0.0
    cp30WindowMAE := 0.0


//=============================================================================
// BREAKOUT LABEL
//=============================================================================

if showBreakoutLabels and
   (bullBreak or bearBreak)

    float activeScoreNow =
         bullBreak
         ? bullScore
         : bearScore

    string gradeText =
         showScoreOnLabel and
         enableStrengthScore
         ? "\n" +
           f_grade(
               activeScoreNow) +
           " · " +
           str.tostring(
               activeScoreNow,
               "#.0")
         : ""

    label.new(
         time,
         close,
         activeDir == 1
         ? "ORB LONG\n" +
           str.tostring(
               close,
               format.mintick) +
           gradeText
         : "ORB SHORT\n" +
           str.tostring(
               close,
               format.mintick) +
           gradeText,
         xloc = xloc.bar_time,
         yloc = yloc.price,
         style =
             activeDir == 1
             ? label.style_label_up
             : label.style_label_down,
         color =
             activeDir == 1
             ? color.new(
                 color.green,
                 0)
             : color.new(
                 color.red,
                 0),
         textcolor =
             color.white, 
         size =
             size.small)


//=============================================================================
// ACTIVE POST-BREAKOUT ENGINE
//=============================================================================

//=============================================================================
// POST-ENTRY BAR STATE
//=============================================================================

bool postEntryBar =
     activeSignal and
     not na(entryTime) and
     time > entryTime and
     isRTH


// These are declared at bar scope so every post-breakout
// research section can reference the same values.

float favorableMove = na
float adverseMove = na


if postEntryBar

    //---------------------------------------------------------------------
    // FAVORABLE / ADVERSE EXCURSION
    //---------------------------------------------------------------------

    if activeDir == 1

        // Bullish ORB breakout
        favorableMove :=
             (high - entryPrice) /
             entryPrice *
             100.0

        adverseMove :=
             (entryPrice - low) /
             entryPrice *
             100.0

    else if activeDir == -1

        // Bearish ORB breakout
        favorableMove :=
             (entryPrice - low) /
             entryPrice *
             100.0

        adverseMove :=
             (high - entryPrice) /
             entryPrice *
             100.0


    int minutesSinceBreakout =
         int(
             (time - entryTime) /
             60000)


    mfePct :=
         math.max(
             mfePct,
             favorableMove)

    maePct :=
         math.max(
             maePct,
             adverseMove)


    float currentOrbSeparation =
         activeDir == 1
         ? close - brokenOrbLevel
         : brokenOrbLevel - close

    float currentOrbSepAtrPct =
         frozenAtr > 0.0
         ? currentOrbSeparation /
           frozenAtr *
           100.0
         : na


    //---------------------------------------------------------------------
    // PRE-RETEST EXCURSION
    //---------------------------------------------------------------------

    if not firstRetestOccurred

        preRetestMFE :=
             math.max(
                 preRetestMFE,
                 favorableMove)

        preRetestMAE :=
             math.max(
                 preRetestMAE,
                 adverseMove)


    //---------------------------------------------------------------------
    // SECONDARY FAVORABLE TARGETS
    //---------------------------------------------------------------------

    if not hit025 and
       favorableMove >=
       secondary025

        hit025 :=
             true


    if not hit075 and
       favorableMove >=
       secondary075

        hit075 :=
             true


    if not hit100 and
       favorableMove >=
       secondary100

        hit100 :=
             true


    //---------------------------------------------------------------------
    // RETEST ZONE OVERLAP
    //
    // Candle range overlaps the frozen zone.
    //---------------------------------------------------------------------

    bool overlapsRetestZone =
         high >= retestLower and
         low <= retestUpper


    //---------------------------------------------------------------------
    // FIRST-EVENT CLASSIFICATION BEFORE RETEST
    //---------------------------------------------------------------------

    if activePath == PATH_NONE and
       not firstRetestOccurred

        bool favorableHitNow =
             favorableMove >=
             primaryPct

        bool adverseHitNow =
             adverseMove >=
             primaryPct


        // If target and retest occur on same 1M candle, sequencing
        // is unknowable. Retest takes precedence for path classification.
        // Baseline ±0.50 logic remains independent below.

        if overlapsRetestZone

            firstRetestOccurred :=
                 true

            firstRetestTime :=
                 time

            totalRetests +=
                 1

            retestCount +=
                 1

            totalMinutesToRetest +=
                 (
                     time -
                     entryTime
                 ) /
                 60000.0

            totalPreRetestMFE +=
                 preRetestMFE

            totalPreRetestMAE +=
                 preRetestMAE


            if showRetestLabels

                label.new(
                     time,
                     brokenOrbLevel,
                     "RETEST\n+" +
                     str.tostring(
                         int(
                             (
                                 time -
                                 entryTime
                             ) /
                             60000
                         )
                     ) +
                     "m",
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style =
                         activeDir == 1
                         ? label.style_label_down
                         : label.style_label_up,
                     color =
                         color.new(
                             color.orange,
                             0),
                     textcolor =
                         color.white,
                     size =
                         size.tiny)


        else if favorableHitNow

            activePath :=
                 PATH_NR_CONTINUE


        else if adverseHitNow

            activePath :=
                 PATH_NR_FAIL


    //---------------------------------------------------------------------
    // RETEST COUNT
    //
    // Count a new zone entry after previously being outside.
    //---------------------------------------------------------------------

    if firstRetestOccurred

        if overlapsRetestZone and
           not inRetestZonePrev and
           time != firstRetestTime

            retestCount +=
                 1


    inRetestZonePrev :=
         overlapsRetestZone


    //---------------------------------------------------------------------
    // FIRST-RETEST PENETRATION
    //
    // ONLY this measurement freezes after the first decisive retest
    // outcome. Failure / confirmation / continuation / reclaim logic
    // remains active on subsequent bars.
    //---------------------------------------------------------------------

    if firstRetestOccurred and
       not retestPenetrationFrozen and
       frozenAtr > 0.0

        float wickPen =
             activeDir == 1
             ? math.max(
                 brokenOrbLevel -
                 low,
                 0.0)
             : math.max(
                 high -
                 brokenOrbLevel,
                 0.0)

        float closePen =
             activeDir == 1
             ? math.max(
                 brokenOrbLevel -
                 close,
                 0.0)
             : math.max(
                 close -
                 brokenOrbLevel,
                 0.0)


        float wickPenPctAtr =
             wickPen /
             frozenAtr *
             100.0

        float closePenPctAtr =
             closePen /
             frozenAtr *
             100.0


        maxWickPenAtrPct :=
             math.max(
                 maxWickPenAtrPct,
                 wickPenPctAtr)

        maxClosePenAtrPct :=
             math.max(
                 maxClosePenAtrPct,
                 closePenPctAtr)



    //=====================================================================
    // BUILD 5.3 — ALL-BREAKOUT 10M QUALITY SNAPSHOT
    //
    // This runs independently of the NR checkpoint study. A breakout may
    // therefore be represented here even if it already retested the ORB.
    // MFE/MAE are the original-breakout excursions observed THROUGH the
    // checkpoint bar. The quality ratio uses a 0.01% MAE floor only to
    // prevent division-by-zero; the raw MFE and MAE remain separately shown.
    //=====================================================================

    if enableCheckpointResearch

        if not quality10Captured and minutesSinceBreakout >= 10
            quality10Captured := true
            quality10SepAtrPct := currentOrbSepAtrPct
            quality10SepGroup := f_qualitySepGroup(currentOrbSepAtrPct)
            quality10MFE := mfePct
            quality10MAE := maePct
            quality10Ratio := quality10MFE / math.max(quality10MAE, 0.01)

            quality10RetestState :=
                 not firstRetestOccurred ? 0 :
                 retestConfirmed ? 1 :
                 provisionalFailure ? 2 :
                 3


            if quality10SepGroup == 1 or quality10SepGroup == 2
                auditEligible := true
                auditSepGroup := quality10SepGroup
                auditDir := activeDir
                auditSep10 := quality10SepAtrPct
                auditMfe10 := quality10MFE
                auditMae10 := quality10MAE
                auditQ10 := quality10Ratio
                auditRetestState10 := quality10RetestState

        if quality10Captured and
           not quality15Captured and
           minutesSinceBreakout >= 15

            quality15Captured := true
            quality15SepAtrPct := currentOrbSepAtrPct

            if not na(quality10SepAtrPct) and quality10SepAtrPct > 0.0
                qualityTrajectoryRatio := quality15SepAtrPct / quality10SepAtrPct
                if auditEligible
                    auditTrajectoryRatio := qualityTrajectoryRatio
                    auditTrajectoryClass := f_auditTrajectoryClass(auditTrajectoryRatio)


    //=====================================================================
    // NO-RETEST CHECKPOINT CAPTURE
    //
    // NR N is descriptive: no first retest has occurred by the checkpoint.
    //
    // FWD N is stricter: the original breakout ±0.50% outcome must still
    // be unresolved at the checkpoint CLOSE. We therefore also inspect the
    // current checkpoint candle's high/low before declaring eligibility.
    // The fresh checkpoint outcome begins on the NEXT 1-minute bar.
    //=====================================================================

    if enableCheckpointResearch and
       not firstRetestOccurred

        bool originalStillUnresolvedNow =
             primaryOutcome == 0 and
             favorableMove < primaryPct and
             adverseMove < primaryPct

        if not cp5Captured and
           minutesSinceBreakout >= 5

            cp5Captured := true
            cp5NoRetestN += 1
            cp5SepAtrTotal += currentOrbSepAtrPct

            cp5Entry := close
            cp5Time := time

            cp5ForwardEligible := originalStillUnresolvedNow

            if cp5ForwardEligible
                cp5ForwardN += 1

            if showCheckpointLabels
                label.new(
                     time,
                     close,
                     cp5ForwardEligible ? "NR 5m FWD" : "NR 5m",
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style =
                         activeDir == 1
                         ? label.style_label_up
                         : label.style_label_down,
                     color = color.new(color.gray, 20),
                     textcolor = color.white,
                     size = size.tiny)


        if not cp10Captured and
           minutesSinceBreakout >= 10

            cp10Captured := true
            cp10NoRetestN += 1
            cp10SepAtrTotal += currentOrbSepAtrPct

            cp10Entry := close
            cp10Time := time
            cp10SepAtrPct := currentOrbSepAtrPct
            cp10SepBucket := f_sepBucket(currentOrbSepAtrPct)

            cp10ForwardEligible := originalStillUnresolvedNow

            if cp10ForwardEligible
                cp10ForwardN += 1

            if showCheckpointLabels
                label.new(
                     time,
                     close,
                     cp10ForwardEligible ? "NR 10m FWD" : "NR 10m",
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style =
                         activeDir == 1
                         ? label.style_label_up
                         : label.style_label_down,
                     color = color.new(color.gray, 20),
                     textcolor = color.white,
                     size = size.tiny)


        if not cp15Captured and
           minutesSinceBreakout >= 15

            cp15Captured := true
            cp15NoRetestN += 1
            cp15SepAtrTotal += currentOrbSepAtrPct

            cp15Entry := close
            cp15Time := time
            cp15SepAtrPct := currentOrbSepAtrPct
            cp15SepBucket := f_sepBucket(currentOrbSepAtrPct)

            if cp10Captured and not na(cp10SepAtrPct) and cp10SepAtrPct > 0.0
                cpTrajectoryRatio := cp15SepAtrPct / cp10SepAtrPct
                cpRatioBucket := f_ratioBucket(cp10SepAtrPct, cp15SepAtrPct)

            cp15ForwardEligible := originalStillUnresolvedNow

            if cp15ForwardEligible
                cp15ForwardN += 1

            if showCheckpointLabels
                label.new(
                     time,
                     close,
                     cp15ForwardEligible ? "NR 15m FWD" : "NR 15m",
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style =
                         activeDir == 1
                         ? label.style_label_up
                         : label.style_label_down,
                     color = color.new(color.gray, 20),
                     textcolor = color.white,
                     size = size.tiny)


        if not cp30Captured and
           minutesSinceBreakout >= 30

            cp30Captured := true
            cp30NoRetestN += 1
            cp30SepAtrTotal += currentOrbSepAtrPct

            cp30Entry := close
            cp30Time := time

            cp30ForwardEligible := originalStillUnresolvedNow

            if cp30ForwardEligible
                cp30ForwardN += 1

            if showCheckpointLabels
                label.new(
                     time,
                     close,
                     cp30ForwardEligible ? "NR 30m FWD" : "NR 30m",
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style =
                         activeDir == 1
                         ? label.style_label_up
                         : label.style_label_down,
                     color = color.new(color.gray, 20),
                     textcolor = color.white,
                     size = size.tiny)


    //=====================================================================
    // BUILD 4.3 — FORWARD EXCURSION UNTIL FIRST RETEST / RTH CLOSE
    //
    // Only bars strictly after the checkpoint are eligible. The first later
    // retest candle is excluded, so the window contains only fully observable
    // no-retest bars.
    //=====================================================================

    if not firstRetestOccurred

        if cp5Captured and not na(cp5Time) and time > cp5Time
            float cp5WindowFav = activeDir == 1 ? (high - cp5Entry) / cp5Entry * 100.0 : (cp5Entry - low) / cp5Entry * 100.0
            float cp5WindowAdv = activeDir == 1 ? (cp5Entry - low) / cp5Entry * 100.0 : (high - cp5Entry) / cp5Entry * 100.0
            cp5WindowMFE := math.max(cp5WindowMFE, cp5WindowFav)
            cp5WindowMAE := math.max(cp5WindowMAE, cp5WindowAdv)

        if cp10Captured and not na(cp10Time) and time > cp10Time
            float cp10WindowFav = activeDir == 1 ? (high - cp10Entry) / cp10Entry * 100.0 : (cp10Entry - low) / cp10Entry * 100.0
            float cp10WindowAdv = activeDir == 1 ? (cp10Entry - low) / cp10Entry * 100.0 : (high - cp10Entry) / cp10Entry * 100.0
            cp10WindowMFE := math.max(cp10WindowMFE, cp10WindowFav)
            cp10WindowMAE := math.max(cp10WindowMAE, cp10WindowAdv)

        if cp15Captured and not na(cp15Time) and time > cp15Time
            float cp15WindowFav = activeDir == 1 ? (high - cp15Entry) / cp15Entry * 100.0 : (cp15Entry - low) / cp15Entry * 100.0
            float cp15WindowAdv = activeDir == 1 ? (cp15Entry - low) / cp15Entry * 100.0 : (high - cp15Entry) / cp15Entry * 100.0
            cp15WindowMFE := math.max(cp15WindowMFE, cp15WindowFav)
            cp15WindowMAE := math.max(cp15WindowMAE, cp15WindowAdv)

        if cp30Captured and not na(cp30Time) and time > cp30Time
            float cp30WindowFav = activeDir == 1 ? (high - cp30Entry) / cp30Entry * 100.0 : (cp30Entry - low) / cp30Entry * 100.0
            float cp30WindowAdv = activeDir == 1 ? (cp30Entry - low) / cp30Entry * 100.0 : (high - cp30Entry) / cp30Entry * 100.0
            cp30WindowMFE := math.max(cp30WindowMFE, cp30WindowFav)
            cp30WindowMAE := math.max(cp30WindowMAE, cp30WindowAdv)


    //=====================================================================
    // BUILD 4.2 — POST-CHECKPOINT RUNNER TRACKING
    //
    // For every descriptive no-retest checkpoint cohort:
    // 1) track post-checkpoint MFE from the checkpoint close;
    // 2) flag the first later retest and its elapsed minutes.
    //
    // Tracking starts on the NEXT bar so the checkpoint candle itself is not
    // reused as post-checkpoint information.
    //=====================================================================

    if cp5Captured and not na(cp5Time) and time > cp5Time

        float cp5RunnerFav =
             activeDir == 1
             ? (high - cp5Entry) / cp5Entry * 100.0
             : (cp5Entry - low) / cp5Entry * 100.0

        cp5PostMFE := math.max(cp5PostMFE, cp5RunnerFav)

        if not cp5EventualRetest and overlapsRetestZone
            cp5EventualRetest := true
            cp5EventualRetestTime := time


    if cp10Captured and not na(cp10Time) and time > cp10Time

        float cp10RunnerFav =
             activeDir == 1
             ? (high - cp10Entry) / cp10Entry * 100.0
             : (cp10Entry - low) / cp10Entry * 100.0

        cp10PostMFE := math.max(cp10PostMFE, cp10RunnerFav)

        if not cp10EventualRetest and overlapsRetestZone
            cp10EventualRetest := true
            cp10EventualRetestTime := time


    if cp15Captured and not na(cp15Time) and time > cp15Time

        float cp15RunnerFav =
             activeDir == 1
             ? (high - cp15Entry) / cp15Entry * 100.0
             : (cp15Entry - low) / cp15Entry * 100.0

        cp15PostMFE := math.max(cp15PostMFE, cp15RunnerFav)

        if not cp15EventualRetest and overlapsRetestZone
            cp15EventualRetest := true
            cp15EventualRetestTime := time


    if cp30Captured and not na(cp30Time) and time > cp30Time

        float cp30RunnerFav =
             activeDir == 1
             ? (high - cp30Entry) / cp30Entry * 100.0
             : (cp30Entry - low) / cp30Entry * 100.0

        cp30PostMFE := math.max(cp30PostMFE, cp30RunnerFav)

        if not cp30EventualRetest and overlapsRetestZone
            cp30EventualRetest := true
            cp30EventualRetestTime := time


    //=====================================================================
    // CHECKPOINT FORWARD OUTCOMES
    //
    // These tests continue even if a retest happens later. Once a checkpoint
    // was valid and forward-eligible, the research question is simply:
    // from the checkpoint close, does +0.50% occur before -0.50%?
    //=====================================================================

    if cp5ForwardEligible and
       cp5Outcome == 0 and
       not na(cp5Time) and
       time > cp5Time

        float cp5FavMove =
             activeDir == 1
             ? (high - cp5Entry) / cp5Entry * 100.0
             : (cp5Entry - low) / cp5Entry * 100.0

        float cp5AdvMove =
             activeDir == 1
             ? (cp5Entry - low) / cp5Entry * 100.0
             : (high - cp5Entry) / cp5Entry * 100.0

        bool cp5FavHit = cp5FavMove >= primaryPct
        bool cp5AdvHit = cp5AdvMove >= primaryPct

        if cp5FavHit and cp5AdvHit
            cp5Outcome := 3
        else if cp5FavHit
            cp5Outcome := 1
        else if cp5AdvHit
            cp5Outcome := 2


    if cp10ForwardEligible and
       cp10Outcome == 0 and
       not na(cp10Time) and
       time > cp10Time

        float cp10FavMove =
             activeDir == 1
             ? (high - cp10Entry) / cp10Entry * 100.0
             : (cp10Entry - low) / cp10Entry * 100.0

        float cp10AdvMove =
             activeDir == 1
             ? (cp10Entry - low) / cp10Entry * 100.0
             : (high - cp10Entry) / cp10Entry * 100.0

        bool cp10FavHit = cp10FavMove >= primaryPct
        bool cp10AdvHit = cp10AdvMove >= primaryPct

        if cp10FavHit and cp10AdvHit
            cp10Outcome := 3
        else if cp10FavHit
            cp10Outcome := 1
        else if cp10AdvHit
            cp10Outcome := 2


    if cp15ForwardEligible and
       cp15Outcome == 0 and
       not na(cp15Time) and
       time > cp15Time

        float cp15FavMove =
             activeDir == 1
             ? (high - cp15Entry) / cp15Entry * 100.0
             : (cp15Entry - low) / cp15Entry * 100.0

        float cp15AdvMove =
             activeDir == 1
             ? (cp15Entry - low) / cp15Entry * 100.0
             : (high - cp15Entry) / cp15Entry * 100.0

        bool cp15FavHit = cp15FavMove >= primaryPct
        bool cp15AdvHit = cp15AdvMove >= primaryPct

        if cp15FavHit and cp15AdvHit
            cp15Outcome := 3
        else if cp15FavHit
            cp15Outcome := 1
        else if cp15AdvHit
            cp15Outcome := 2


    if cp30ForwardEligible and
       cp30Outcome == 0 and
       not na(cp30Time) and
       time > cp30Time

        float cp30FavMove =
             activeDir == 1
             ? (high - cp30Entry) / cp30Entry * 100.0
             : (cp30Entry - low) / cp30Entry * 100.0

        float cp30AdvMove =
             activeDir == 1
             ? (cp30Entry - low) / cp30Entry * 100.0
             : (high - cp30Entry) / cp30Entry * 100.0

        bool cp30FavHit = cp30FavMove >= primaryPct
        bool cp30AdvHit = cp30AdvMove >= primaryPct

        if cp30FavHit and cp30AdvHit
            cp30Outcome := 3
        else if cp30FavHit
            cp30Outcome := 1
        else if cp30AdvHit
            cp30Outcome := 2


    //---------------------------------------------------------------------
    // PROVISIONAL RETEST FAILURE
    //---------------------------------------------------------------------

    bool failureClose =
         firstRetestOccurred and
         not provisionalFailure and
         not retestConfirmed and
         (
             activeDir == 1
             ? close <=
               brokenOrbLevel -
               failureTolerance
             : close >=
               brokenOrbLevel +
               failureTolerance
         )


    if failureClose

        provisionalFailure :=
             true

        // Freeze first-retest penetration after this failure bar.
        retestPenetrationFrozen :=
             true

        failureTime :=
             time

        provisionalFailureN +=
             1

        if activePath == PATH_NONE

            activePath :=
                 PATH_RETEST_FAIL


        if showRetestLabels

            label.new(
                 time,
                 close,
                 "RETEST FAIL\n" +
                 str.tostring(
                     failureAtrPct,
                     "#") +
                 "% ATR+",
                 xloc = xloc.bar_time,
                 yloc = yloc.price,
                 style =
                     activeDir == 1
                     ? label.style_label_down
                     : label.style_label_up,
                 color =
                     color.new(
                         color.red,
                         0),
                 textcolor =
                     color.white,
                 size =
                     size.tiny)


    //---------------------------------------------------------------------
    // SUCCESSFUL RETEST CONFIRMATION
    //
    // Must occur AFTER first retest.
    //---------------------------------------------------------------------

    bool directionConfirm =
         activeDir == 1
         ? close > open
         : close < open

    bool outsideRetestZone =
         activeDir == 1
         ? close > retestUpper
         : close < retestLower

    bool validConfirmation =
         firstRetestOccurred and
         not provisionalFailure and
         not retestConfirmed and
         time > firstRetestTime and
         outsideRetestZone and
         (
             not requireDirectionalConfirmation or
             directionConfirm
         )


    if validConfirmation

        retestConfirmed :=
             true

        // Freeze first-retest penetration after this confirmation bar.
        retestPenetrationFrozen :=
             true

        confirmationTime :=
             time

        confirmationPrice :=
             close


        if showRetestLabels

            label.new(
                 time,
                 close,
                 "RETEST CONFIRM\n" +
                 str.tostring(
                     close,
                     format.mintick),
                 xloc = xloc.bar_time,
                 yloc = yloc.price,
                 style =
                     activeDir == 1
                     ? label.style_label_up
                     : label.style_label_down,
                 color =
                     color.new(
                         color.teal,
                         0),
                 textcolor =
                     color.white,
                 size =
                     size.tiny)


    //---------------------------------------------------------------------
    // RETEST CONTINUATION
    //
    // Confirmation must already exist and the +0.50% original breakout
    // target must be reached on a later bar.
    //---------------------------------------------------------------------

    if activePath == PATH_NONE and
       retestConfirmed and
       time > confirmationTime and
       favorableMove >= primaryPct

        activePath :=
             PATH_RETEST_CONTINUE


    //---------------------------------------------------------------------
    // FAILED RETEST -> RECLAIM
    //---------------------------------------------------------------------

    bool reclaimed =
         provisionalFailure and
         not reclaimedAfterFailure and
         (
             activeDir == 1
             ? close > retestUpper
             : close < retestLower
         )


    if reclaimed

        reclaimedAfterFailure :=
             true

        reclaimTime :=
             time

        failureReclaimN +=
             1

        totalMinutesToReclaim +=
             (
                 time -
                 failureTime
             ) /
             60000.0


        if showRetestLabels

            label.new(
                 time,
                 close,
                 "FAIL -> RECLAIM",
                 xloc = xloc.bar_time,
                 yloc = yloc.price,
                 style =
                     activeDir == 1
                     ? label.style_label_up
                     : label.style_label_down,
                 color =
                     color.new(
                         color.blue,
                         0),
                 textcolor =
                     color.white,
                 size =
                     size.tiny)


    //---------------------------------------------------------------------
    // BASELINE ±0.50% FIRST-REACHED
    //
    // IMPORTANT:
    // This executes on EVERY post-entry bar until the first baseline
    // outcome is known. It is independent of retest penetration state.
    //---------------------------------------------------------------------

    if primaryOutcome == 0

        bool baselineFav =
             favorableMove >=
             primaryPct

        bool baselineAdv =
             adverseMove >=
             primaryPct

        if baselineFav and
           baselineAdv

            primaryOutcome :=
                 3

        else if baselineFav

            primaryOutcome :=
                 1

        else if baselineAdv

            primaryOutcome :=
                 2


//=============================================================================
// END-OF-DAY FINALIZATION
//=============================================================================

if isLastRTH and
   activeSignal

    completed +=
         1


    //---------------------------------------------------------------------
    // BASELINE RESULTS
    //---------------------------------------------------------------------

    if primaryOutcome == 1

        favorableFirst +=
             1

    else if primaryOutcome == 2

        adverseFirst +=
             1

    else if primaryOutcome == 3

        bothSameBar +=
             1

    else

        unresolved +=
             1


    if hit025
        hits025 += 1

    if hit075
        hits075 += 1

    if hit100
        hits100 += 1


    totalMFE +=
         mfePct

    totalMAE +=
         maePct


    //---------------------------------------------------------------------
    // FINAL PATH RESOLUTION
    //---------------------------------------------------------------------

    if activePath == PATH_NONE

        if firstRetestOccurred and
           not retestConfirmed and
           not provisionalFailure

            activePath :=
                 PATH_RETEST_UNCONFIRMED

        else

            activePath :=
                 PATH_UNRESOLVED


    //---------------------------------------------------------------------
    // PATH COUNTERS
    //---------------------------------------------------------------------

    if activePath == PATH_NR_CONTINUE

        nrContinueN +=
             1

        nrContinueMFE +=
             mfePct

        if hit075
            nrContinueHit075 += 1

        if hit100
            nrContinueHit100 += 1


    else if activePath == PATH_RETEST_CONTINUE

        retestContinueN +=
             1

        retestContinueMFE +=
             mfePct


    else if activePath == PATH_RETEST_FAIL

        retestFailN +=
             1

        retestFailMFE +=
             mfePct


    else if activePath == PATH_NR_FAIL

        nrFailN +=
             1

        nrFailMFE +=
             mfePct


    else if activePath == PATH_RETEST_UNCONFIRMED

        retestUnconfirmedN +=
             1


    else

        pathUnresolvedN +=
             1


    //---------------------------------------------------------------------
    // RETEST PENETRATION AGGREGATES
    //---------------------------------------------------------------------

    if firstRetestOccurred

        totalWickPenPctAtr +=
             maxWickPenAtrPct

        totalClosePenPctAtr +=
             maxClosePenAtrPct




    //---------------------------------------------------------------------
    // BUILD 5.3 — EST / EXT FAILURE AUDIT FINALIZATION
    //---------------------------------------------------------------------

    if auditEligible and (auditSepGroup == 1 or auditSepGroup == 2)
        int auditCol = -1

        if auditSepGroup == 1
            if primaryOutcome == 1
                auditCol := 0
            else if primaryOutcome == 2
                auditCol := 1
            else if primaryOutcome == 3
                auditEstBoth += 1
            else
                auditEstUnresolved += 1
        else
            if primaryOutcome == 1
                auditCol := 2
            else if primaryOutcome == 2
                auditCol := 3
            else if primaryOutcome == 3
                auditExtBoth += 1
            else
                auditExtUnresolved += 1

        if auditCol >= 0
            array.set(auditN, auditCol, array.get(auditN, auditCol) + 1)
            array.set(auditSep10Total, auditCol, array.get(auditSep10Total, auditCol) + nz(auditSep10))
            array.set(auditMfe10Total, auditCol, array.get(auditMfe10Total, auditCol) + nz(auditMfe10))
            array.set(auditMae10Total, auditCol, array.get(auditMae10Total, auditCol) + nz(auditMae10))
            array.set(auditQ10Total, auditCol, array.get(auditQ10Total, auditCol) + nz(auditQ10))

            if auditRetestState10 == 0
                array.set(auditNR, auditCol, array.get(auditNR, auditCol) + 1)
            else if auditRetestState10 == 1
                array.set(auditRH, auditCol, array.get(auditRH, auditCol) + 1)
            else if auditRetestState10 == 2
                array.set(auditRF, auditCol, array.get(auditRF, auditCol) + 1)
            else if auditRetestState10 == 3
                array.set(auditRTOpen, auditCol, array.get(auditRTOpen, auditCol) + 1)

            if auditTrajectoryClass == 0
                array.set(auditContract, auditCol, array.get(auditContract, auditCol) + 1)
            else if auditTrajectoryClass == 1
                array.set(auditStable, auditCol, array.get(auditStable, auditCol) + 1)
            else if auditTrajectoryClass == 2
                array.set(auditExpand, auditCol, array.get(auditExpand, auditCol) + 1)
            else
                array.set(auditNo15, auditCol, array.get(auditNo15, auditCol) + 1)

            if auditDir == 1
                array.set(auditBull, auditCol, array.get(auditBull, auditCol) + 1)
            else if auditDir == -1
                array.set(auditBear, auditCol, array.get(auditBear, auditCol) + 1)


            //-----------------------------------------------------------------
            // BUILD 5.3.2 — EST CONTRACT DIAGNOSTIC FINALIZATION
            //-----------------------------------------------------------------
            if auditSepGroup == 1 and auditTrajectoryClass == 0 and (auditCol == 0 or auditCol == 1)
                int dc = auditCol

                array.set(contractDiagN, dc, array.get(contractDiagN, dc) + 1)
                array.set(contractDiagSepTotal, dc, array.get(contractDiagSepTotal, dc) + nz(auditSep10))
                array.set(contractDiagMfeTotal, dc, array.get(contractDiagMfeTotal, dc) + nz(auditMfe10))
                array.set(contractDiagMaeTotal, dc, array.get(contractDiagMaeTotal, dc) + nz(auditMae10))
                array.set(contractDiagQTotal, dc, array.get(contractDiagQTotal, dc) + nz(auditQ10))

                if auditDir == 1
                    array.set(contractDiagBull, dc, array.get(contractDiagBull, dc) + 1)
                else if auditDir == -1
                    array.set(contractDiagBear, dc, array.get(contractDiagBear, dc) + 1)

                int stateIdx = f_contractIdx(auditRetestState10, dc)
                int sepIdx = f_contractIdx(f_contractSepBucket(auditSep10), dc)
                int mfeIdx = f_contractIdx(f_contractMfeBucket(auditMfe10), dc)
                int maeIdx = f_contractIdx(f_contractMaeBucket(auditMae10), dc)
                int qIdx = f_contractIdx(f_contractQBucket(auditQ10), dc)
                int sevIdx = f_contractIdx(f_contractSeverityBucket(auditTrajectoryRatio), dc)

                if stateIdx >= 0
                    array.set(contractState, stateIdx, array.get(contractState, stateIdx) + 1)
                if sepIdx >= 0
                    array.set(contractSep, sepIdx, array.get(contractSep, sepIdx) + 1)
                if mfeIdx >= 0
                    array.set(contractMfe, mfeIdx, array.get(contractMfe, mfeIdx) + 1)
                if maeIdx >= 0
                    array.set(contractMae, maeIdx, array.get(contractMae, maeIdx) + 1)
                if qIdx >= 0
                    array.set(contractQ, qIdx, array.get(contractQ, qIdx) + 1)
                if sevIdx >= 0
                    array.set(contractSeverity, sevIdx, array.get(contractSeverity, sevIdx) + 1)

    //---------------------------------------------------------------------
    // BUILD 5.3 — EXT DEPTH FINALIZATION
    //---------------------------------------------------------------------

    if quality10Captured and quality10SepGroup == 2
        int edb = f_extDepthBucket(quality10SepAtrPct)
        if edb >= 0
            array.set(extDepthN, edb, array.get(extDepthN, edb) + 1)
            array.set(extDepthMfeTotal, edb, array.get(extDepthMfeTotal, edb) + mfePct)
            array.set(extDepthMaeTotal, edb, array.get(extDepthMaeTotal, edb) + maePct)

            if primaryOutcome == 1
                array.set(extDepthFav050, edb, array.get(extDepthFav050, edb) + 1)
            if hit075
                array.set(extDepthHit075, edb, array.get(extDepthHit075, edb) + 1)
            if hit100
                array.set(extDepthHit100, edb, array.get(extDepthHit100, edb) + 1)


    //---------------------------------------------------------------------
    // BUILD 5.3 — 10M QUALITY STUDY FINALIZATION
    //
    // Outcome columns use the ORIGINAL breakout outcome/extension measures,
    // so the table answers whether the state observed at 10m was associated
    // with the eventual session result.
    //---------------------------------------------------------------------

    if quality10Captured and quality10SepGroup >= 0
        int qg = quality10SepGroup

        array.set(qualityN, qg, array.get(qualityN, qg) + 1)
        array.set(qualityMfe10Total, qg, array.get(qualityMfe10Total, qg) + nz(quality10MFE))
        array.set(qualityMae10Total, qg, array.get(qualityMae10Total, qg) + nz(quality10MAE))
        array.set(qualityRatio10Total, qg, array.get(qualityRatio10Total, qg) + nz(quality10Ratio))

        if not na(qualityTrajectoryRatio)
            array.set(qualityTrajectoryN, qg, array.get(qualityTrajectoryN, qg) + 1)
            array.set(qualityTrajectoryTotal, qg, array.get(qualityTrajectoryTotal, qg) + qualityTrajectoryRatio)

        if quality10RetestState == 0
            array.set(qualityNR, qg, array.get(qualityNR, qg) + 1)
        else if quality10RetestState == 1
            array.set(qualityRH, qg, array.get(qualityRH, qg) + 1)
        else if quality10RetestState == 2
            array.set(qualityRF, qg, array.get(qualityRF, qg) + 1)
        else if quality10RetestState == 3
            array.set(qualityRTOpen, qg, array.get(qualityRTOpen, qg) + 1)

        if primaryOutcome == 1
            array.set(qualityFav050, qg, array.get(qualityFav050, qg) + 1)
        else if primaryOutcome == 2
            array.set(qualityAdv050, qg, array.get(qualityAdv050, qg) + 1)
        else if primaryOutcome == 3
            array.set(qualityBoth050, qg, array.get(qualityBoth050, qg) + 1)
        else
            array.set(qualityUnresolved050, qg, array.get(qualityUnresolved050, qg) + 1)

        if hit075
            array.set(qualityHit075, qg, array.get(qualityHit075, qg) + 1)
        if hit100
            array.set(qualityHit100, qg, array.get(qualityHit100, qg) + 1)


    //---------------------------------------------------------------------
    // CHECKPOINT RESULT FINALIZATION
    //
    // Only forward-eligible checkpoints contribute to forward outcomes.
    // NR N was already counted at checkpoint capture.
    //---------------------------------------------------------------------

    if cp5ForwardEligible
        if cp5Outcome == 1
            cp5Fav += 1
        else if cp5Outcome == 2
            cp5Adv += 1
        else if cp5Outcome == 3
            cp5Both += 1
        else
            cp5Unresolved += 1

    if cp10ForwardEligible
        if cp10Outcome == 1
            cp10Fav += 1
        else if cp10Outcome == 2
            cp10Adv += 1
        else if cp10Outcome == 3
            cp10Both += 1
        else
            cp10Unresolved += 1

    if cp15ForwardEligible
        if cp15Outcome == 1
            cp15Fav += 1
        else if cp15Outcome == 2
            cp15Adv += 1
        else if cp15Outcome == 3
            cp15Both += 1
        else
            cp15Unresolved += 1

    if cp30ForwardEligible
        if cp30Outcome == 1
            cp30Fav += 1
        else if cp30Outcome == 2
            cp30Adv += 1
        else if cp30Outcome == 3
            cp30Both += 1
        else
            cp30Unresolved += 1


    //---------------------------------------------------------------------
    // BUILD 4.3 — FORWARD EXCURSION FINALIZATION
    //---------------------------------------------------------------------

    if cp5Captured
        cp5WindowMfeTotal += cp5WindowMFE
        cp5WindowMaeTotal += cp5WindowMAE
        array.push(cp5WindowMfeValues, cp5WindowMFE)
        array.push(cp5WindowMaeValues, cp5WindowMAE)
        if cp5WindowMFE >= 0.25
            cp5WindowHit025 += 1
        if cp5WindowMFE >= 0.50
            cp5WindowHit050 += 1
        if cp5WindowMFE >= 0.75
            cp5WindowHit075 += 1
        if cp5WindowMFE >= 1.00
            cp5WindowHit100 += 1

    if cp10Captured
        cp10WindowMfeTotal += cp10WindowMFE
        cp10WindowMaeTotal += cp10WindowMAE
        array.push(cp10WindowMfeValues, cp10WindowMFE)
        array.push(cp10WindowMaeValues, cp10WindowMAE)
        if cp10WindowMFE >= 0.25
            cp10WindowHit025 += 1
        if cp10WindowMFE >= 0.50
            cp10WindowHit050 += 1
        if cp10WindowMFE >= 0.75
            cp10WindowHit075 += 1
        if cp10WindowMFE >= 1.00
            cp10WindowHit100 += 1

    if cp15Captured
        cp15WindowMfeTotal += cp15WindowMFE
        cp15WindowMaeTotal += cp15WindowMAE
        array.push(cp15WindowMfeValues, cp15WindowMFE)
        array.push(cp15WindowMaeValues, cp15WindowMAE)
        if cp15WindowMFE >= 0.25
            cp15WindowHit025 += 1
        if cp15WindowMFE >= 0.50
            cp15WindowHit050 += 1
        if cp15WindowMFE >= 0.75
            cp15WindowHit075 += 1
        if cp15WindowMFE >= 1.00
            cp15WindowHit100 += 1

    if cp30Captured
        cp30WindowMfeTotal += cp30WindowMFE
        cp30WindowMaeTotal += cp30WindowMAE
        array.push(cp30WindowMfeValues, cp30WindowMFE)
        array.push(cp30WindowMaeValues, cp30WindowMAE)
        if cp30WindowMFE >= 0.25
            cp30WindowHit025 += 1
        if cp30WindowMFE >= 0.50
            cp30WindowHit050 += 1
        if cp30WindowMFE >= 0.75
            cp30WindowHit075 += 1
        if cp30WindowMFE >= 1.00
            cp30WindowHit100 += 1


    //---------------------------------------------------------------------
    // BUILD 4.4 — 10M / 15M SEPARATION BUCKET FINALIZATION
    //---------------------------------------------------------------------

    if cp10Captured and cp10SepBucket >= 0
        int b10 = cp10SepBucket
        array.set(sep10N, b10, array.get(sep10N, b10) + 1)
        array.set(sep10MfeTotal, b10, array.get(sep10MfeTotal, b10) + cp10WindowMFE)
        array.set(sep10MaeTotal, b10, array.get(sep10MaeTotal, b10) + cp10WindowMAE)

        if cp10WindowMFE >= 0.50
            array.set(sep10Hit050, b10, array.get(sep10Hit050, b10) + 1)
        if cp10WindowMFE >= 0.75
            array.set(sep10Hit075, b10, array.get(sep10Hit075, b10) + 1)
        if cp10WindowMFE >= 1.00
            array.set(sep10Hit100, b10, array.get(sep10Hit100, b10) + 1)
        if cp10EventualRetest
            array.set(sep10RetestN, b10, array.get(sep10RetestN, b10) + 1)

        if b10 == 0
            array.push(sep10MfeB0, cp10WindowMFE)
            array.push(sep10MaeB0, cp10WindowMAE)
        else if b10 == 1
            array.push(sep10MfeB1, cp10WindowMFE)
            array.push(sep10MaeB1, cp10WindowMAE)
        else if b10 == 2
            array.push(sep10MfeB2, cp10WindowMFE)
            array.push(sep10MaeB2, cp10WindowMAE)
        else if b10 == 3
            array.push(sep10MfeB3, cp10WindowMFE)
            array.push(sep10MaeB3, cp10WindowMAE)


    if cp15Captured and cp15SepBucket >= 0
        int b15 = cp15SepBucket
        array.set(sep15N, b15, array.get(sep15N, b15) + 1)
        array.set(sep15MfeTotal, b15, array.get(sep15MfeTotal, b15) + cp15WindowMFE)
        array.set(sep15MaeTotal, b15, array.get(sep15MaeTotal, b15) + cp15WindowMAE)

        if cp15WindowMFE >= 0.50
            array.set(sep15Hit050, b15, array.get(sep15Hit050, b15) + 1)
        if cp15WindowMFE >= 0.75
            array.set(sep15Hit075, b15, array.get(sep15Hit075, b15) + 1)
        if cp15WindowMFE >= 1.00
            array.set(sep15Hit100, b15, array.get(sep15Hit100, b15) + 1)
        if cp15EventualRetest
            array.set(sep15RetestN, b15, array.get(sep15RetestN, b15) + 1)

        if b15 == 0
            array.push(sep15MfeB0, cp15WindowMFE)
            array.push(sep15MaeB0, cp15WindowMAE)
        else if b15 == 1
            array.push(sep15MfeB1, cp15WindowMFE)
            array.push(sep15MaeB1, cp15WindowMAE)
        else if b15 == 2
            array.push(sep15MfeB2, cp15WindowMFE)
            array.push(sep15MaeB2, cp15WindowMAE)
        else if b15 == 3
            array.push(sep15MfeB3, cp15WindowMFE)
            array.push(sep15MaeB3, cp15WindowMAE)


    //---------------------------------------------------------------------
    // BUILD 4.6 — TRAJECTORY RATIO FINALIZATION
    //
    // Only events that reached BOTH 10m and 15m no-retest checkpoints
    // receive a ratio bucket. Performance is measured from the Build 4.3
    // 15m forward excursion window.
    //---------------------------------------------------------------------

    if cp15Captured and cp10Captured and cpRatioBucket >= 0 and not na(cpTrajectoryRatio)
        int rb = cpRatioBucket

        array.set(ratioN, rb, array.get(ratioN, rb) + 1)
        array.set(ratioSep10Total, rb, array.get(ratioSep10Total, rb) + cp10SepAtrPct)
        array.set(ratioSep15Total, rb, array.get(ratioSep15Total, rb) + cp15SepAtrPct)
        array.set(ratioValueTotal, rb, array.get(ratioValueTotal, rb) + cpTrajectoryRatio)
        array.set(ratioMfeTotal, rb, array.get(ratioMfeTotal, rb) + cp15WindowMFE)
        array.set(ratioMaeTotal, rb, array.get(ratioMaeTotal, rb) + cp15WindowMAE)

        if cp15WindowMFE >= 0.50
            array.set(ratioHit050, rb, array.get(ratioHit050, rb) + 1)
        if cp15WindowMFE >= 0.75
            array.set(ratioHit075, rb, array.get(ratioHit075, rb) + 1)
        if cp15WindowMFE >= 1.00
            array.set(ratioHit100, rb, array.get(ratioHit100, rb) + 1)
        if cp15EventualRetest
            array.set(ratioRetestN, rb, array.get(ratioRetestN, rb) + 1)

        if rb == 0
            array.push(ratioMfeB0, cp15WindowMFE)
            array.push(ratioMaeB0, cp15WindowMAE)
        else if rb == 1
            array.push(ratioMfeB1, cp15WindowMFE)
            array.push(ratioMaeB1, cp15WindowMAE)
        else if rb == 2
            array.push(ratioMfeB2, cp15WindowMFE)
            array.push(ratioMaeB2, cp15WindowMAE)
        else if rb == 3
            array.push(ratioMfeB3, cp15WindowMFE)
            array.push(ratioMaeB3, cp15WindowMAE)
        else if rb == 4
            array.push(ratioMfeB4, cp15WindowMFE)
            array.push(ratioMaeB4, cp15WindowMAE)

            // BUILD 5.3 — split Strong Expansion by initial 10m separation.
            int seGroup = cp10SepAtrPct < 100.0 ? 0 : 1
            array.set(strongExpSepN, seGroup, array.get(strongExpSepN, seGroup) + 1)
            array.set(strongExpSepMfeTotal, seGroup, array.get(strongExpSepMfeTotal, seGroup) + cp15WindowMFE)
            array.set(strongExpSepMaeTotal, seGroup, array.get(strongExpSepMaeTotal, seGroup) + cp15WindowMAE)

            if cp15WindowMFE >= 0.50
                array.set(strongExpSepHit050, seGroup, array.get(strongExpSepHit050, seGroup) + 1)
            if cp15WindowMFE >= 0.75
                array.set(strongExpSepHit075, seGroup, array.get(strongExpSepHit075, seGroup) + 1)
            if cp15WindowMFE >= 1.00
                array.set(strongExpSepHit100, seGroup, array.get(strongExpSepHit100, seGroup) + 1)
            if cp15EventualRetest
                array.set(strongExpSepRetestN, seGroup, array.get(strongExpSepRetestN, seGroup) + 1)

            if seGroup == 0
                array.push(strongExpSepMfeB0, cp15WindowMFE)
                array.push(strongExpSepMaeB0, cp15WindowMAE)
            else
                array.push(strongExpSepMfeB1, cp15WindowMFE)
                array.push(strongExpSepMaeB1, cp15WindowMAE)


    //---------------------------------------------------------------------
    // BUILD 4.2 — NO-RETEST RUNNER FINALIZATION
    //
    // Extension targets use the ORIGINAL breakout MFE, but only for events
    // that qualified for the relevant no-retest checkpoint cohort.
    //---------------------------------------------------------------------

    if cp5Captured
        if mfePct >= 0.75
            cp5Ext075 += 1
        if mfePct >= 1.00
            cp5Ext100 += 1
        if mfePct >= 1.50
            cp5Ext150 += 1
        if mfePct >= 2.00
            cp5Ext200 += 1

        cp5PostMfeTotal += cp5PostMFE

        if cp5EventualRetest
            cp5EventualRetestN += 1
            cp5MinutesToRetestTotal +=
                 (cp5EventualRetestTime - cp5Time) / 60000.0


    if cp10Captured
        if mfePct >= 0.75
            cp10Ext075 += 1
        if mfePct >= 1.00
            cp10Ext100 += 1
        if mfePct >= 1.50
            cp10Ext150 += 1
        if mfePct >= 2.00
            cp10Ext200 += 1

        cp10PostMfeTotal += cp10PostMFE

        if cp10EventualRetest
            cp10EventualRetestN += 1
            cp10MinutesToRetestTotal +=
                 (cp10EventualRetestTime - cp10Time) / 60000.0


    if cp15Captured
        if mfePct >= 0.75
            cp15Ext075 += 1
        if mfePct >= 1.00
            cp15Ext100 += 1
        if mfePct >= 1.50
            cp15Ext150 += 1
        if mfePct >= 2.00
            cp15Ext200 += 1

        cp15PostMfeTotal += cp15PostMFE

        if cp15EventualRetest
            cp15EventualRetestN += 1
            cp15MinutesToRetestTotal +=
                 (cp15EventualRetestTime - cp15Time) / 60000.0


    if cp30Captured
        if mfePct >= 0.75
            cp30Ext075 += 1
        if mfePct >= 1.00
            cp30Ext100 += 1
        if mfePct >= 1.50
            cp30Ext150 += 1
        if mfePct >= 2.00
            cp30Ext200 += 1

        cp30PostMfeTotal += cp30PostMFE

        if cp30EventualRetest
            cp30EventualRetestN += 1
            cp30MinutesToRetestTotal +=
                 (cp30EventualRetestTime - cp30Time) / 60000.0


    //---------------------------------------------------------------------
    // RESET ACTIVE BREAKOUT
    //---------------------------------------------------------------------

    activeSignal :=
         false

    activeDir :=
         0

    entryPrice :=
         na

    entryTime :=
         na

    frozenAtr :=
         na

    brokenOrbLevel :=
         na

    retestTolerance :=
         na

    failureTolerance :=
         na

    retestUpper :=
         na

    retestLower :=
         na

    activePath :=
         PATH_NONE

    firstRetestOccurred :=
         false

    firstRetestTime :=
         na

    retestPenetrationFrozen :=
         false

    provisionalFailure :=
         false

    failureTime :=
         na

    retestConfirmed :=
         false

    confirmationTime :=
         na

    confirmationPrice :=
         na

    reclaimedAfterFailure :=
         false

    reclaimTime :=
         na

    retestCount :=
         0

    inRetestZonePrev :=
         false

    cp5Captured := false
    cp10Captured := false
    cp15Captured := false
    cp30Captured := false

    cp5ForwardEligible := false
    cp10ForwardEligible := false
    cp15ForwardEligible := false
    cp30ForwardEligible := false

    cp5Entry := na
    cp10Entry := na
    cp15Entry := na
    cp30Entry := na

    cp5Time := na
    cp10Time := na
    cp15Time := na
    cp30Time := na

    cp5Outcome := 0
    cp10Outcome := 0
    cp15Outcome := 0
    cp30Outcome := 0

    cp10SepBucket := -1
    cp15SepBucket := -1

    cp10SepAtrPct := na
    cp15SepAtrPct := na
    cpTrajectoryRatio := na
    cpRatioBucket := -1

    cp5PostMFE := 0.0
    cp10PostMFE := 0.0
    cp15PostMFE := 0.0
