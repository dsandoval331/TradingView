                 color.white)

        table.cell(
             warningTable,
             0,
             1,
             "Switch chart timeframe to 1 minute",
             bgcolor =
                 color.new(
                     color.red,
                     15),
             text_color =
                 color.white)

    else

        table.clear(
             warningTable,
             0,
             0,
             0,
             1)
