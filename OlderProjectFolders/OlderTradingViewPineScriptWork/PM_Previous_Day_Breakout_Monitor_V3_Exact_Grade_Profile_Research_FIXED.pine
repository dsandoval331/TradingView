            f_profileRow(
                 6,
                 PROFILE_DELAYED)

            f_profileRow(
                 7,
                 PROFILE_UNCLASSIFIED)

            int classifiedCount =
                 array.get(
                     profileSignals,
                     PROFILE_CONTROLLED) +
                 array.get(
                     profileSignals,
                     PROFILE_EXPLOSIVE) +
                 array.get(
                     profileSignals,
                     PROFILE_EFFICIENT) +
                 array.get(
                     profileSignals,
                     PROFILE_PRETTY_WEAK) +
                 array.get(
                     profileSignals,
                     PROFILE_DELAYED)

            int totalProfileCount =
                 classifiedCount +
                 array.get(
                     profileSignals,
                     PROFILE_UNCLASSIFIED)

            string coverageText = "-"

            if totalProfileCount > 0
                coverageText :=
                     str.tostring(
                         classifiedCount /
                         float(totalProfileCount) *
                         100.0,
                         "#.0") +
                     "%"

            table.cell(
                 analysisTable,
                 0,
                 8,
                 "Profile Coverage",
                 text_color = color.silver,
                 bgcolor = analyticsBody,
                 text_size = size.tiny)

            table.cell(
